#!/usr/bin/env python3
"""tmux-opener command-line entrypoint."""

from __future__ import annotations

import argparse
import errno
import fcntl
import hashlib
import json
import os
import platform
import plistlib
import shlex
import selectors
import signal
import socket
import stat
import subprocess
import sys
import time
from contextlib import contextmanager
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[1]
CLIENT = REPO_ROOT / "bin" / "tmux-opener-client"


def default_state_dir() -> Path:
    return Path.home() / ".local" / "state" / "tmux-opener"


def default_ssh_config() -> Path:
    return Path.home() / ".ssh" / "config"


def default_snippet_dir() -> Path:
    return Path.home() / ".ssh" / "tmux-opener.d"


def shell_quote(value: str | Path) -> str:
    return shlex.quote(str(value))


def host_socket_path(host: str, state_dir: Path) -> Path:
    return state_dir / f"{host}.sock"


def local_socket_path(args: argparse.Namespace, host: str) -> Path:
    state_dir = Path(args.state_dir).expanduser()
    if getattr(args, "socket", None):
        return Path(args.socket).expanduser()
    return host_socket_path(host, state_dir)


def infer_host(args: argparse.Namespace) -> str:
    host = getattr(args, "host", None)
    if host:
        return host

    state_dir = Path(args.state_dir).expanduser()
    snippet_dir = Path(args.snippet_dir).expanduser()
    candidates: set[str] = set()

    socket_arg = getattr(args, "socket", None)
    if socket_arg:
        socket_path = Path(socket_arg).expanduser()
        if socket_path.suffix == ".sock" and socket_path.stem and socket_path.stem != "opener":
            candidates.add(socket_path.stem)

    try:
        candidates.update(path.stem for path in snippet_dir.glob("*.conf") if path.stem)
    except OSError:
        pass

    try:
        candidates.update(path.stem for path in state_dir.glob("*.sock") if path.stem and path.stem != "opener")
    except OSError:
        pass

    if len(candidates) == 1:
        return next(iter(candidates))
    if candidates:
        raise SystemExit("tmux-opener: HOST is required; candidates: " + ", ".join(sorted(candidates)))
    raise SystemExit("tmux-opener: HOST is required")


def remote_socket_path(user: str | None = None) -> str:
    if user:
        return f"/tmp/tmux-opener-{user}.sock"
    return "/tmp/tmux-opener-%r.sock"


def ssh_query(host: str, config_path: Path | None = None) -> dict[str, list[str]]:
    command = ["ssh", "-G"]
    if config_path is not None and config_path != default_ssh_config():
        command.extend(["-F", str(config_path)])
    command.append(host)

    result = subprocess.run(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
        timeout=5,
    )
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or f"ssh -G {host} failed")

    values: dict[str, list[str]] = {}
    for line in result.stdout.splitlines():
        if not line or " " not in line:
            continue
        key, value = line.split(None, 1)
        values.setdefault(key.lower(), []).append(value)
    return values


def ssh_user(host: str, config_path: Path | None = None) -> str:
    values = ssh_query(host, config_path)
    return values.get("user", [os.environ.get("USER") or "user"])[0]


def has_remote_forward(host: str, config_path: Path) -> bool:
    values = ssh_query(host, config_path)
    return bool(values.get("remoteforward"))


def include_line(snippet_dir: Path) -> str:
    return f"Include {snippet_dir}/*.conf"


def ensure_ssh_include(config_path: Path, snippet_dir: Path, dry_run: bool) -> None:
    line = include_line(snippet_dir)
    config_path.parent.mkdir(parents=True, exist_ok=True)

    existing = config_path.read_text() if config_path.exists() else ""
    if line in existing.splitlines():
        return

    new_text = f"{line}\n"
    if existing:
        new_text += existing if existing.startswith("\n") else f"\n{existing}"

    if dry_run:
        print(f"would prepend to {config_path}:")
        print(f"  {line}")
        return

    if config_path.exists():
        backup = config_path.with_suffix(config_path.suffix + f".bak.{int(time.time())}")
        backup.write_text(existing)
        os.chmod(backup, 0o600)

    config_path.write_text(new_text)
    os.chmod(config_path, 0o600)


def remove_ssh_include_if_unused(
    config_path: Path,
    snippet_dir: Path,
    dry_run: bool,
    ignore_snippet: Path | None = None,
) -> None:
    line = include_line(snippet_dir)
    if not config_path.exists():
        return

    try:
        snippets = list(snippet_dir.glob("*.conf"))
    except OSError:
        snippets = [Path("__unknown__")]
    if ignore_snippet is not None:
        snippets = [path for path in snippets if path != ignore_snippet]
    if snippets:
        return

    existing = config_path.read_text()
    lines = existing.splitlines(keepends=True)
    kept_lines = [existing_line for existing_line in lines if existing_line.rstrip("\n") != line]
    if kept_lines == lines:
        return

    if dry_run:
        print(f"would remove from {config_path}:")
        print(f"  {line}")
        return

    backup = config_path.with_suffix(config_path.suffix + f".bak.{int(time.time())}")
    backup.write_text(existing)
    os.chmod(backup, 0o600)
    config_path.write_text("".join(kept_lines))
    os.chmod(config_path, 0o600)


def host_snippet(host: str, local_socket: Path) -> str:
    return "\n".join(
        [
            f"# Managed by tmux-opener for {host}.",
            f"Host {host}",
            f"  RemoteForward {remote_socket_path()} {local_socket}",
            "  StreamLocalBindUnlink yes",
            "  ExitOnForwardFailure yes",
            "",
        ]
    )


def host_snippet_path(host: str, snippet_dir: Path) -> Path:
    return snippet_dir / f"{host}.conf"


def managed_snippet_matches(host: str, local_socket: Path, snippet_dir: Path) -> bool:
    path = host_snippet_path(host, snippet_dir)
    return path.exists() and path.read_text() == host_snippet(host, local_socket)


def ensure_host_snippet(host: str, local_socket: Path, snippet_dir: Path, dry_run: bool) -> None:
    snippet_dir.mkdir(parents=True, exist_ok=True)
    path = host_snippet_path(host, snippet_dir)
    content = host_snippet(host, local_socket)

    if path.exists() and path.read_text() == content:
        return

    if dry_run:
        print(f"would write {path}:")
        print(content, end="")
        return

    path.write_text(content)
    os.chmod(path, 0o600)


def install_host(args: argparse.Namespace) -> Path:
    local_socket = local_socket_path(args, args.host)
    snippet_dir = Path(args.snippet_dir).expanduser()
    config_path = Path(args.ssh_config).expanduser()

    if (
        has_remote_forward(args.host, config_path)
        and not args.force
        and not managed_snippet_matches(args.host, local_socket, snippet_dir)
    ):
        print(
            f"tmux-opener: {args.host} already has RemoteForward configured; "
            "use --force to also install tmux-opener's managed forward",
            file=sys.stderr,
        )
        raise SystemExit(2)

    ensure_ssh_include(config_path, snippet_dir, args.dry_run)
    ensure_host_snippet(args.host, local_socket, snippet_dir, args.dry_run)
    return local_socket


def uninstall_host(args: argparse.Namespace) -> None:
    snippet_dir = Path(args.snippet_dir).expanduser()
    config_path = Path(args.ssh_config).expanduser()
    path = host_snippet_path(args.host, snippet_dir)

    if path.exists():
        if args.dry_run:
            print(f"would remove {path}")
            remove_ssh_include_if_unused(config_path, snippet_dir, args.dry_run, ignore_snippet=path)
            return
        else:
            path.unlink()
    elif not args.quiet:
        print(f"tmux-opener: no managed snippet found for {args.host} at {path}", file=sys.stderr)

    remove_ssh_include_if_unused(config_path, snippet_dir, args.dry_run)


def ping_client(socket_path: Path, timeout: float = 0.2) -> bool:
    response, _error = client_ping_response(socket_path, timeout)
    return bool(response and response.get("ok"))


MAX_PING_BYTES = 1024 * 1024


def parse_ping_response(frame: bytes, *, allow_legacy: bool = False) -> dict[str, object]:
    if len(frame) > MAX_PING_BYTES or not frame.endswith(b"\n"):
        raise ValueError("ping response must be a bounded newline-delimited frame")
    try:
        parsed = json.loads(frame)
    except (ValueError, UnicodeDecodeError, RecursionError) as exc:
        raise ValueError("invalid ping JSON") from exc
    if not isinstance(parsed, dict) or parsed.get("ok") is not True:
        raise ValueError("ping did not acknowledge success")
    if parsed.get("client") != "tmux-opener-client":
        raise ValueError("unexpected client identity")
    if not allow_legacy and (type(parsed.get("version")) is not int or parsed["version"] != 1):
        raise ValueError("unsupported client protocol; restart or upgrade the local client")
    return parsed


def client_ping_response(
    socket_path: Path, timeout: float = 0.2, *, allow_legacy: bool = True,
) -> tuple[dict[str, object] | None, str | None]:
    deadline = time.monotonic() + timeout
    frame = bytearray()
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(max(0.001, deadline - time.monotonic()))
            client.connect(str(socket_path))
            client.settimeout(max(0.001, deadline - time.monotonic()))
            client.sendall(b'{"version":1,"action":"ping"}\n')
            while b"\n" not in frame:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise ValueError("ping deadline exceeded")
                client.settimeout(remaining)
                chunk = client.recv(min(65536, MAX_PING_BYTES + 1 - len(frame)))
                if not chunk:
                    raise ValueError("ping ended before its newline")
                frame.extend(chunk)
                if len(frame) > MAX_PING_BYTES:
                    raise ValueError("ping response too large")
        return parse_ping_response(bytes(frame).split(b"\n", 1)[0] + b"\n", allow_legacy=allow_legacy), None
    except (OSError, ValueError) as exc:
        return None, str(exc)


def client_command(
    host: str,
    socket_path: Path,
    client_verbose: bool = False,
    vscode_folder_window: str = "new",
    vscode_file_window: str = "new",
    ssh_config: Path | None = None,
) -> list[str]:
    command = [
        str(CLIENT),
        "--socket",
        str(socket_path),
        "--default-ssh-host",
        host,
        "--allow-ssh-host",
        host,
        "--vscode-folder-window",
        vscode_folder_window,
        "--vscode-file-window",
        vscode_file_window,
    ]
    if client_verbose:
        command.append("--verbose")
    if ssh_config is not None and ssh_config != default_ssh_config():
        command.extend(["--ssh-config", str(ssh_config.expanduser().absolute())])
    return command


def start_client(
    host: str,
    socket_path: Path,
    client_verbose: bool = False,
    dry_run: bool = False,
    vscode_folder_window: str = "new",
    vscode_file_window: str = "new",
    ssh_config: Path | None = None,
) -> None:
    log_path = socket_path.with_suffix(".log")
    command = client_command(host, socket_path, client_verbose, vscode_folder_window, vscode_file_window, ssh_config)

    if dry_run:
        print("would start local client:")
        print("  " + " ".join(shell_quote(part) for part in command))
        print(f"would log to: {log_path}")
        return

    socket_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = open_private_file(log_path, os.O_WRONLY | os.O_APPEND)
    log = os.fdopen(fd, "ab")
    try:
        subprocess.Popen(
            command,
            stdout=log,
            stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )
    finally:
        log.close()

    deadline = time.monotonic() + 2.0
    while time.monotonic() < deadline:
        if ping_client(socket_path):
            return
        time.sleep(0.05)

    raise SystemExit(f"tmux-opener: local client did not start; see {log_path}")


def open_private_file(path: Path, flags: int = os.O_RDWR) -> int:
    fd = os.open(path, flags | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
        os.close(fd)
        raise SystemExit(f"tmux-opener: unsafe state file: {path}")
    os.fchmod(fd, 0o600)
    return fd


@contextmanager
def operation_lock(socket_path: Path, dry_run: bool = False):
    if dry_run:
        yield
        return
    socket_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = open_private_file(Path(str(socket_path) + ".operation.lock"))
    try:
        deadline = time.monotonic() + 10
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise SystemExit("tmux-opener: another lifecycle operation is still running")
                time.sleep(0.05)
        yield
    finally:
        os.close(fd)


def checked_socket(socket_path: Path) -> os.stat_result | None:
    try:
        info = socket_path.lstat()
    except FileNotFoundError:
        return None
    if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
        raise SystemExit(f"tmux-opener: refusing non-socket or foreign socket: {socket_path}")
    return info


def ensure_client(args: argparse.Namespace, socket_path: Path) -> None:
    if args.no_start_client or args.dry_run:
        return
    with operation_lock(socket_path):
        checked_socket(socket_path)
        if ping_client(socket_path):
            return
        service = installed_service(socket_path)
        if service is not None:
            start_service(service, args.dry_run)
            wait_for_client(socket_path)
            return
        # The child, not a health timeout, decides whether a socket is stale.
        start_client(
            args.host, socket_path, args.client_verbose,
            vscode_folder_window=args.vscode_folder_window,
            vscode_file_window=args.vscode_file_window,
            ssh_config=Path(args.ssh_config).expanduser(),
        )


def client_pid_from_ping_response(response: dict[str, object] | None) -> int | None:
    if not response or response.get("ok") is not True or response.get("client") != "tmux-opener-client":
        return None
    pid = response.get("pid")
    if isinstance(pid, bool) or not isinstance(pid, int) or pid <= 0 or pid == os.getpid():
        return None
    return pid


def process_exists(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    return True


def stop_client(socket_path: Path, dry_run: bool) -> None:
    original = checked_socket(socket_path)
    if dry_run:
        print(f"would stop verified local client at: {socket_path}")
        return
    fd = open_private_file(Path(str(socket_path) + ".lock"))
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            locked = False
        except BlockingIOError:
            locked = True
        if locked:
            try:
                pid = int(os.pread(fd, 64, 0))
            except ValueError:
                raise SystemExit("tmux-opener: client ownership is initializing; try again")
            if pid <= 0 or pid == os.getpid():
                raise SystemExit("tmux-opener: invalid client owner; refusing to signal")
            response, error = client_ping_response(socket_path)
            if client_pid_from_ping_response(response) != pid:
                raise SystemExit(
                    f"tmux-opener: locked client does not confirm its owner; socket preserved: {error or socket_path}"
                )
        else:
            response, error = client_ping_response(socket_path)
            pid = client_pid_from_ping_response(response)
            if pid is None:
                if original is None:
                    return
                with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
                    probe.settimeout(0.2)
                    try:
                        probe.connect(str(socket_path))
                    except OSError as exc:
                        if exc.errno == errno.ECONNREFUSED:
                            # Leave stale cleanup to the next locked bind.
                            return
                raise SystemExit(f"tmux-opener: cannot identify legacy listener; refusing to replace: {error or socket_path}")
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        except PermissionError as exc:
            raise SystemExit(f"tmux-opener: permission denied stopping client {pid}; socket preserved") from exc
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            if locked:
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    return
                except BlockingIOError:
                    pass
            elif not process_exists(pid):
                return
            time.sleep(0.05)
        raise SystemExit(f"tmux-opener: client {pid} did not release ownership; socket preserved")
    finally:
        os.close(fd)


def restart_client(args: argparse.Namespace) -> None:
    host = infer_host(args)
    socket_path = local_socket_path(args, host)
    with operation_lock(socket_path, args.dry_run):
        service = installed_service(socket_path)
        if service is not None:
            previous, _error = client_ping_response(socket_path)
            start_service(service, args.dry_run, restart=True)
            if not args.dry_run:
                wait_for_client(socket_path, previous)
            return
        stop_client(socket_path, args.dry_run)
        start_client(
            host,
            socket_path,
            args.client_verbose,
            args.dry_run,
            args.vscode_folder_window,
            args.vscode_file_window,
            Path(args.ssh_config).expanduser(),
        )


def read_text_if_exists(path: Path) -> str:
    try:
        return path.read_text() if path.exists() else ""
    except OSError:
        return ""


def ssh_query_or_error(host: str, config_path: Path) -> tuple[dict[str, list[str]], str | None]:
    try:
        return ssh_query(host, config_path), None
    except (SystemExit, OSError, subprocess.TimeoutExpired) as exc:
        return {}, str(exc)


def managed_include_present(config_path: Path, snippet_dir: Path) -> bool:
    return include_line(snippet_dir) in read_text_if_exists(config_path).splitlines()


def managed_snippet_status(host: str, local_socket: Path, snippet_dir: Path) -> tuple[str, Path]:
    path = host_snippet_path(host, snippet_dir)
    if not path.exists():
        return "missing", path
    if managed_snippet_matches(host, local_socket, snippet_dir):
        return "ok", path
    return "differs", path


def has_expected_remote_forward(values: dict[str, list[str]], local_socket: Path) -> bool:
    user = values.get("user", [None])[0]
    expected_remotes = {remote_socket_path()}
    if user:
        expected_remotes.add(remote_socket_path(user))
    expected_local = str(local_socket)
    for value in values.get("remoteforward", []):
        fields = value.split()
        if len(fields) >= 2 and fields[0] in expected_remotes and fields[1] == expected_local:
            return True
    return False


def next_action(
    host: str,
    include_present: bool,
    snippet_status: str,
    remote_forward_ok: bool,
    has_any_remote_forward: bool,
    client_ok: bool,
    ssh_error: str | None,
) -> str:
    if ssh_error:
        return f"fix local SSH config, then run `ssh -G {host}` again"
    if has_any_remote_forward and not remote_forward_ok:
        return f"run `tmux-opener install-host {host} --force` or remove the conflicting RemoteForward"
    if not include_present or snippet_status != "ok":
        return f"run `tmux-opener install-host {host}`"
    if not remote_forward_ok:
        return f"run `tmux-opener install-host {host}`"
    if not client_ok:
        return f"run `tmux-opener restart-client {host}`"
    return f"connect with `tmux-opener ssh {host}`"


def print_remote_localhost_forwards(ping_response: dict[str, object], label: str = "remote localhost forwards") -> None:
    forwards = ping_response.get("remote_localhost_forwards")
    if not isinstance(forwards, list) or not forwards:
        print(f"{label}: none")
        return

    print(f"{label}:")
    for forward in forwards:
        if not isinstance(forward, dict):
            continue
        ssh_host = forward.get("ssh_host", "unknown")
        remote_host = forward.get("remote_host", "localhost")
        remote_port = forward.get("remote_port", "unknown")
        local_port = forward.get("local_port", "unknown")
        print(f"  {ssh_host} {remote_host}:{remote_port} -> 127.0.0.1:{local_port}")


REMOTE_PING_CODE = r"""
import json, socket, sys, time
deadline = time.monotonic() + 3
frame = bytearray()
try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as peer:
        peer.settimeout(max(0.001, deadline - time.monotonic()))
        peer.connect(sys.argv[1])
        peer.settimeout(max(0.001, deadline - time.monotonic()))
        peer.sendall(b'{"version":1,"action":"ping"}\n')
        while b"\n" not in frame:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise ValueError()
            peer.settimeout(remaining)
            chunk = peer.recv(min(65536, 1048577 - len(frame)))
            if not chunk:
                raise ValueError()
            frame.extend(chunk)
            if len(frame) > 1048576:
                raise ValueError()
    frame = bytes(frame).split(b"\n", 1)[0]
    response = json.loads(frame)
    if not isinstance(response, dict) or response.get("ok") is not True:
        raise ValueError()
    if response.get("client") != "tmux-opener-client" or type(response.get("version")) is not int or response["version"] != 1:
        raise ValueError()
    sys.stdout.buffer.write(frame + b"\n")
except (OSError, ValueError, RecursionError):
    sys.exit(3)
"""


def remote_ping_response(
    host: str, config_path: Path, remote_socket: str,
) -> tuple[dict[str, object] | None, int, str | None]:
    command = ["ssh"]
    if config_path != default_ssh_config():
        command.extend(["-F", str(config_path)])
    command.extend([
        "-oBatchMode=yes", "-oClearAllForwardings=yes", "-oControlMaster=no",
        "-oControlPath=none", "-oControlPersist=no", "-oConnectTimeout=5",
        "-oConnectionAttempts=1", "-oPermitLocalCommand=no", "-oRemoteCommand=none",
        "-oForkAfterAuthentication=no", "-oSessionType=default", "-oForwardAgent=no",
        "-oForwardX11=no", "-T", "--",
        host, shlex.join(["python3", "-c", REMOTE_PING_CODE, remote_socket]),
    ])
    deadline = time.monotonic() + 10
    frame = bytearray()
    try:
        process = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        return None, 2, "cannot launch diagnostic SSH; check that ssh is installed"
    try:
        assert process.stdout is not None
        with selectors.DefaultSelector() as selector:
            selector.register(process.stdout, selectors.EVENT_READ)
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0 or not selector.select(remaining):
                    return None, 2, "diagnostic SSH deadline exceeded; check authentication and connectivity"
                chunk = os.read(process.stdout.fileno(), min(65536, MAX_PING_BYTES + 1 - len(frame)))
                if not chunk:
                    break
                frame.extend(chunk)
                if len(frame) > MAX_PING_BYTES:
                    return None, 3, "remote ping exceeded the response limit"
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return None, 2, "diagnostic SSH deadline exceeded"
        code = process.wait(timeout=remaining)
        if code == 255:
            return None, 2, "SSH transport failed; check BatchMode authentication, host key trust and connectivity"
        if code != 0:
            return None, 3, "remote ping failed; check remote python3 and the existing forwarded socket"
        try:
            return parse_ping_response(bytes(frame)), 0, None
        except ValueError as exc:
            return None, 3, str(exc)
    except (OSError, subprocess.TimeoutExpired):
        return None, 2, "diagnostic SSH failed or timed out"
    finally:
        if process.poll() is None:
            process.kill()
        process.wait()
        if process.stdout is not None:
            process.stdout.close()


def doctor(args: argparse.Namespace) -> int:
    host = infer_host(args)
    socket_path = local_socket_path(args, host)
    config_path = Path(args.ssh_config).expanduser()
    snippet_dir = Path(args.snippet_dir).expanduser()

    include_present = managed_include_present(config_path, snippet_dir)
    snippet_status, snippet_path = managed_snippet_status(host, socket_path, snippet_dir)
    values, ssh_error = ssh_query_or_error(host, config_path)
    remoteforwards = values.get("remoteforward", [])
    remote_forward_ok = has_expected_remote_forward(values, socket_path)
    ping_response, ping_error = client_ping_response(socket_path, allow_legacy=False)
    client_ok = bool(ping_response and ping_response.get("ok"))
    user = values.get("user", [None])[0]
    remote_socket = remote_socket_path(user)

    include_state = "ok" if include_present else "missing"
    print(f"host: {host}")
    print(f"ssh config: {config_path}")
    print(f"managed include: {include_state} ({include_line(snippet_dir)})")
    print(f"managed snippet: {snippet_status} ({snippet_path})")
    print("ssh -G remoteforward:")
    if ssh_error:
        print(f"  error: {ssh_error}")
    elif remoteforwards:
        for value in remoteforwards:
            print(f"  remoteforward {value}")
    else:
        print("  none")
    print(f"expected local socket: {socket_path}")
    print(f"local client ping: {'ok' if client_ok else 'failed'}")
    if ping_response:
        print(f"local client pid: {ping_response.get('pid', 'unknown')}")
        print(f"local client default SSH host: {ping_response.get('default_ssh_host') or 'unset'}")
        print_remote_localhost_forwards(ping_response)
    elif ping_error:
        print(f"local client error: {ping_error}")
    print(f"expected remote socket: {remote_socket}")
    print(
        "next: "
        + next_action(
            host,
            include_present,
            snippet_status,
            remote_forward_ok,
            bool(remoteforwards),
            client_ok,
            ssh_error,
        )
    )
    local_ok = bool(include_present and snippet_status == "ok" and remote_forward_ok and client_ok and not ssh_error)
    if not args.remote:
        print("remote round-trip: not requested (use --remote to check the existing bridge)")
        return 0 if local_ok else 1
    if not user or ssh_error:
        print("remote round-trip: skipped; fix local SSH configuration first")
        return 1
    if not ping_response or not isinstance(ping_response.get("instance_id"), str) or not ping_response["instance_id"]:
        print("remote round-trip: skipped; upgrade/start the expected local client to obtain its instance identity")
        return 1
    remote_response, code, error = remote_ping_response(host, config_path, remote_socket)
    if error:
        print(f"remote {'transport' if code == 2 else 'ping'}: failed ({error})")
        print("next: inspect the existing SSH bridge; this diagnostic does not create or repair forwards")
        return code
    if remote_response is None or remote_response.get("instance_id") != ping_response["instance_id"]:
        print("remote ping: wrong desktop/client instance")
        print("next: reconnect the bridge from the intended desktop; the existing remote socket routes elsewhere")
        return 4
    print("remote round-trip: ok (same Local Opener Client instance)")
    return 0 if local_ok else 1


def status(args: argparse.Namespace) -> None:
    host = infer_host(args)
    socket_path = local_socket_path(args, host)
    log_path = socket_path.with_suffix(".log")
    ping_response, ping_error = client_ping_response(socket_path)
    client_ok = bool(ping_response and ping_response.get("ok"))
    socket_state = "exists" if socket_path.exists() else "missing"

    print(f"host: {host}")
    print(f"local socket: {socket_path} ({socket_state})")
    print(f"client ping: {'ok' if client_ok else 'failed'}")
    if ping_response:
        print(f"client pid: {ping_response.get('pid', 'unknown')}")
        print(f"client default SSH host: {ping_response.get('default_ssh_host') or 'unset'}")
        print_remote_localhost_forwards(ping_response)
    elif ping_error:
        print(f"client error: {ping_error}")
    print(f"log path: {log_path}")
    print(f"expected default/allowed SSH host: {host}")


def service_spec(socket_path: Path, backend: str) -> tuple[str, Path, str]:
    key = hashlib.sha256(str(socket_path.absolute()).encode()).hexdigest()[:20]
    label = f"org.tmux-opener.client-{key}"
    if backend == "launchd":
        return backend, Path.home() / "Library" / "LaunchAgents" / f"{label}.plist", label
    return backend, Path.home() / ".config" / "systemd" / "user" / f"{label}.service", f"{label}.service"


def installed_service(socket_path: Path) -> tuple[str, Path, str] | None:
    for backend in ("launchd", "systemd"):
        spec = service_spec(socket_path, backend)
        try:
            info = spec[1].lstat()
        except FileNotFoundError:
            continue
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            raise SystemExit(f"tmux-opener: unsafe service file: {spec[1]}")
        return spec
    return None


def supervisor_command(command: list[str], dry_run: bool = False) -> None:
    if dry_run:
        print("would run: " + shlex.join(command))
        return
    try:
        subprocess.run(command, check=True, timeout=15)
    except (OSError, subprocess.SubprocessError) as exc:
        raise SystemExit(f"tmux-opener: supervisor command failed: {shlex.join(command)} ({exc})") from exc


def launchd_loaded(label: str) -> bool:
    try:
        result = subprocess.run(
            ["launchctl", "print", f"gui/{os.getuid()}/{label}"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise SystemExit(f"tmux-opener: cannot query launchd: {exc}") from exc
    return result.returncode == 0


def start_service(spec: tuple[str, Path, str], dry_run: bool, restart: bool = False) -> None:
    backend, path, label = spec
    if backend == "systemd":
        supervisor_command(["systemctl", "--user", "restart" if restart else "start", label], dry_run)
    else:
        domain = f"gui/{os.getuid()}"
        if dry_run or not launchd_loaded(label):
            supervisor_command(["launchctl", "bootstrap", domain, str(path)], dry_run)
        if restart:
            supervisor_command(["launchctl", "kickstart", "-k", f"{domain}/{label}"], dry_run)
        else:
            supervisor_command(["launchctl", "kickstart", f"{domain}/{label}"], dry_run)


def disable_service(spec: tuple[str, Path, str], dry_run: bool) -> None:
    backend, path, label = spec
    if backend == "systemd":
        supervisor_command(["systemctl", "--user", "disable", "--now", label], dry_run)
    elif dry_run or launchd_loaded(label):
        supervisor_command(["launchctl", "bootout", f"gui/{os.getuid()}", str(path)], dry_run)


def wait_for_client(socket_path: Path, previous: dict[str, object] | None = None) -> None:
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        response, _error = client_ping_response(socket_path)
        changed = previous is None or (
            response is not None
            and (response.get("instance_id"), response.get("pid")) != (previous.get("instance_id"), previous.get("pid"))
        )
        if response and response.get("ok") is True and changed:
            return
        time.sleep(0.05)
    raise SystemExit(f"tmux-opener: supervised client did not become ready; inspect {socket_path.with_suffix('.log')}")


def systemd_quote(value: str, *, argument: bool = True) -> str:
    if any(ord(char) < 32 or ord(char) == 127 for char in value):
        raise SystemExit("tmux-opener: control characters are not supported in service arguments")
    value = value.replace("\\", "\\\\").replace('"', '\\"').replace("%", "%%")
    if argument:
        value = value.replace("$", "$$")
    return '"' + value + '"'


def service_content(args: argparse.Namespace, host: str, socket_path: Path, backend: str) -> str:
    command = [sys.executable, *client_command(
        host, socket_path, args.client_verbose, args.vscode_folder_window,
        args.vscode_file_window, Path(args.ssh_config).expanduser(),
    )]
    log_path = socket_path.with_suffix(".log")
    if backend == "launchd":
        return plistlib.dumps({
            "Label": service_spec(socket_path, backend)[2],
            "ProgramArguments": command,
            "RunAtLoad": True,
            "KeepAlive": True,
            "ThrottleInterval": 3,
            "Umask": 0o077,
            "EnvironmentVariables": {"PATH": os.environ.get("PATH", "/usr/bin:/bin")},
            "StandardOutPath": str(log_path),
            "StandardErrorPath": str(log_path),
        }).decode()
    return "\n".join([
        "[Unit]", "Description=tmux-opener Local Opener Client", "",
        "[Service]", "Type=simple", "UMask=0077",
        "ExecStart=" + " ".join(systemd_quote(part) for part in command),
        "StandardOutput=append:" + str(log_path).replace("%", "%%"),
        "Environment=" + systemd_quote("PATH=" + os.environ.get("PATH", "/usr/bin:/bin"), argument=False),
        "StandardError=inherit", "Restart=always", "RestartSec=3", "",
        "[Install]", "WantedBy=default.target", "",
    ])


def selected_backend(args: argparse.Namespace) -> str:
    if args.systemd_user:
        return "systemd"
    if args.launchd:
        return "launchd"
    if platform.system() == "Darwin":
        return "launchd"
    if platform.system() == "Linux":
        return "systemd"
    raise SystemExit("tmux-opener: native services require macOS or Linux")


def install_service(args: argparse.Namespace) -> None:
    host = infer_host(args)
    socket_path = local_socket_path(args, host).absolute()
    backend = selected_backend(args)
    spec = service_spec(socket_path, backend)
    content = service_content(args, host, socket_path, backend)
    with operation_lock(socket_path, args.dry_run):
        previous = installed_service(socket_path)
        if previous is not None:
            if previous[0] != backend:
                raise SystemExit("tmux-opener: uninstall the existing service before changing supervisors")
            disable_service(previous, args.dry_run)
        stop_client(socket_path, args.dry_run)
        if args.dry_run:
            print(f"would write {spec[1]} (mode 0600):\n{content}")
        else:
            spec[1].parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            fd = open_private_file(spec[1])
            with os.fdopen(fd, "w") as config:
                config.truncate()
                config.write(content)
            os.close(open_private_file(socket_path.with_suffix(".log"), os.O_WRONLY | os.O_APPEND))
        if backend == "systemd":
            supervisor_command(["systemctl", "--user", "daemon-reload"], args.dry_run)
            supervisor_command(["systemctl", "--user", "enable", "--now", spec[2]], args.dry_run)
        else:
            start_service(spec, args.dry_run)
        if not args.dry_run:
            wait_for_client(socket_path)


def uninstall_service(args: argparse.Namespace) -> None:
    host = infer_host(args)
    socket_path = local_socket_path(args, host).absolute()
    with operation_lock(socket_path, args.dry_run):
        spec = installed_service(socket_path)
        if spec is None:
            print("no installed service for this socket")
            return
        disable_service(spec, args.dry_run)
        stop_client(socket_path, args.dry_run)
        if args.dry_run:
            print(f"would remove {spec[1]}")
        else:
            spec[1].unlink()
        if spec[0] == "systemd":
            supervisor_command(["systemctl", "--user", "daemon-reload"], args.dry_run)


def run_ssh(args: argparse.Namespace) -> int:
    local_socket = install_host(args)
    ensure_client(args, local_socket)

    command = ["ssh"]
    config_path = Path(args.ssh_config).expanduser()
    if config_path != default_ssh_config():
        command.extend(["-F", str(config_path)])
    command.extend([args.host, *args.ssh_args])
    if args.dry_run:
        print("would run:")
        print("  " + " ".join(shell_quote(part) for part in command))
        return 0

    os.execvp(command[0], command)
    return 127


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subcommands = parser.add_subparsers(dest="command", required=True)

    install = subcommands.add_parser("install-host", help="install managed SSH forwarding for a host")
    install.add_argument("host")
    install.add_argument("--socket")
    install.add_argument("--state-dir", default=default_state_dir())
    install.add_argument("--ssh-config", default=default_ssh_config())
    install.add_argument("--snippet-dir", default=default_snippet_dir())
    install.add_argument("--dry-run", action="store_true")
    install.add_argument("--force", action="store_true")
    install.set_defaults(func=install_host)

    uninstall = subcommands.add_parser("uninstall-host", help="remove managed SSH forwarding for a host")
    uninstall.add_argument("host")
    uninstall.add_argument("--ssh-config", default=default_ssh_config())
    uninstall.add_argument("--snippet-dir", default=default_snippet_dir())
    uninstall.add_argument("--dry-run", action="store_true")
    uninstall.add_argument("--quiet", action="store_true")
    uninstall.set_defaults(func=uninstall_host)

    ssh = subcommands.add_parser("ssh", help="install bridge config, ensure client, then exec ssh")
    ssh.add_argument("host")
    ssh.add_argument("ssh_args", nargs=argparse.REMAINDER)
    ssh.add_argument("--socket")
    ssh.add_argument("--state-dir", default=default_state_dir())
    ssh.add_argument("--ssh-config", default=default_ssh_config())
    ssh.add_argument("--snippet-dir", default=default_snippet_dir())
    ssh.add_argument("--dry-run", action="store_true")
    ssh.add_argument("--force", action="store_true")
    ssh.add_argument("--no-start-client", action="store_true")
    ssh.add_argument("--client-verbose", action="store_true", help="start the local client with full request-payload logging")
    ssh.add_argument("--vscode-folder-window", choices=("new", "reuse"), default="new")
    ssh.add_argument("--vscode-file-window", choices=("new", "reuse"), default="new")
    ssh.set_defaults(func=run_ssh)

    doctor_parser = subcommands.add_parser("doctor", help="show local lifecycle diagnostics for a host")
    doctor_parser.add_argument("host", nargs="?")
    doctor_parser.add_argument("--socket")
    doctor_parser.add_argument("--state-dir", default=default_state_dir())
    doctor_parser.add_argument("--ssh-config", default=default_ssh_config())
    doctor_parser.add_argument("--snippet-dir", default=default_snippet_dir())
    doctor_parser.add_argument("--remote", action="store_true", help="ping the existing remote bridge using noninteractive SSH")
    doctor_parser.set_defaults(func=doctor)

    status_parser = subcommands.add_parser("status", help="show terse local client status for a host")
    status_parser.add_argument("host", nargs="?")
    status_parser.add_argument("--socket")
    status_parser.add_argument("--state-dir", default=default_state_dir())
    status_parser.add_argument("--snippet-dir", default=default_snippet_dir())
    status_parser.set_defaults(func=status)

    restart = subcommands.add_parser("restart-client", help="replace the local client for a host socket")
    restart.add_argument("host", nargs="?")
    restart.add_argument("--socket")
    restart.add_argument("--state-dir", default=default_state_dir())
    restart.add_argument("--snippet-dir", default=default_snippet_dir())
    restart.add_argument("--ssh-config", default=default_ssh_config())
    restart.add_argument("--dry-run", action="store_true")
    restart.add_argument("--client-verbose", action="store_true", help="start the local client with full request-payload logging")
    restart.add_argument("--vscode-folder-window", choices=("new", "reuse"), default="new")
    restart.add_argument("--vscode-file-window", choices=("new", "reuse"), default="new")
    restart.set_defaults(func=restart_client)

    for name, handler in (("install-service", install_service), ("uninstall-service", uninstall_service)):
        service = subcommands.add_parser(name, help="manage the native desktop client service")
        service.add_argument("host", nargs="?")
        service.add_argument("--socket")
        service.add_argument("--state-dir", default=default_state_dir())
        service.add_argument("--snippet-dir", default=default_snippet_dir())
        service.add_argument("--ssh-config", default=default_ssh_config())
        backend = service.add_mutually_exclusive_group()
        backend.add_argument("--systemd-user", action="store_true")
        backend.add_argument("--launchd", action="store_true")
        service.add_argument("--dry-run", action="store_true")
        service.add_argument("--client-verbose", action="store_true")
        service.add_argument("--vscode-folder-window", choices=("new", "reuse"), default="new")
        service.add_argument("--vscode-file-window", choices=("new", "reuse"), default="new")
        service.set_defaults(func=handler)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    result = args.func(args)
    return 0 if result is None or isinstance(result, Path) else int(result)


if __name__ == "__main__":
    raise SystemExit(main())
