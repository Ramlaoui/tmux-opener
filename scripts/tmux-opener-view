#!/usr/bin/env python3
"""Show a file or folder in the terminal with the best viewer installed.

The remote plugin runs this inside a tmux popup for the Inline opener. Every
viewer reads the path as an argument; nothing from the file is executed.
"""

from __future__ import annotations

import argparse
import csv
import io
import shutil
import subprocess
import sys
from pathlib import Path


HIGHLIGHT_LIMIT = 20 * 1024 * 1024  # larger text skips bat/jq and streams through less
TABLE_ROWS = 5000
TABLE_CELL = 40
IMAGE_SUFFIXES = frozenset({".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".tif", ".tiff"})


def prompt_text(text: str) -> str:
    return "".join("\\" + char if char in "?:.%\\" else char for char in text)


def pager(name: str, line: int | None = None, *, chop: bool = False, numbers: bool = False) -> list[str]:
    # -+F keeps short files open: the popup closes as soon as the viewer exits.
    command = ["less", "-R", "-+F", f"-Ps{prompt_text(name)}  line %lb?L/%L.  q quits"]
    if chop:
        command.append("-S")
    if numbers:
        command.append("-N")
    if line:
        command.append("-j.3")
    # The jump also repaints: less's first screen can be lost while a popup opens.
    command.append(f"+{line or 1}g")
    return command


def human_size(size: float) -> str:
    for unit in ("B", "KiB", "MiB", "GiB"):
        if size < 1024 or unit == "GiB":
            return f"{size:.0f} {unit}" if unit == "B" else f"{size:.1f} {unit}"
        size /= 1024
    return ""


def is_binary(path: Path) -> bool:
    with path.open("rb") as handle:
        return b"\0" in handle.read(8192)


def describe(path: Path, note: str, which=shutil.which) -> str:
    kind = ""
    if which("file"):
        kind = subprocess.run(["file", "-b", "--", str(path)], capture_output=True, text=True, check=False).stdout.strip()
    return f"{path}\n\n  {kind or 'binary data'}\n  {human_size(path.stat().st_size)}\n\n{note}\n"


def table(path: Path) -> str | None:
    """Align CSV/TSV columns; return None when the file is not a clean table."""

    delimiter = "\t" if path.suffix.lower() == ".tsv" else ","
    rows: list[list[str]] = []
    try:
        with path.open(encoding="utf-8", errors="replace", newline="") as handle:
            for row in csv.reader(handle, delimiter=delimiter):
                rows.append([cell if len(cell) <= TABLE_CELL else cell[: TABLE_CELL - 1] + "…" for cell in row])
                if len(rows) > TABLE_ROWS:
                    break
    except csv.Error:
        return None
    if not rows:
        return None
    truncated = len(rows) > TABLE_ROWS
    rows = rows[:TABLE_ROWS]
    widths = [max(len(row[index]) for row in rows if index < len(row)) for index in range(max(map(len, rows)))]
    out = io.StringIO()
    for number, row in enumerate(rows):
        text = "  ".join(cell.ljust(widths[index]) for index, cell in enumerate(row)).rstrip()
        out.write(f"\033[1m{text}\033[0m\n" if number == 0 else text + "\n")
        if number == 0:
            out.write("  ".join("─" * width for width in widths) + "\n")
    if truncated:
        out.write(f"\n… showing the first {TABLE_ROWS} rows; open in VS Code or Preview for the rest\n")
    return out.getvalue()


def plan(path: Path, line: int | None = None, which=shutil.which, size: tuple[int, int] = (80, 24)) -> tuple[list[str] | str | None, list[str]]:
    """Return (producer, pager): an argv or text piped into the pager, or None when it reads the file."""

    name = path.name or str(path)
    if path.is_dir():
        return ["ls", "-la", str(path)], pager(name)
    suffix = path.suffix.lower()
    if suffix in IMAGE_SUFFIXES:
        columns, rows = size
        if which("chafa"):
            return ["chafa", "--format=symbols", f"--size={columns}x{rows - 2}", str(path)], pager(name)
        if which("timg"):
            return ["timg", "-pq", f"-g{columns}x{rows - 2}", str(path)], pager(name)
        return describe(path, "Install chafa or timg on this host to see images inline,\n"
                              "or use the Preview opener to open them on your desktop.", which), pager(name)
    if is_binary(path):
        return describe(path, "Binary file: use the Preview or Download opener to open it on your desktop.", which), pager(name)
    small = path.stat().st_size <= HIGHLIGHT_LIMIT
    text = table(path) if suffix in {".csv", ".tsv"} and small else None
    if text is not None:
        return text, pager(name, chop=True)
    if suffix == ".json" and small:
        if which("jq"):
            return ["jq", "-C", ".", str(path)], pager(name)
        return [sys.executable, "-m", "json.tool", str(path)], pager(name)
    bat = which("bat") or which("batcat")
    if bat and small:
        highlight = ["--highlight-line", str(line)] if line else []
        return [bat, "--color=always", "--paging=never", "--style=numbers", *highlight, "--", str(path)], pager(name, line)
    return None, pager(name, line, numbers=bool(line)) + ["--", str(path)]


def run(producer: list[str] | str | None, pager_command: list[str]) -> int:
    if producer is None:
        return subprocess.run(pager_command, check=False).returncode
    if isinstance(producer, str):
        viewer = subprocess.Popen(pager_command, stdin=subprocess.PIPE)
        try:
            viewer.communicate(producer.encode("utf-8", "replace"))
        except BrokenPipeError:
            pass
        return viewer.wait()
    source = subprocess.Popen(producer, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    try:
        viewer = subprocess.Popen(pager_command, stdin=source.stdout)
        return viewer.wait()
    finally:
        source.stdout.close()  # type: ignore[union-attr]
        source.kill()
        source.wait()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("path")
    parser.add_argument("--line", type=int)
    args = parser.parse_args()
    path = Path(args.path)
    try:
        return run(*plan(path, args.line, size=tuple(shutil.get_terminal_size())))
    except OSError as exc:
        print(f"tmux-opener: cannot show {path}: {exc.strerror or exc}", file=sys.stderr)
        input("Press Enter to close. ")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
