from tmux_opener_downloads import DownloadQueue  # noqa: E402
import tmux_opener_settings as opener_settings  # noqa: E402


HOST_RE = re.compile(r"^[A-Za-z0-9_.@:-]+$")
DEFAULT_URL_SCHEMES = ("http", "https")
DEFAULT_LOCALHOST_FORWARD_START_PORT = 18000
DEFAULT_LOCALHOST_FORWARD_END_PORT = 18999
LOCALHOST_FORWARD_STARTUP_TIMEOUT = 1.0
PROCESS_STDERR_LOG_LIMIT = 2000
LOCALHOST_SCHEMES = ("http", "https")
REMOTE_LOCALHOST_HOSTS = ("localhost", "127.0.0.1")
REQUEST_TIMEOUT = 2.0
MAX_REQUEST_BYTES = 1024 * 1024
MAX_CONNECTIONS = 32
MAX_LAUNCHES = 32
MAX_FOLDER_FILES = 1000
INSTANCE_ID = uuid.uuid4().hex
STARTED_AT = datetime.now(timezone.utc).isoformat(timespec="seconds")
LAST_REQUEST_AT: str | None = None
HOST_ACTIVITY: dict[str, dict[str, object]] = {}
LAUNCHED_PROCESSES: list[subprocess.Popen[bytes]] = []


@dataclass(slots=True)
class LocalhostForward:
    ssh_host: str
    remote_host: str
    remote_port: int
    local_port: int
    process: subprocess.Popen[bytes]


REMOTE_LOCALHOST_FORWARDS: dict[tuple[str, str, int], LocalhostForward] = {}
REMOTE_PDFS: dict[tuple[str, str], subprocess.Popen[bytes] | None] = {}
SAVE_DIALOG_LOCK = threading.Lock()
# Seconds to wait before resuming after SSH drops a transfer (exit 255).
RESUME_DELAYS = (2, 5)
PARTIAL_MAX_AGE = 7 * 24 * 3600
# Runs under the remote login shell's `sh -c`: print the file identity, then
# stream the file, from offset $2 when the identity still matches $3.
RESUME_SCRIPT = (
    'test -f "$1" || exit 1; '
    'id=$(stat -c "%s %Y" -- "$1" 2>/dev/null || stat -f "%z %m" -- "$1") || exit 1; '
    'echo "$id"; '
    'if [ "$id" = "$3" ]; then exec tail -c +"$2" -- "$1"; else exec cat -- "$1"; fi'
)
# Runs under the remote login shell's `sh -c DIR NAME SIZE TOKEN`: write stdin to a
# private temporary file in DIR, check its size, then publish it as NAME or
# "STEM (N).EXT" without replacing an existing file. Prints the published name.
UPLOAD_SCRIPT = (
    'cd -- "$1" 2>/dev/null || exit 2; '
    'tmp=.tmux-opener-upload-$4; '
    '(set -C; : > "$tmp") 2>/dev/null || exit 3; '
    "trap 'rm -f -- \"$tmp\"' EXIT; trap 'exit 1' HUP INT TERM PIPE; "
    'cat > "$tmp" || exit 6; '
    '[ "$(wc -c < "$tmp" | tr -d " ")" = "$3" ] || exit 4; '
    'case $2 in ?*.*) stem=${2%.*} ext=.${2##*.} ;; *) stem=$2 ext= ;; esac; '
    'target=$2 n=0; '
    'until (set -C; : > "$target") 2>/dev/null; do '
    '[ -e "$target" ] || [ -L "$target" ] || exit 3; '
    'n=$((n + 1)); [ "$n" -lt 100 ] || exit 5; target="$stem ($n)$ext"; '
    'done; '
    'mv -f -- "$tmp" "$target" || exit 3; '
    'printf "%s\\n" "$target"'
)
UPLOAD_ERRORS = {
    2: "the remote folder does not exist or cannot be entered",
    3: "cannot create files in the remote folder",
    4: "the remote copy is incomplete",
    5: "too many files with this name in the remote folder",
    6: "the remote disk could not store the file",
}
ACTIVE_FOLDERS: set[Path] = set()
ACTIVE_FOLDERS_LOCK = threading.Lock()
# Folders download privately, then get the permissions a plain mkdir would give.
UMASK = os.umask(0o077)
os.umask(UMASK)


class RequestError(Exception):
    pass


class ConnectionDropped(RequestError):
    """SSH lost the connection; the partial copy can be resumed."""


def default_socket_path() -> str:
    return os.path.expanduser("~/.local/state/tmux-opener/opener.sock")


def parse_request(raw: bytes) -> dict[str, object]:
    if not raw:
        raise RequestError("empty request")

    try:
        request = json.loads(raw.decode("utf-8"))
    except (ValueError, RecursionError) as exc:
        raise RequestError("invalid JSON request") from exc

    if not isinstance(request, dict):
        raise RequestError("request must be a JSON object")
    if type(request.get("version")) is not int or request["version"] != 1:
        raise RequestError("unsupported request version")
    return request


def ping_response(args: argparse.Namespace) -> dict[str, object]:
    return {
        "ok": True,
        "version": 1,
        "instance_id": INSTANCE_ID,
        "client": "tmux-opener-client",
        "capabilities": ["remote_pdf", "download_status", "settings", "download_folder", "restart_client",
                         "upload_files"],
        "pid": os.getpid(),
        "default_ssh_host": args.default_ssh_host,
        "allowed_ssh_hosts": sorted(args.allow_ssh_host),
        "allow_any_ssh_host": bool(args.allow_any_ssh_host),
        "remote_localhost_forwards": active_remote_localhost_forwards(),
    }


def command_text(command: list[str]) -> str:
    return " ".join(shlex.quote(part) for part in command)


def log_line(message: str) -> None:
    timestamp = datetime.now().isoformat(timespec="seconds")
    print(f"{timestamp} {message}", flush=True)


def reap_children() -> None:
    for process in LAUNCHED_PROCESSES[:]:
        returncode = process.poll()
        if returncode is not None:
            LAUNCHED_PROCESSES.remove(process)
            if returncode:
                log_line(f"opener exited nonzero rc={returncode}")


def launch_command(
    command: list[str],
    dry_run: bool,
    verbose: bool,
    command_label: str | None = None,
) -> subprocess.Popen[bytes] | None:
    label = command_label or "system opener"
    command_display = command_text(command) if verbose else label
    if dry_run:
        log_line(f"dry-run {command_display}")
        return

    reap_children()
    if len(LAUNCHED_PROCESSES) >= MAX_LAUNCHES:
        raise RequestError("too many running openers")
    log_line(f"launch {command_display}")
    try:
        process = subprocess.Popen(
            command,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
        )
    except OSError as exc:
        raise RequestError(f"failed to launch opener (errno={exc.errno})") from exc

    LAUNCHED_PROCESSES.append(process)
    return process


def open_with_system(target: str, dry_run: bool, verbose: bool) -> None:
    system = platform.system()
    if system == "Darwin":
        command = ["open", target]
    elif system == "Windows":
        command = ["cmd", "/c", "start", "", target]
    else:
        command = ["xdg-open", target]

    launch_command(command, dry_run, verbose)


def ssh_transfer_command(ssh: str, ssh_config: str | None) -> list[str]:
    """SSH options for client-built transfer commands; the host and remote command follow."""
    command = [ssh]
    if ssh_config is not None:
        command.extend(["-F", str(Path(ssh_config).expanduser())])
    command.extend([
        "-T", "-S", "none", "-o", "ControlMaster=no", "-o", "ClearAllForwardings=yes",
        "-o", "PermitLocalCommand=no", "-o", "ForkAfterAuthentication=no",
        "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-o", "ServerAliveInterval=15",
        "-o", "ServerAliveCountMax=3",
    ])
    return command


def ssh_command(host: str, remote_command: str, ssh: str, ssh_config: str | None) -> list[str]:
    return ssh_transfer_command(ssh, ssh_config) + ["--", host, remote_command]


def remote_file_command(host: str, path: str, ssh: str, ssh_config: str | None) -> list[str]:
    quoted_path = shlex.quote(path)
    return ssh_command(host, f"test -f {quoted_path} && cat -- {quoted_path}", ssh, ssh_config)


def resume_command(host: str, path: str, offset: int, identity: str, ssh: str, ssh_config: str | None) -> list[str]:
    arguments = " ".join(shlex.quote(value) for value in (path, str(offset + 1), identity))
    return ssh_command(host, f"sh -c {shlex.quote(RESUME_SCRIPT)} sh {arguments}", ssh, ssh_config)


def open_remote_pdf(request: dict[str, object], allowed_hosts: set[str] | None, args: argparse.Namespace) -> None:
    host = validate_host(request.get("ssh_host"), allowed_hosts)
    path = validate_path(request.get("path"))
    if Path(path).suffix.lower() != ".pdf":
        raise RequestError("path must name a PDF")
    refresh = request.get("refresh", False)
    if type(refresh) is not bool:
        raise RequestError("refresh must be a boolean")
    key = (host, path)
    if refresh and key not in REMOTE_PDFS:
        return
    cache = cache_directory("pdf") / cache_key(host, path)
    local_pdf = cache / "document.pdf"
    command = remote_file_command(host, path, shutil.which("ssh") or "ssh", args.ssh_config)
    if args.dry_run:
        log_line("dry-run remote PDF refresh" if refresh else "dry-run remote PDF open")
        return
    try:
        cache.mkdir(mode=0o700, parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(dir=cache) as staging:
            downloaded = Path(staging) / "document.pdf"
            with downloaded.open("wb") as output:
                result = subprocess.run(command, stdout=output, stderr=subprocess.PIPE,
                                        stdin=subprocess.DEVNULL, timeout=20, check=False)
            if result.returncode:
                if args.verbose:
                    log_line(result.stderr[-PROCESS_STDERR_LOG_LIMIT:].decode("utf-8", errors="replace"))
                raise RequestError(f"PDF transfer failed (ssh rc={result.returncode})")
            with downloaded.open("rb") as output:
                header = output.read(5)
            if header != b"%PDF-":
                raise RequestError("remote file does not have a PDF header")
            if not local_pdf.exists() or not filecmp.cmp(downloaded, local_pdf, shallow=False):
                # Replace only complete successful downloads; keep the last good PDF on failures.
                os.replace(downloaded, local_pdf)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise RequestError(f"PDF transfer failed ({type(exc).__name__})") from exc
    viewer = pdf_viewer(args)
    if refresh:
        if viewer == "sioyek":
            executable = opener_settings.sioyek_executable()
            if not executable:
                raise RequestError("Sioyek is not installed")
            try:
                result = subprocess.run(
                    [executable, "--nofocus", str(local_pdf), "--execute-command", "reload"],
                    stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                    timeout=5, check=False,
                )
            except (OSError, subprocess.TimeoutExpired) as exc:
                raise RequestError(f"Sioyek reload failed ({type(exc).__name__})") from exc
            if result.returncode:
                raise RequestError("Sioyek reload failed")
        if viewer == "acrobat":
            script = '''on run argv
if application "Adobe Acrobat" is not running then return
tell application "Adobe Acrobat"
    repeat with pdfDocument in (get documents)
        if (POSIX path of (file alias of pdfDocument)) is (item 1 of argv) then
            if modified of pdfDocument then error "Acrobat has unsaved edits; save them before refreshing" number 1
            set pdfWindow to PDF Window 1 of pdfDocument
            set oldPage to page number of pdfWindow
            set oldZoom to zoom factor of pdfWindow
            close pdfDocument saving no
            open (POSIX file (item 1 of argv))
            set page number of PDF Window 1 of active doc to oldPage
            set zoom factor of PDF Window 1 of active doc to oldZoom
            exit repeat
        end if
    end repeat
end tell
end run'''
            try:
                result = subprocess.run(["osascript", "-e", script, str(local_pdf)],
                                        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                        stderr=subprocess.PIPE, timeout=5, check=False)
            except (OSError, subprocess.TimeoutExpired) as exc:
                raise RequestError(f"Acrobat reload failed ({type(exc).__name__})") from exc
            if result.returncode:
                if b"Acrobat has unsaved edits" in result.stderr:
                    raise RequestError("Acrobat has unsaved edits; save them before refreshing")
                raise RequestError("Acrobat reload failed; allow the desktop client to control Acrobat in macOS Automation settings")
        if viewer == "skim":
            # Skim watches file objects; replacing the cache needs an explicit reload.
            script = '''on run argv
if application "Skim" is not running then return
tell application "Skim"
    set matchingDocuments to get documents whose path is (item 1 of argv)
    repeat with pdfDocument in matchingDocuments
        if modified of pdfDocument then error "Skim has unsaved notes; save them before refreshing" number 1
        revert pdfDocument
    end repeat
end tell
end run'''
            try:
                result = subprocess.run(["osascript", "-e", script, str(local_pdf)],
                                        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                        stderr=subprocess.PIPE, timeout=5, check=False)
            except (OSError, subprocess.TimeoutExpired) as exc:
                raise RequestError(f"Skim reload failed ({type(exc).__name__})") from exc
            if result.returncode:
                if args.verbose:
                    log_line(result.stderr[-PROCESS_STDERR_LOG_LIMIT:].decode("utf-8", errors="replace"))
                if b"Skim has unsaved notes" in result.stderr:
                    raise RequestError("Skim has unsaved notes; save them before refreshing")
                raise RequestError("Skim reload failed; allow the desktop client to control Skim in macOS Automation settings")
        return
    process = REMOTE_PDFS.get(key)
    if viewer != "zathura" or process is None or process.poll() is not None:
        process = open_local_copy(local_pdf, args)
    REMOTE_PDFS[key] = process


def pdf_viewer(args: argparse.Namespace) -> str:
    viewer = getattr(args, "pdf_viewer", None) or opener_settings.load()[0]["pdf_viewer"]
    if viewer == "auto":
        if platform.system() == "Linux" and shutil.which("zathura"):
            return "zathura"
        if platform.system() == "Darwin" and Path("/Applications/Skim.app").is_dir():
            return "skim"
        return "system"
    return str(viewer)


def open_local_copy(path: Path, args: argparse.Namespace) -> subprocess.Popen[bytes] | None:
    viewer = pdf_viewer(args) if path.suffix.lower() == ".pdf" else "system"
    if viewer == "zathura":
        return launch_command(["zathura", str(path)], False, args.verbose, "PDF viewer")
    if viewer == "skim":
        return launch_command(["open", "-a", "Skim", str(path)], False, args.verbose, "PDF viewer")
    if viewer == "sioyek":
        executable = opener_settings.sioyek_executable()
        if not executable:
            raise RequestError("Sioyek is not installed")
        return launch_command([executable, "--new-window", str(path)], False, args.verbose, "PDF viewer")
    if viewer == "acrobat":
        application = opener_settings.pdf_application("acrobat")
        if application is None:
            raise RequestError("Adobe Acrobat is not installed on this Mac")
        return launch_command(["open", "-a", str(application), str(path)], False, args.verbose, "PDF viewer")
    open_with_system(str(path), False, args.verbose)
    return None


def validate_url(url: object, allowed_schemes: set[str]) -> str:
    if not isinstance(url, str):
        raise RequestError("url must be a string")
    if "\x00" in url:
        raise RequestError("url contains a NUL byte")
    try:
        url.encode("utf-8")
        parsed = urllib.parse.urlparse(url)
    except (ValueError, UnicodeError) as exc:
        raise RequestError("invalid URL") from exc
    if parsed.scheme not in allowed_schemes:
        raise RequestError("url scheme is not allowed")
    if not parsed.netloc and parsed.scheme in {"http", "https"}:
        raise RequestError("url must include a host")
    return url


def validate_host(host: object, allowed_hosts: set[str] | None) -> str:
    if not isinstance(host, str) or not host:
        raise RequestError("ssh_host must be a non-empty string")
    if not HOST_RE.fullmatch(host):
        raise RequestError("ssh_host contains unsupported characters")
    if allowed_hosts is not None and host not in allowed_hosts:
        raise RequestError("ssh_host is not allowed")
    return host


def validate_path(path: object) -> str:
    if not isinstance(path, str) or not path.startswith("/"):
        raise RequestError("path must be an absolute remote path")
    if "\x00" in path:
        raise RequestError("path contains a NUL byte")
    try:
        path.encode("utf-8")
    except UnicodeError as exc:
        raise RequestError("path contains invalid Unicode") from exc
    return path


def validate_target_type(target_type: object) -> str:
    if target_type in (None, "file"):
        return "file"
    if target_type == "folder":
        return "folder"
    raise RequestError("unsupported target_type")


def validate_port(value: object, field: str = "port") -> int:
    if isinstance(value, bool) or not isinstance(value, int):
        raise RequestError(f"{field} must be an integer")
    if not 1 <= value <= 65535:
        raise RequestError(f"{field} is out of range")
    return value


def validate_remote_localhost_host(value: object) -> str:
    if value in (None, "0.0.0.0"):
        return "127.0.0.1"
    if value in REMOTE_LOCALHOST_HOSTS:
        return str(value)
    raise RequestError("unsupported remote localhost host")


def validate_remote_localhost_scheme(value: object) -> str:
    if value in LOCALHOST_SCHEMES:
        return str(value)
    raise RequestError("unsupported remote localhost scheme")


def validate_url_part(value: object, field: str, prefix: str | None = None) -> str:
    if value is None:
        return ""
    if not isinstance(value, str):
        raise RequestError(f"{field} must be a string")
    if "\x00" in value or "\r" in value or "\n" in value:
        raise RequestError(f"{field} contains unsupported characters")
    try:
        value.encode("utf-8")
    except UnicodeError as exc:
        raise RequestError(f"{field} contains invalid Unicode") from exc
    if prefix and value and not value.startswith(prefix):
        raise RequestError(f"{field} must start with {prefix}")
    return value


def vscode_remote_uri(host: str, path: str) -> str:
    host_q = urllib.parse.quote(host, safe="@.-_:")
    path_q = urllib.parse.quote(path, safe="/:._-")
    return f"vscode-remote://ssh-remote+{host_q}{path_q}"


def vscode_remote_authority(host: str) -> str:
    return f"ssh-remote+{host}"


def vscode_app_url(host: str, path: str) -> str:
    host_q = urllib.parse.quote(host, safe="@.-_:")
    path_q = urllib.parse.quote(path, safe="/:._-")
    return f"vscode://vscode-remote/ssh-remote+{host_q}{path_q}"


def vscode_window_flags(policy: str) -> list[str]:
    if policy == "new":
        return ["--new-window"]
    if policy == "reuse":
        return ["--reuse-window"]
    raise RequestError("unsupported VS Code window policy")


def open_vscode_remote(
    request: dict[str, object],
    allowed_hosts: set[str] | None,
    dry_run: bool,
    verbose: bool,
    folder_window: str = "new",
    file_window: str = "new",
) -> None:
    host = validate_host(request.get("ssh_host"), allowed_hosts)
    path = validate_path(request.get("path"))
    target_type = validate_target_type(request.get("target_type"))
    line = request.get("line")
    column = request.get("column")
    workspace_path = None
    if target_type == "file" and request.get("workspace_path") is not None:
        workspace_path = validate_path(request.get("workspace_path"))

    code = shutil.which("code")
    if code:
        remote_target = path
        if target_type == "file" and isinstance(line, int):
            remote_target = f"{remote_target}:{line}"
            if isinstance(column, int):
                remote_target = f"{remote_target}:{column}"

        window_policy = folder_window if target_type == "folder" else file_window
        window_flags = vscode_window_flags(window_policy)
        goto_flags = ["--goto"] if target_type == "file" and isinstance(line, int) else []
        command = [
            code,
            *window_flags,
            *goto_flags,
            "--remote",
            vscode_remote_authority(host),
        ]
        if target_type == "file" and workspace_path:
            command.extend([workspace_path, remote_target])
        else:
            command.append(remote_target)
        launch_command(command, dry_run, verbose, command_label="code")
        return

    open_with_system(vscode_app_url(host, path), dry_run, verbose)


def active_remote_localhost_forwards() -> list[dict[str, object]]:
    active = []
    for forward in list(REMOTE_LOCALHOST_FORWARDS.values()):
        if forward.process.poll() is not None:
            continue
        active.append(
            {
                "ssh_host": forward.ssh_host,
                "remote_host": forward.remote_host,
                "remote_port": forward.remote_port,
                "local_port": forward.local_port,
            }
        )
    return active


def stop_remote_localhost_forwards() -> None:
    for key, forward in list(REMOTE_LOCALHOST_FORWARDS.items()):
        if forward.process.poll() is None:
            log_line(
                "stop tunnel: "
                f"{forward.ssh_host} {forward.remote_host}:{forward.remote_port} "
                f"-> 127.0.0.1:{forward.local_port}"
            )
            terminate_process(forward.process)
        REMOTE_LOCALHOST_FORWARDS.pop(key, None)


def preferred_localhost_port(remote_port: int, start_port: int, end_port: int) -> int:
    preferred = 10000 + remote_port
    if start_port <= preferred <= end_port:
        return preferred
    return start_port


def port_available(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
        probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            probe.bind(("127.0.0.1", port))
        except OSError:
            return False
    return True


def allocate_localhost_forward_port(remote_port: int, start_port: int, end_port: int) -> int:
    if start_port > end_port:
        raise RequestError("localhost forward port range is invalid")

    preferred = preferred_localhost_port(remote_port, start_port, end_port)
    candidates = [preferred]
    candidates.extend(port for port in range(start_port, end_port + 1) if port != preferred)
    for port in candidates:
        if port_available(port):
            return port
    raise RequestError(f"no free localhost forward port in range {start_port}-{end_port}")


def localhost_port_ready(port: int) -> bool:
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.1):
            return True
    except OSError:
        return False


def process_stderr(stderr_log: BinaryIO) -> str:
    stderr_log.flush()
    stderr_log.seek(0)
    raw = stderr_log.read()
    if not raw:
        return ""
    text = raw.decode("utf-8", errors="replace").strip()
    if len(text) > PROCESS_STDERR_LOG_LIMIT:
        return "..." + text[-PROCESS_STDERR_LOG_LIMIT:]
    return text


def stderr_suffix(stderr_log: BinaryIO) -> str:
    stderr = process_stderr(stderr_log)
    if not stderr:
        return ""
    return f"; stderr: {stderr}"


def wait_for_localhost_forward_start(process: subprocess.Popen[bytes], local_port: int) -> tuple[bool, int | None]:
    deadline = time.monotonic() + LOCALHOST_FORWARD_STARTUP_TIMEOUT
    while time.monotonic() < deadline:
        returncode = process.poll()
        if returncode is not None:
            return False, returncode
        if localhost_port_ready(local_port):
            return True, None
        time.sleep(0.05)
    return localhost_port_ready(local_port), process.poll()


def terminate_process(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is not None:
        return
    process.terminate()
    try:
        process.wait(timeout=1.0)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait(timeout=1.0)


def watch_localhost_forward(
    key: tuple[str, str, int],
    process: subprocess.Popen[bytes],
    command_display: str,
    stderr_log: BinaryIO,
    verbose: bool = False,
) -> None:
    try:
        returncode = process.wait()
        current = REMOTE_LOCALHOST_FORWARDS.get(key)
        if current is not None and current.process is process:
            REMOTE_LOCALHOST_FORWARDS.pop(key, None)
        suffix = stderr_suffix(stderr_log) if verbose else ""
        if returncode:
            log_line(f"localhost forward exited nonzero rc={returncode}: {command_display}{suffix}")
        else:
            log_line(f"localhost forward exited: {command_display}{suffix}")
    finally:
        stderr_log.close()


def localhost_forward_commands(
    ssh_host: str,
    remote_host: str,
    remote_port: int,
    local_port: int,
    control_path: str,
    ssh_config: str | None,
) -> tuple[list[str], list[str]]:
    ssh = shutil.which("ssh") or "ssh"
    master = [ssh]
    if ssh_config is not None:
        master.extend(["-F", str(Path(ssh_config).expanduser())])
    master.extend(
        [
            "-M", "-N", "-S", control_path,
            "-o", "ControlPersist=no",
            "-o", "ClearAllForwardings=yes",
            "-o", "ExitOnForwardFailure=yes",
            "-o", "ForkAfterAuthentication=no",
            "--", ssh_host,
        ]
    )
    # Authentication/routing belong to the master above. This control operation
    # cannot connect independently: -O fails if the private master is unavailable.
    # Reading no config here prevents inherited forwards joining the explicit -L.
    forward = [
        ssh, "-F", os.devnull, "-S", control_path, "-O", "forward",
        "-L", f"127.0.0.1:{local_port}:{remote_host}:{remote_port}",
        "--", ssh_host,
    ]
    return master, forward


def ensure_remote_localhost_forward(
    ssh_host: str,
    remote_host: str,
    remote_port: int,
    args: argparse.Namespace,
) -> int:
    key = (ssh_host, remote_host, remote_port)
    forward = REMOTE_LOCALHOST_FORWARDS.get(key)
    if forward and forward.process.poll() is None:
        return forward.local_port
    if forward:
        REMOTE_LOCALHOST_FORWARDS.pop(key, None)

    local_port = allocate_localhost_forward_port(
        remote_port,
        args.localhost_forward_start_port,
        args.localhost_forward_end_port,
    )
    stderr_log = tempfile.TemporaryFile()
    process = None
    command_display = f"localhost forward on 127.0.0.1:{local_port}"
    try:
        # No SSH config is reserialized: OpenSSH itself evaluates Includes,
        # Match, quoting, identities and proxies in the original config context.
        with tempfile.TemporaryDirectory(prefix="tmux-opener-") as control_dir:
            control_path = str(Path(control_dir) / "control")
            master, forward_command = localhost_forward_commands(
                ssh_host, remote_host, remote_port, local_port, control_path, args.ssh_config
            )
            if args.dry_run:
                log_line(f"dry-run tunnel master: {command_text(master)}")
                log_line(f"dry-run tunnel forward: {command_text(forward_command)}")
                stderr_log.close()
                return local_port
            if args.verbose:
                command_display = command_text(master)
                log_line(f"launch tunnel forward: {command_text(forward_command)}")
            log_line(f"launch tunnel: {command_display}")
            process = subprocess.Popen(
                master,
                stdout=subprocess.DEVNULL,
                stderr=stderr_log,
                stdin=subprocess.DEVNULL,
            )
            deadline = time.monotonic() + LOCALHOST_FORWARD_STARTUP_TIMEOUT
            while not Path(control_path).exists():
                returncode = process.poll()
                if returncode is not None:
                    raise RequestError(f"localhost SSH master exited rc={returncode}")
                if time.monotonic() >= deadline:
                    raise RequestError("localhost SSH master startup timed out")
                time.sleep(0.05)
            result = subprocess.run(
                forward_command,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=stderr_log,
                timeout=LOCALHOST_FORWARD_STARTUP_TIMEOUT,
                check=False,
            )
            if result.returncode:
                raise RequestError(f"localhost SSH forwarding failed rc={result.returncode}")
            ready, returncode = wait_for_localhost_forward_start(process, local_port)
            if not ready or returncode is not None:
                raise RequestError(f"localhost forward did not listen on 127.0.0.1:{local_port}")
        # The control operation is complete. Unlinking its private socket closes
        # access to this master, not its TCP forward; the client owns its process.
        REMOTE_LOCALHOST_FORWARDS[key] = LocalhostForward(
            ssh_host=ssh_host,
            remote_host=remote_host,
            remote_port=remote_port,
            local_port=local_port,
            process=process,
        )
        threading.Thread(
            target=watch_localhost_forward,
            args=(key, process, command_display, stderr_log, args.verbose),
            daemon=True,
        ).start()
    except BaseException as exc:
        REMOTE_LOCALHOST_FORWARDS.pop(key, None)
        try:
            if process is not None:
                terminate_process(process)
            if args.verbose:
                log_line(f"tunnel startup failed: {command_display}{stderr_suffix(stderr_log)}")
        finally:
            stderr_log.close()
        if isinstance(exc, subprocess.TimeoutExpired):
            raise RequestError("localhost SSH forwarding timed out") from exc
        if isinstance(exc, OSError):
            raise RequestError("failed to start localhost SSH forwarding") from exc
        raise
    return local_port


def local_remote_url(scheme: str, local_port: int, path: str, query: str, fragment: str) -> str:
    return urllib.parse.urlunparse((scheme, f"127.0.0.1:{local_port}", path, "", query, fragment))


def open_remote_localhost(
    request: dict[str, object],
    allowed_hosts: set[str] | None,
    args: argparse.Namespace,
) -> None:
    host = validate_host(request.get("ssh_host"), allowed_hosts)
    scheme = validate_remote_localhost_scheme(request.get("scheme"))
    remote_host = validate_remote_localhost_host(request.get("remote_host"))
    remote_port = validate_port(request.get("remote_port"), "remote_port")
    path = validate_url_part(request.get("path"), "path", prefix="/")
    query = validate_url_part(request.get("query"), "query")
    fragment = validate_url_part(request.get("fragment"), "fragment")

    local_port = ensure_remote_localhost_forward(host, remote_host, remote_port, args)
    open_with_system(local_remote_url(scheme, local_port, path, query, fragment), args.dry_run, args.verbose)


def downloads_directory() -> Path:
    if platform.system() == "Linux" and shutil.which("xdg-user-dir"):
        result = subprocess.run(["xdg-user-dir", "DOWNLOAD"], capture_output=True, text=True, check=False)
        path = result.stdout.strip()
        if result.returncode == 0 and path and Path(path).is_absolute():
            return Path(path)
    return Path.home() / "Downloads"


def choose_download_path(default: Path, cancel: threading.Event | None = None) -> Path | None:
    system = platform.system()
    if system == "Darwin":
        command = [
            "osascript", "-e",
            'on run argv\nset destination to choose file name with prompt "Save remote file" '
            'default name (item 1 of argv) default location (POSIX file (item 2 of argv))\n'
            'return POSIX path of destination\nend run',
            default.name, str(default.parent),
        ]
    elif shutil.which("zenity"):
        command = ["zenity", "--file-selection", "--save", "--title=Save remote file", f"--filename={default}"]
    elif shutil.which("kdialog"):
        command = ["kdialog", "--getsavefilename", str(default), "--title", "Save remote file"]
    else:
        # Run Tk in its own process: GUI toolkits must own their main thread.
        command = [sys.executable, "-c",
                   "import sys, tkinter as tk; from tkinter import filedialog; "
                   "from pathlib import Path; p=Path(sys.argv[1]); root=tk.Tk(); root.withdraw(); "
                   "print(filedialog.asksaveasfilename(title='Save remote file', "
                   "initialdir=str(p.parent), initialfile=p.name)); root.destroy()", str(default)]
    result = run_dialog(command, cancel, "save")
    if result is None:
        return None
    path = result.stdout.strip()
    if not path:
        return None
    destination = Path(path)
    if not destination.is_absolute():
        raise RequestError("save dialog returned a relative path")
    return destination


def ask_download_path(default: Path, cancel: threading.Event | None) -> Path | None:
    while not SAVE_DIALOG_LOCK.acquire(timeout=0.2):
        if cancel is not None and cancel.is_set():
            return None
    try:
        destination = choose_download_path(default, cancel) if cancel is not None else choose_download_path(default)
    finally:
        SAVE_DIALOG_LOCK.release()
    if destination is not None and destination.exists():
        raise RequestError(f"destination already exists; choose a new filename: {destination}")
    return destination


def run_dialog(command: list[str], cancel: threading.Event | None, name: str) -> subprocess.CompletedProcess | None:
    """Run a file dialog; None means the user or a cancelled transfer closed it."""

    if cancel is None:
        result = subprocess.run(command, capture_output=True, text=True, check=False)
    else:
        with subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True) as process:
            while True:
                if cancel.is_set():
                    terminate_process(process)
                    return None
                try:
                    output, errors = process.communicate(timeout=0.2)
                    break
                except subprocess.TimeoutExpired:
                    continue
            result = subprocess.CompletedProcess(command, process.returncode, output, errors)
    if result.returncode:
        if result.returncode == 1 and command[0] in ("zenity", "kdialog"):
            return None
        if command[0] == "osascript" and "(-128)" in result.stderr:
            return None
        raise RequestError(f"{name} dialog failed; install zenity, kdialog or Tk on the client: {result.stderr.strip()}")
    return result


def choose_upload_files(prompt: str, cancel: threading.Event | None = None) -> list[Path] | None:
    if platform.system() == "Darwin":
        command = [
            "osascript", "-e",
            'on run argv\nset picked to choose file with prompt (item 1 of argv) with multiple selections allowed\n'
            'set output to ""\nrepeat with chosen in picked\nset output to output & POSIX path of chosen & linefeed\n'
            'end repeat\nreturn output\nend run',
            prompt,
        ]
    elif shutil.which("zenity"):
        command = ["zenity", "--file-selection", "--multiple", "--separator=\n", f"--title={prompt}"]
    elif shutil.which("kdialog"):
        command = ["kdialog", "--getopenfilename", str(Path.home()), "--multiple", "--separate-output",
                   "--title", prompt]
    else:
        command = [sys.executable, "-c",
                   "import sys, tkinter as tk; from tkinter import filedialog; root=tk.Tk(); root.withdraw(); "
                   "print('\\n'.join(filedialog.askopenfilenames(title=sys.argv[1]))); root.destroy()", prompt]
    result = run_dialog(command, cancel, "file")
    if result is None:
        return None
    files = list(dict.fromkeys(Path(line) for line in result.stdout.splitlines() if line))
    if not all(path.is_absolute() for path in files):
        raise RequestError("file dialog returned a relative path")
    return files or None


def ask_upload_files(prompt: str, cancel: threading.Event) -> list[Path] | None:
    while not SAVE_DIALOG_LOCK.acquire(timeout=0.2):
        if cancel.is_set():
            return None
    try:
        return choose_upload_files(prompt, cancel)
    finally:
        SAVE_DIALOG_LOCK.release()


def download_notification(message: str) -> None:
    failed = message.startswith(("Download failed", "Upload failed"))
    transfer = "upload" if message.startswith("Upload") else "download"
    log_line(f"{transfer} failed; enable --verbose for details" if failed else f"{transfer} completed")
    policy = opener_settings.load()[0]["download_notifications"]
    if policy == "off" or (policy == "failures" and not failed):
        return
    if platform.system() == "Darwin":
        # Pass text as arguments so remote paths are never parsed as AppleScript.
        command = ["osascript", "-e", "on run argv\ndisplay notification (item 2 of argv) with title (item 1 of argv)\nend run",
                   "tmux-opener", message]
    elif shutil.which("notify-send"):
        command = ["notify-send", "--", "tmux-opener", message]
    else:
        return
    try:
        subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass


def cache_directory(kind: str) -> Path:
    return Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "tmux-opener" / kind


def cache_key(host: str, path: str) -> str:
    return hashlib.sha256(json.dumps([host, path]).encode("utf-8")).hexdigest()


def preview_directory(host: str, path: str) -> Path:
    return cache_directory("preview") / cache_key(host, path)[:24]


def clean_partials() -> None:
    """Drop partial downloads that nobody resumed within PARTIAL_MAX_AGE."""

    cutoff = time.time() - PARTIAL_MAX_AGE
    for data in cache_directory("partial").glob("*.part"):
        try:
            if data.lstat().st_mtime < cutoff:
                data.unlink()
                data.with_suffix(".id").unlink(missing_ok=True)
        except OSError:
            pass


def receive_partial(
    host: str, path: str, ssh: str, ssh_config: str | None, partial: BinaryIO, identity_path: Path,
    verbose: bool, progress, cancel: threading.Event,
) -> int | None:
    """Fill the partial copy, resuming when the remote file is unchanged.

    Returns the remote size once every byte arrived, or None if cancelled.
    """

    offset = os.fstat(partial.fileno()).st_size
    try:
        expected = identity_path.read_text(encoding="ascii") if offset else ""
    except (OSError, UnicodeError):
        expected = ""
    command = resume_command(host, path, offset, expected, ssh, ssh_config)
    header = b""
    size = None
    received = 0
    with tempfile.TemporaryFile() as errors:
        process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=errors, stdin=subprocess.DEVNULL)
        try:
            with selectors.DefaultSelector() as selector:
                selector.register(process.stdout, selectors.EVENT_READ)
                eof = False
                while not eof or process.poll() is None:
                    if cancel.is_set():
                        terminate_process(process)
                        return None
                    for _key, _events in selector.select(timeout=0.2):
                        chunk = os.read(process.stdout.fileno(), 256 * 1024)
                        if not chunk:
                            eof = True
                            selector.unregister(process.stdout)
                            break
                        if size is None:
                            # The script's first line is the remote "size mtime" identity.
                            header += chunk
                            if b"\n" not in header:
                                if len(header) > 64:
                                    raise RequestError("remote file identity is invalid")
                                continue
                            line, chunk = header.split(b"\n", 1)
                            identity = line.decode("ascii", errors="replace")
                            if not re.fullmatch(r"\d{1,20} \d{1,20}", identity):
                                raise RequestError("remote file identity is invalid")
                            size = int(identity.split()[0])
                            if identity == expected:
                                received = offset
                            else:
                                # First attempt, or the remote file changed: the script sent it all.
                                partial.truncate(0)
                                identity_path.write_text(identity, encoding="ascii")
                            partial.seek(received)
                            progress(bytes_received=received, size_bytes=size, resumed_from=received or None)
                        if chunk:
                            partial.write(chunk)
                            received += len(chunk)
                            progress(bytes_received=received)
            if process.returncode:
                detail = stderr_suffix(errors) if verbose else ""
                error = ConnectionDropped if process.returncode == 255 else RequestError
                raise error(f"SSH exited {process.returncode}{detail}")
        finally:
            partial.flush()
            if process.poll() is None:
                terminate_process(process)
            process.stdout.close()
    if size is None:
        raise RequestError("remote file identity is missing")
    if received != size:
        if received > size:
            partial.truncate(0)
        raise ConnectionDropped(f"received {received} of {size} bytes")
    return size


def download_file(
    host: str, path: str, ask_destination: bool, ssh: str,
    ssh_config: str | None = None, verbose: bool = False,
    progress=None, cancel: threading.Event | None = None, preview: bool = False,
) -> dict[str, object]:
    temporary: Path | None = None
    partial: BinaryIO | None = None
    cancel = cancel or threading.Event()
    progress = progress or (lambda **_fields: None)

    def received() -> int:
        return os.fstat(partial.fileno()).st_size if partial is not None else 0

    try:
        if cancel.is_set():
            return {"state": "cancelled"}
        directory = preview_directory(host, path) if preview else downloads_directory()
        directory.mkdir(mode=0o700 if preview else 0o777, parents=True, exist_ok=True)
        destination = directory / Path(path).name
        if ask_destination:
            destination = ask_download_path(destination, cancel)
            if destination is None:
                log_line(f"download cancelled: {host}:{path}" if verbose else "download cancelled")
                return {"state": "cancelled"}

        # Partial copies live in a private cache keyed by host and path, so failed,
        # cancelled, interrupted and retried transfers continue where they stopped.
        data_path = cache_directory("partial") / f"{cache_key(host, path)[:32]}.part"
        identity_path = data_path.with_suffix(".id")
        data_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        partial = os.fdopen(os.open(data_path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600), "r+b")
        try:
            fcntl.flock(partial.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            if os.fstat(partial.fileno()).st_ino != data_path.stat().st_ino:
                raise BlockingIOError
        except (BlockingIOError, FileNotFoundError):
            raise RequestError("this file is already being downloaded") from None

        log_line(f"download started: {host}:{path} -> {destination}" if verbose else "download started")
        progress(state="downloading", destination=str(destination))
        for delay in (*RESUME_DELAYS, None):
            try:
                size = receive_partial(host, path, ssh, ssh_config, partial, identity_path, verbose, progress, cancel)
                break
            except ConnectionDropped as exc:
                if delay is None:
                    raise
                if verbose:
                    log_line(f"download interrupted, resuming in {delay}s: {exc}")
                if cancel.wait(delay):
                    size = None
                    break
        if size is None:
            return {"state": "cancelled", "bytes_received": received()}

        source = data_path
        if data_path.stat().st_dev != destination.parent.stat().st_dev:
            with tempfile.NamedTemporaryFile(prefix=".tmux-opener-", suffix=".part",
                                             dir=destination.parent, delete=False) as copy:
                temporary = Path(copy.name)
                partial.seek(0)
                shutil.copyfileobj(partial, copy)
            source = temporary
        original = destination
        index = 0
        while True:
            if cancel.is_set():
                return {"state": "cancelled", "bytes_received": size}
            try:
                if preview:
                    # A preview copy is a cache entry: refresh it in place.
                    os.replace(source, destination)
                    break
                # Atomic publication without overwriting a file created by another download.
                os.link(source, destination)
                break
            except FileExistsError:
                if ask_destination:
                    raise RequestError(f"destination already exists: {destination}")
                index += 1
                destination = original.with_name(f"{original.stem} ({index}){original.suffix}")
        data_path.unlink(missing_ok=True)
        identity_path.unlink(missing_ok=True)
        message = f"Downloaded {host}:{path} to {destination}"
        if verbose:
            log_line(message)
        if not preview:
            download_notification(message)
        return {"state": "completed", "destination": str(destination), "bytes_received": size, "error": None}
    except (OSError, RequestError) as exc:
        message = f"Download failed for {host}:{path}: {exc}"
        if verbose:
            log_line(message)
        download_notification(message)
        return {"state": "failed", "bytes_received": received(), "error": str(exc)[:2000]}
    finally:
        if partial is not None:
            partial.close()
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def send_upload(
    host: str, directory: str, source: BinaryIO, name: str, size: int, ssh: str, ssh_config: str | None,
    verbose: bool, sent, cancel: threading.Event,
) -> str | None:
    """Stream one file into the remote folder; returns its published name, or None if cancelled."""

    arguments = " ".join(shlex.quote(value) for value in (directory, name, str(size), uuid.uuid4().hex[:16]))
    command = ssh_command(host, f"sh -c {shlex.quote(UPLOAD_SCRIPT)} sh {arguments}", ssh, ssh_config)
    with tempfile.TemporaryFile() as errors:
        process = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=errors)
        try:
            os.set_blocking(process.stdin.fileno(), False)
            written = 0
            chunk = b""
            with selectors.DefaultSelector() as selector:
                selector.register(process.stdin, selectors.EVENT_WRITE)
                while written < size and process.poll() is None:
                    if cancel.is_set():
                        terminate_process(process)
                        return None
                    if not selector.select(timeout=0.2):
                        continue
                    if not chunk:
                        chunk = source.read(min(256 * 1024, size - written))
                        if not chunk:
                            raise RequestError(f"{name} changed while uploading")
                    try:
                        count = os.write(process.stdin.fileno(), chunk)
                    except BlockingIOError:
                        continue
                    except BrokenPipeError:
                        break  # The remote script stopped; its exit status says why.
                    chunk = chunk[count:]
                    written += count
                    sent(count)
            while True:
                if cancel.is_set():
                    terminate_process(process)
                    return None
                try:
                    output, _errors = process.communicate(timeout=0.2)
                    break
                except subprocess.TimeoutExpired:
                    continue
        finally:
            if process.poll() is None:
                terminate_process(process)
        if process.returncode:
            detail = stderr_suffix(errors) if verbose else ""
            reason = UPLOAD_ERRORS.get(process.returncode, f"SSH exited {process.returncode}")
            raise RequestError(f"{reason}{detail}")
    return output.decode("utf-8", "replace").rstrip("\n") or name


def upload_files(
    host: str, directory: str, files: list[str] | None, ssh: str, ssh_config: str | None = None,
    verbose: bool = False, progress=None, cancel: threading.Event | None = None,
) -> dict[str, object]:
    """Upload files picked on this desktop into a remote folder, never replacing remote files."""

    cancel = cancel or threading.Event()
    progress = progress or (lambda **_fields: None)
    sent = 0

    def count(amount: int) -> None:
        nonlocal sent
        sent += amount
        progress(bytes_received=sent)

    try:
        if files is None:
            chosen = ask_upload_files(f"Upload to {host}:{directory}", cancel)
            if chosen is None:
                log_line(f"upload cancelled: {host}:{directory}" if verbose else "upload cancelled")
                return {"state": "cancelled"}
            files = [str(path) for path in chosen]
            # A retry sends the same files without asking again.
            progress(files=files, file_count=len(files), ask_destination=False)
        sizes = []
        for path in files:
            try:
                info = os.stat(path)
            except OSError as exc:
                raise RequestError(f"cannot read {Path(path).name}: {exc.strerror}") from None
            if not stat.S_ISREG(info.st_mode):
                raise RequestError(f"only regular files can be uploaded: {Path(path).name}")
            sizes.append(info.st_size)
        total = sum(sizes)
        log_line(f"upload started: {host}:{directory}" if verbose else "upload started")
        progress(state="uploading", size_bytes=total, bytes_received=0)
        names = []
        for index, (path, size) in enumerate(zip(files, sizes)):
            name = Path(path).name
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            except OSError as exc:
                raise RequestError(f"cannot read {name}: {exc.strerror}") from None
            with os.fdopen(fd, "rb") as source:
                if not stat.S_ISREG(os.fstat(fd).st_mode):
                    raise RequestError(f"only regular files can be uploaded: {name}")
                os.set_blocking(fd, True)
                published = send_upload(host, directory, source, name, size, ssh, ssh_config, verbose, count, cancel)
            if published is None:
                return {"state": "cancelled", "bytes_received": sent}
            names.append(published)
            # Failed uploads retry only the files that did not arrive.
            progress(files=files[index + 1:])
        label = names[0] if len(names) == 1 else f"{len(names)} files"
        message = f"Uploaded {label} to {host}:{directory}"
        if verbose:
            log_line(message)
        download_notification(message)
        destination = str(PurePosixPath(directory) / names[0]) if len(names) == 1 else directory
        return {"state": "completed", "destination": destination, "bytes_received": total, "error": None}
    except (OSError, RequestError) as exc:
        message = f"Upload failed for {host}:{directory}: {exc}"
        if verbose:
            log_line(message)
        download_notification(message)
        return {"state": "failed", "bytes_received": sent, "error": str(exc)[:2000]}


class TransferCancelled(Exception):
    pass


def validate_folder_files(files: object) -> list[str] | None:
    """Return glob matches as safe paths relative to the requested folder."""

    if files is None:
        return None
    if not isinstance(files, list) or not 1 <= len(files) <= MAX_FOLDER_FILES:
        raise RequestError(f"files must list 1 to {MAX_FOLDER_FILES} relative paths")
    for name in files:
        if (not isinstance(name, str) or not name or len(name) > 4096 or name.startswith("/")
                or any(character in name for character in "\x00\r\n") or ".." in PurePosixPath(name).parts):
            raise RequestError("files must be relative paths inside the folder")
    return list(dict.fromkeys(files))


def local_rsync() -> str | None:
    # --protect-args needs rsync 3; macOS ships rsync 2.6.9 or openrsync.
    rsync = shutil.which("rsync")
    if rsync is None:
        return None
    try:
        version = subprocess.run([rsync, "--version"], capture_output=True, text=True, check=False, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    match = re.search(r"rsync\s+version\s+v?(\d+)", version)
    return rsync if match and int(match.group(1)) >= 3 else None


def tree_size(root: Path) -> int:
    total = 0
    for directory, _directories, names in os.walk(root):
        for name in names:
            try:
                info = os.lstat(os.path.join(directory, name))
            except OSError:
                continue
            if stat.S_ISREG(info.st_mode):
                total += info.st_size
    return total


def stop_on_cancel(process: subprocess.Popen[bytes], cancel: threading.Event) -> None:
    def watch() -> None:
        while process.poll() is None:
            if cancel.wait(0.2):
                terminate_process(process)
                return

    threading.Thread(target=watch, name="transfer-cancel", daemon=True).start()


def rsync_folder(rsync: str, host: str, path: str, files: list[str] | None, partial: Path,
                 ssh_command: list[str], cancel: threading.Event, progress) -> bool:
    """Copy with rsync; return False when the remote host has no rsync."""

    command = [rsync, "-rltE", "--safe-links", "--partial", "--protect-args", "-e", command_text(ssh_command)]
    if files:
        command += ["--files-from=-", "--from0"]
    command += ["--", f"{host}:{path.rstrip('/')}/", f"{partial}/"]
    with tempfile.TemporaryFile() as names, tempfile.TemporaryFile() as errors:
        names.write(b"".join(name.encode("utf-8") + b"\0" for name in files or ()))
        names.seek(0)
        process = subprocess.Popen(command, stdin=names, stdout=subprocess.DEVNULL, stderr=errors)
        stop_on_cancel(process, cancel)
        while True:
            try:
                process.wait(timeout=0.5)
                break
            except subprocess.TimeoutExpired:
                if progress is not None:
                    progress(bytes_received=tree_size(partial))
        if cancel.is_set():
            raise TransferCancelled
        detail = process_stderr(errors)
    if process.returncode in (12, 127) and "not found" in detail:
        return False
    if process.returncode:
        raise RequestError(f"rsync exited {process.returncode}: {detail}" if detail else f"rsync exited {process.returncode}")
    return True


def tar_folder(host: str, path: str, files: list[str] | None, partial: Path,
               ssh_command: list[str], cancel: threading.Event, progress, verbose: bool) -> None:
    if not hasattr(tarfile, "data_filter"):
        raise RequestError("folder downloads need rsync 3 or Python with tarfile filters on the client")
    remote = f"tar -cf - -C {shlex.quote(path)} " + ("--null -T -" if files else ".")
    with tempfile.TemporaryFile() as names, tempfile.TemporaryFile() as errors:
        # "./" keeps names that start with "-" from reading as tar options.
        names.write(b"".join(b"./" + name.encode("utf-8") + b"\0" for name in files or ()))
        names.seek(0)
        process = subprocess.Popen(ssh_command + ["--", host, remote], stdin=names,
                                   stdout=subprocess.PIPE, stderr=errors)
        stop_on_cancel(process, cancel)
        received = 0
        try:
            with tarfile.open(fileobj=process.stdout, mode="r|") as archive:
                for member in archive:
                    try:
                        archive.extract(member, partial, filter="data")
                    except (tarfile.AbsoluteLinkError, tarfile.LinkOutsideDestinationError, tarfile.SpecialFileError):
                        # Like rsync --safe-links: skip links leaving the folder, and device files.
                        if verbose:
                            log_line(f"skipped unsafe folder entry: {member.name}")
                        continue
                    except tarfile.FilterError as exc:
                        raise RequestError(f"remote archive has an unsafe entry: {exc}") from exc
                    if member.isfile():
                        received += member.size
                        if progress is not None:
                            progress(bytes_received=received)
            while process.stdout.read(256 * 1024):
                pass
        except (tarfile.TarError, OSError) as exc:
            # Closing the pipe stops a sender that is still writing.
            process.stdout.close()
            process.wait()
            if cancel.is_set():
                raise TransferCancelled from exc
            detail = process_stderr(errors) or str(exc)
            raise RequestError(f"SSH tar exited {process.returncode}: {detail}") from exc
        except BaseException:
            terminate_process(process)
            raise
        finally:
            process.stdout.close()
        process.wait()
        if cancel.is_set():
            raise TransferCancelled
        if process.returncode:
            raise RequestError(f"SSH tar exited {process.returncode}: {process_stderr(errors)}")


def download_folder(
    host: str, path: str, files: list[str] | None, ask_destination: bool, ssh: str,
    ssh_config: str | None = None, verbose: bool = False,
    progress=None, cancel: threading.Event | None = None,
) -> dict[str, object]:
    """Copy a remote folder, or glob matches below it, into a new local folder.

    Data lands in a hidden partial folder beside the destination and is renamed
    into place when complete. rsync partials survive failures so a retry
    resumes; cancellation removes them.
    """

    cancel = cancel or threading.Event()
    partial: Path | None = None
    keep_partial = False
    try:
        if cancel.is_set():
            return {"state": "cancelled"}
        directory = downloads_directory()
        directory.mkdir(parents=True, exist_ok=True)
        destination = directory / Path(path).name
        if ask_destination:
            destination = ask_download_path(destination, cancel)
            if destination is None:
                log_line(f"download cancelled: {host}:{path}" if verbose else "download cancelled")
                return {"state": "cancelled"}
        digest = hashlib.sha256(json.dumps([host, path, files]).encode("utf-8")).hexdigest()[:24]
        candidate = destination.parent.resolve() / f".tmux-opener-{digest}.partial"
        with ACTIVE_FOLDERS_LOCK:
            if candidate in ACTIVE_FOLDERS:
                raise RequestError("this folder is already downloading")
            ACTIVE_FOLDERS.add(candidate)
        partial = candidate
        partial.mkdir(mode=0o700, exist_ok=True)

        log_line(f"download started: {host}:{path} -> {destination}" if verbose else "download started")
        if progress is not None:
            progress(state="downloading", destination=str(destination))
        ssh_command = ssh_transfer_command(ssh, ssh_config)
        # rsync reads "host:path" and expands wildcards in remote paths even with --protect-args.
        usable = ":" not in host and not host.startswith("-") and not any(character in path for character in "*?[\\")
        rsync = local_rsync() if usable else None
        keep_partial = rsync is not None
        if rsync is None or not rsync_folder(rsync, host, path, files, partial, ssh_command, cancel, progress):
            keep_partial = False
            tar_folder(host, path, files, partial, ssh_command, cancel, progress, verbose)
        received = tree_size(partial)

        os.chmod(partial, 0o777 & ~UMASK)
        original = destination
        index = 0
        while True:
            if cancel.is_set():
                raise TransferCancelled
            if not os.path.lexists(destination):
                try:
                    # rename() may replace an empty directory created meanwhile, never data.
                    os.rename(partial, destination)
                    break
                except OSError as exc:
                    if exc.errno not in (errno.EEXIST, errno.ENOTEMPTY, errno.ENOTDIR):
                        raise
            if ask_destination:
                raise RequestError(f"destination already exists: {destination}")
            index += 1
            destination = original.with_name(f"{original.name} ({index})")
        message = f"Downloaded {host}:{path} to {destination}"
        if verbose:
            log_line(message)
        download_notification(message)
        return {"state": "completed", "destination": str(destination), "bytes_received": received, "error": None}
    except TransferCancelled:
        keep_partial = False
        return {"state": "cancelled"}
    except (OSError, RequestError) as exc:
        message = f"Download failed for {host}:{path}: {exc}"
        if verbose:
            log_line(message)
        download_notification(message)
        return {"state": "failed", "error": str(exc)[:2000]}
    finally:
        if partial is not None:
            if not keep_partial:
                shutil.rmtree(partial, ignore_errors=True)
            with ACTIVE_FOLDERS_LOCK:
                ACTIVE_FOLDERS.discard(partial)


def queue_download(host: str, path: str, args: argparse.Namespace, ask_destination: bool = False,
                   size_bytes: object = None, preview: bool = False, kind: str = "file",
                   files: object = None, file_count: object = None) -> dict[str, object] | None:
    if len(path) > 4096 or Path(path).name in ("", ".", "..") or any(character in path for character in "\r\n"):
        raise RequestError(f"download path must name a {kind} and contain no newlines")
    files = validate_folder_files(files) if kind == "folder" else None
    if file_count is not None and (kind != "folder" or type(file_count) is not int or not 0 <= file_count <= 2**31):
        raise RequestError("file_count must be a non-negative integer")
    if preview and Path(path).suffix.lower() not in opener_settings.PREVIEW_SUFFIXES:
        raise RequestError(f"local preview is not allowed for {Path(path).suffix or 'extensionless'} files")
    if size_bytes is not None and (type(size_bytes) is not int or not 0 <= size_bytes <= 2**63 - 1):
        raise RequestError("size_bytes must be a non-negative integer")
    if not shutil.which("ssh"):
        raise RequestError("ssh is not installed on the client")
    if args.dry_run:
        destination = "local preview" if preview else "client save dialog" if ask_destination else downloads_directory()
        log_line(f"dry-run download: {host}:{path} -> {destination}" if args.verbose else "dry-run download")
        return None
    try:
        folder = {"kind": "folder", "files": files, "file_count": file_count} if kind == "folder" else {}
        job = args.download_queue.submit(host, path, ask_destination, size_bytes, preview, **folder)
    except (ValueError, OSError) as exc:
        raise RequestError("download queue could not accept this transfer") from exc
    return {"download_id": job["id"], "state": "queued"}


def queue_upload(host: str, directory: str, args: argparse.Namespace) -> dict[str, object] | None:
    # The remote names only the folder; the user picks the files in a client dialog.
    if len(directory) > 4096 or any(character in directory for character in "\r\n"):
        raise RequestError("upload folder must contain no newlines")
    if not shutil.which("ssh"):
        raise RequestError("ssh is not installed on the client")
    if args.dry_run:
        log_line(f"dry-run upload: client file dialog -> {host}:{directory}" if args.verbose else "dry-run upload")
        return None
    try:
        job = args.download_queue.submit(host, directory, True, kind="upload")
    except (ValueError, OSError) as exc:
        raise RequestError("download queue could not accept this transfer") from exc
    return {"download_id": job["id"], "state": "queued"}


def observe_host(request: dict[str, object], args: argparse.Namespace) -> None:
    global LAST_REQUEST_AT
    LAST_REQUEST_AT = datetime.now(timezone.utc).isoformat(timespec="seconds")
    info = request.get("host_info")
    if not isinstance(info, dict):
        return
    host = request.get("ssh_host") or args.default_ssh_host
    if not isinstance(host, str) or host not in args.allow_ssh_host and not args.allow_any_ssh_host:
        return
    metadata = {key: value[:1024] for key, value in info.items()
                if key in {"hostname", "user", "os", "cwd", "pane"} and isinstance(value, str)}
    HOST_ACTIVITY[host] = {"ssh_host": host, **metadata, "last_seen": LAST_REQUEST_AT}


def status_response(request: dict[str, object], args: argparse.Namespace) -> dict[str, object]:
    host = request.get("ssh_host")
    if host is not None:
        host = validate_host(host, None if args.allow_any_ssh_host else set(args.allow_ssh_host))
    downloads = args.download_queue.snapshot(host)
    allowed = None if args.allow_any_ssh_host else set(args.allow_ssh_host)
    # Glob file lists stay in the history; status replies must stay small.
    downloads = [{key: value for key, value in job.items() if key != "files"} for job in downloads
                 if allowed is None or job["ssh_host"] in allowed]
    return {
        "client_info": {"hostname": platform.node(), "user": getpass.getuser(), "os": platform.system(),
                        "pid": os.getpid(), "instance_id": INSTANCE_ID, "default_ssh_host": args.default_ssh_host,
                        "started_at": STARTED_AT, "last_request_at": LAST_REQUEST_AT},
        "hosts": [dict(value) for key, value in HOST_ACTIVITY.items()
                  if (host is None or key == host) and (allowed is None or key in allowed)],
        "downloads": downloads,
        "history_error": args.download_queue.storage_error,
        "can_restart": not getattr(args, "once", False) and not args.dry_run,
        "remote_localhost_forwards": active_remote_localhost_forwards(),
    }


def dispatch(request: dict[str, object], args: argparse.Namespace) -> dict[str, object] | None:
    action = request.get("action")
    if args.verbose:
        log_line(f"request: {json.dumps(request, sort_keys=True)}")

    if action == "ping":
        return

    observe_host(request, args)
    if action == "get_status":
        return status_response(request, args)
    if action == "restart_client":
        if getattr(args, "once", False) or args.dry_run:
            raise RequestError("this client cannot restart in once or dry-run mode")
        if request.get("instance_id") != INSTANCE_ID:
            raise RequestError("client instance changed; refresh before restarting")
        log_line("client restart requested")
        return {"restart_accepted": True}
    if action == "get_settings":
        settings, error = opener_settings.load()
        return {"settings": settings, "error": error, "path": str(opener_settings.settings_path()),
                "available_pdf_viewers": opener_settings.available_pdf_viewers(),
                "preview_suffixes": sorted(opener_settings.PREVIEW_SUFFIXES)}
    if action == "set_settings":
        try:
            settings = opener_settings.save(request.get("settings"))
        except ValueError as exc:
            raise RequestError(str(exc)) from exc
        except OSError as exc:
            raise RequestError("settings could not be saved") from exc
        log_line("settings updated")
        return {"settings": settings}
    if action in {"cancel_download", "retry_download"}:
        identifier = request.get("download_id")
        if not isinstance(identifier, str) or not re.fullmatch(r"[a-f0-9]{32}", identifier):
            raise RequestError("download_id must be a valid download identifier")
        job = next((value for value in args.download_queue.snapshot() if value["id"] == identifier), None)
        if job is None:
            raise RequestError("download was not found")
        host = validate_host(job["ssh_host"], None if args.allow_any_ssh_host else set(args.allow_ssh_host))
        if request.get("ssh_host") is not None and request["ssh_host"] != host:
            raise RequestError("download was not found for this host")
        try:
            if action == "cancel_download":
                result = args.download_queue.cancel(identifier, host)
            else:
                result = args.download_queue.retry(identifier, host)
        except (ValueError, OSError) as exc:
            raise RequestError("download queue action failed") from exc
        return {"download_id": result["id"], "state": result["state"]}

    if action in ("open_url", "open_vscode_remote", "open_remote_localhost", "open_remote_pdf", "download_file",
                  "download_folder", "upload_files"):
        log_line(f"request action={action}")

    if action == "open_url":
        open_with_system(
            validate_url(request.get("url"), set(args.allow_url_scheme)),
            args.dry_run,
            args.verbose,
        )
        return

    if action == "open_vscode_remote":
        if "ssh_host" not in request and args.default_ssh_host:
            request = {**request, "ssh_host": args.default_ssh_host}
        if args.allow_any_ssh_host:
            allowed_hosts = None
        elif args.allow_ssh_host:
            allowed_hosts = set(args.allow_ssh_host)
        else:
            raise RequestError("no SSH hosts are allowed; pass --allow-ssh-host HOST")
        settings = opener_settings.load()[0]
        path = validate_path(request.get("path"))
        opener = "vscode"
        if validate_target_type(request.get("target_type")) == "file":
            opener = opener_settings.opener_for(settings, path)
        if opener == "tmux":
            # Senders that cannot show a popup omit "inline"; they keep VS Code.
            if request.get("inline") is True:
                log_line("rule opener=tmux")
                return {"opener": "tmux"}
            opener = "vscode"
        if opener != "vscode":
            log_line(f"rule opener={opener}")
            host = validate_host(request.get("ssh_host"), allowed_hosts)
            return queue_download(host, path, args, preview=opener == "preview")
        open_vscode_remote(
            request,
            allowed_hosts,
            args.dry_run,
            args.verbose,
            folder_window=args.vscode_folder_window or settings["vscode_folder_window"],
            file_window=args.vscode_file_window or settings["vscode_file_window"],
        )
        return

    if action in ("open_remote_localhost", "open_remote_pdf", "download_file", "download_folder", "upload_files"):
        if "ssh_host" not in request and args.default_ssh_host:
            request = {**request, "ssh_host": args.default_ssh_host}
        if args.allow_any_ssh_host:
            allowed_hosts = None
        elif args.allow_ssh_host:
            allowed_hosts = set(args.allow_ssh_host)
        else:
            raise RequestError("no SSH hosts are allowed; pass --allow-ssh-host HOST")
        if action == "open_remote_pdf":
            open_remote_pdf(request, allowed_hosts, args)
            return
        if action == "open_remote_localhost":
            open_remote_localhost(request, allowed_hosts, args)
            return
        host = validate_host(request.get("ssh_host"), allowed_hosts)
        path = validate_path(request.get("path"))
        if action == "upload_files":
            return queue_upload(host, path, args)
        ask_destination = request.get("ask_destination", False)
        if not isinstance(ask_destination, bool):
            raise RequestError("ask_destination must be a boolean")
        if action == "download_folder":
            return queue_download(host, path, args, ask_destination, request.get("size_bytes"), kind="folder",
                                  files=request.get("files"), file_count=request.get("file_count"))
        return queue_download(host, path, args, ask_destination, request.get("size_bytes"))

    raise RequestError("unsupported action")


@dataclass(slots=True)
class Peer:
    conn: socket.socket
    data: bytearray
    deadline: float
    response: bytes | None = None
    sent: int = 0
    restart: bool = False


def serve(server: socket.socket, args: argparse.Namespace, stop: threading.Event) -> None:
    # Only the main thread dispatches Open Requests. One I/O thread keeps health
    # and frame deadlines independent of slow desktop/tunnel startup.
    requests: queue.Queue[tuple[Peer, dict[str, object]]] = queue.Queue(maxsize=1)
    responses: queue.Queue[tuple[Peer, dict[str, object]]] = queue.Queue(maxsize=MAX_CONNECTIONS)
    finished = threading.Event()
    failures: list[BaseException] = []

    def network_loop() -> None:
        peers: dict[socket.socket, Peer] = {}
        with selectors.DefaultSelector() as selector:
            def close_peer(peer: Peer) -> None:
                try:
                    selector.unregister(peer.conn)
                except KeyError:
                    pass  # A queued request is not registered for socket events.
                peers.pop(peer.conn, None)
                peer.conn.close()
                if args.once:
                    finished.set()

            def respond(peer: Peer, response: dict[str, object]) -> None:
                peer.data.clear()
                peer.response = json.dumps(response, separators=(",", ":")).encode("utf-8") + b"\n"
                peer.restart = response.get("restart_accepted") is True and response.get("ok") is True
                peer.deadline = time.monotonic() + REQUEST_TIMEOUT
                try:
                    selector.modify(peer.conn, selectors.EVENT_WRITE, peer)
                except KeyError:
                    selector.register(peer.conn, selectors.EVENT_WRITE, peer)

            def reject(peer: Peer, reason: str) -> None:
                log_line(f"reject: {reason}")
                respond(peer, {"ok": False, "error": reason})

            try:
                server.setblocking(False)
                selector.register(server, selectors.EVENT_READ)
                while not stop.is_set() and not finished.is_set():
                    while True:
                        try:
                            peer, response = responses.get_nowait()
                        except queue.Empty:
                            break
                        respond(peer, response)
                    for peer in list(peers.values()):
                        if time.monotonic() >= peer.deadline:
                            if peer.response is None:
                                reject(peer, "request timed out")
                            else:
                                close_peer(peer)
                    for key, _events in selector.select(timeout=0.05):
                        if stop.is_set() or finished.is_set():
                            break
                        if key.fileobj is server:
                            try:
                                conn, _addr = server.accept()
                            except (BlockingIOError, ConnectionAbortedError):
                                continue
                            if len(peers) >= MAX_CONNECTIONS:
                                conn.close()
                                continue
                            conn.setblocking(False)
                            peer = Peer(conn, bytearray(), time.monotonic() + REQUEST_TIMEOUT)
                            peers[conn] = peer
                            selector.register(conn, selectors.EVENT_READ, peer)
                            if args.once:
                                selector.unregister(server)
                            continue
                        peer = key.data
                        if peer.conn not in peers:
                            continue
                        try:
                            if peer.response is not None:
                                count = peer.conn.send(memoryview(peer.response)[peer.sent:])
                                peer.sent += count
                                if peer.restart and peer.sent == len(peer.response):
                                    args.restart_requested = True
                                    stop.set()
                                if count == 0 or peer.sent == len(peer.response):
                                    close_peer(peer)
                                continue
                            if time.monotonic() >= peer.deadline:
                                reject(peer, "request timed out")
                                continue
                            chunk = peer.conn.recv(min(65536, MAX_REQUEST_BYTES + 1 - len(peer.data)))
                        except BlockingIOError:
                            continue
                        except OSError:
                            close_peer(peer)
                            continue
                        peer.data.extend(chunk)
                        if len(peer.data) > MAX_REQUEST_BYTES:
                            reject(peer, "request is too large")
                            continue
                        if chunk and b"\n" not in chunk:
                            continue
                        try:
                            request = parse_request(bytes(peer.data).split(b"\n", 1)[0])
                        except RequestError as exc:
                            reject(peer, str(exc))
                            continue
                        if request.get("action") == "ping":
                            respond(peer, ping_response(args))
                            continue
                        try:
                            requests.put_nowait((peer, request))
                        except queue.Full:
                            reject(peer, "client is busy")
                            continue
                        peer.data.clear()
                        peer.deadline = float("inf")
                        selector.unregister(peer.conn)
            finally:
                for peer in list(peers.values()):
                    close_peer(peer)

    def run_network() -> None:
        try:
            network_loop()
        except BaseException as exc:
            failures.append(exc)
        finally:
            finished.set()

    worker = threading.Thread(target=run_network, name="opener-io")
    worker.start()
    try:
        while not stop.is_set() and not finished.is_set():
            reap_children()
            try:
                peer, request = requests.get(timeout=0.05)
            except queue.Empty:
                continue
            if stop.is_set() or finished.is_set():
                break
            try:
                result = dispatch(request, args)
                response: dict[str, object] = {"ok": True, **(result or {})}
            except RequestError as exc:
                log_line(f"reject: {exc}")
                response = {"ok": False, "error": str(exc)}
            if not stop.is_set() and not finished.is_set():
                responses.put_nowait((peer, response))
    finally:
        stop.set()
        worker.join()
    if failures:
        raise failures[0]


class OwnedServer(socket.socket):
    """Keep ownership until cleanup, including after the listener is closed."""

    def __init__(self, path: Path, lock_fd: int) -> None:
        super().__init__(socket.AF_UNIX, socket.SOCK_STREAM)
        self.path = path
        self.lock_fd = lock_fd
        self.identity: tuple[int, int] | None = None

    def cleanup(self) -> None:
        self.close()
        try:
            current = self.path.lstat()
            if self.identity == (current.st_dev, current.st_ino) and stat.S_ISSOCK(current.st_mode):
                self.path.unlink()
        except FileNotFoundError:
            pass
        finally:
            if self.lock_fd >= 0:
                os.close(self.lock_fd)
                self.lock_fd = -1


def bind_server(socket_path: str) -> OwnedServer:
    path = Path(socket_path).expanduser()
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock_fd = os.open(str(path) + ".lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    server = OwnedServer(path, lock_fd)
    try:
        info = os.fstat(lock_fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
            raise RuntimeError("unsafe client ownership lock")
        os.fchmod(lock_fd, 0o600)
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        try:
            current = path.lstat()
        except FileNotFoundError:
            current = None
        if current is not None:
            if not stat.S_ISSOCK(current.st_mode) or current.st_uid != os.getuid():
                raise RuntimeError(f"refusing non-socket or foreign socket: {path}")
            # A legacy listener has no lifetime lock. Only ECONNREFUSED proves
            # its socket stale; a timeout or any other error is not evidence.
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
                probe.settimeout(0.2)
                try:
                    probe.connect(str(path))
                except OSError as exc:
                    if exc.errno != errno.ECONNREFUSED:
                        raise RuntimeError(f"cannot establish socket is stale: {path}") from exc
                else:
                    raise RuntimeError(f"client already listening: {path}")
            latest = path.lstat()
            if (latest.st_dev, latest.st_ino) != (current.st_dev, current.st_ino):
                raise RuntimeError(f"socket changed during startup: {path}")
            path.unlink()
        server.bind(str(path))
        current = path.lstat()
        server.identity = (current.st_dev, current.st_ino)
        os.chmod(path, 0o600)
        os.ftruncate(lock_fd, 0)
        os.write(lock_fd, str(os.getpid()).encode("ascii"))
        server.listen(16)
        return server
    except BaseException:
        server.cleanup()
        raise


def transfer_job(job: dict, update, cancel: threading.Event, args: argparse.Namespace) -> dict[str, object]:
    if job.get("kind") == "upload":
        return upload_files(job["ssh_host"], job["path"], None if job["ask_destination"] else job.get("files"),
                            shutil.which("ssh") or "ssh", args.ssh_config, args.verbose,
                            progress=update, cancel=cancel)
    if job.get("kind") == "folder":
        return download_folder(job["ssh_host"], job["path"], job.get("files"), job["ask_destination"],
                               shutil.which("ssh") or "ssh", args.ssh_config, args.verbose,
                               progress=update, cancel=cancel)
    preview = bool(job.get("preview"))
    result = download_file(
        job["ssh_host"], job["path"], job["ask_destination"], shutil.which("ssh") or "ssh",
        args.ssh_config, args.verbose, progress=update, cancel=cancel, preview=preview,
    )
    if preview and result["state"] == "completed":
        try:
            open_local_copy(Path(str(result["destination"])), args)
        except RequestError as exc:
            result.update(state="failed", error=f"Copied, but opening failed: {exc}")
    return result


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--socket", default=default_socket_path(), help="local Unix socket path")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--verbose", action="store_true", help="log sensitive request payloads and commands")
    parser.add_argument("--once", action="store_true", help="serve one request and exit")
    parser.add_argument("--allow-url-scheme", action="append", default=list(DEFAULT_URL_SCHEMES))
    parser.add_argument("--allow-ssh-host", action="append", default=[])
    parser.add_argument("--allow-any-ssh-host", action="store_true")
    parser.add_argument("--default-ssh-host")
    parser.add_argument("--ssh-config", help="SSH config used for auxiliary localhost connections")
    parser.add_argument("--pdf-viewer", choices=opener_settings.PDF_VIEWERS,
                        default=os.environ.get("TMUX_OPENER_PDF_VIEWER") or None,
                        help="local PDF viewer; overrides the settings file (also TMUX_OPENER_PDF_VIEWER)")
    parser.add_argument(
        "--vscode-folder-window",
        choices=opener_settings.WINDOW_POLICIES,
        help="VS Code window policy for remote folders; overrides the settings file",
    )
    parser.add_argument(
        "--vscode-file-window",
        choices=opener_settings.WINDOW_POLICIES,
        help="VS Code window policy for remote files; overrides the settings file",
    )
    parser.add_argument(
        "--localhost-forward-start-port",
        type=int,
        default=DEFAULT_LOCALHOST_FORWARD_START_PORT,
        help="first local port to use for remote localhost forwards (default: 18000)",
    )
    parser.add_argument(
        "--localhost-forward-end-port",
        type=int,
        default=DEFAULT_LOCALHOST_FORWARD_END_PORT,
        help="last local port to use for remote localhost forwards (default: 18999)",
    )
    args = parser.parse_args()

    server = bind_server(args.socket)
    stop = threading.Event()
    clean_partials()
    try:
        args.download_queue = DownloadQueue(
            Path(args.socket).expanduser().with_suffix(".downloads.json"),
            lambda job, update, cancel: transfer_job(job, update, cancel, args),
        )
    except (OSError, ValueError, KeyError, TypeError):
        server.cleanup()
        raise SystemExit("tmux-opener: cannot load download history; inspect the client state directory")

    def handle_signal(_signum: int, _frame: object) -> None:
        stop.set()

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    log_line(f"tmux-opener-client listening on {args.socket}")
    try:
        serve(server, args, stop)
    finally:
        args.download_queue.close()
        stop_remote_localhost_forwards()
        server.cleanup()

    if getattr(args, "restart_requested", False):
        # Re-exec the owned process after its response and normal cleanup.
        # The service manager keeps supervising the same process and all CLI
        # options (socket, allowlist, SSH config and viewer policies) survive.
        os.execv(sys.executable, [sys.executable, str(Path(__file__).resolve()), *sys.argv[1:]])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
