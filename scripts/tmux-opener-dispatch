#!/usr/bin/env python3
"""Open a tmux selection through the bridge when possible, otherwise locally."""

from __future__ import annotations

import argparse
import json
import os
import platform
import shutil
import subprocess
import sys

from tmux_opener_common import (
    bridge_available,
    build_request,
    clean_selection,
    default_log_path,
    default_socket_path,
    default_ssh_host,
    deliver_request,
    fallback_message,
    extract_target,
    is_open_url,
    log_line,
    resolve_path,
)


def default_fallback_mode() -> str:
    return os.environ.get("TMUX_OPENER_FALLBACK") or "auto"


def default_fallback_command() -> str | None:
    return os.environ.get("TMUX_OPENER_FALLBACK_COMMAND") or None


def default_bridge_policy() -> str:
    return os.environ.get("TMUX_OPENER_BRIDGE_POLICY") or "always"


def default_route_feedback() -> str:
    return os.environ.get("TMUX_OPENER_ROUTE_FEEDBACK") or "auto"


def tmux_message(message: str) -> None:
    if os.environ.get("TMUX"):
        subprocess.run(["tmux", "display-message", f"tmux-opener: {message}"], check=False)
    else:
        print(f"tmux-opener: {message}", file=sys.stderr)


def route_feedback(args: argparse.Namespace, message: str) -> None:
    mode = args.route_feedback
    if mode == "never":
        return
    if mode == "auto" and not os.environ.get("TMUX"):
        return
    tmux_message(message)


def bridge_allowed(policy: str) -> bool:
    if policy == "always":
        return True
    if policy == "local":
        return False
    if policy == "ssh-client-only":
        # Best-effort guard for mixed local/remote hosts. tmux server
        # environments can be stale, so this is intentionally opt-in.
        return bool(os.environ.get("SSH_CONNECTION") or os.environ.get("SSH_CLIENT"))
    raise ValueError(f"unsupported bridge policy: {policy}")


def system_open_command(target: str) -> list[str] | None:
    system = platform.system()
    if system == "Darwin":
        opener = shutil.which("open") or "open"
        return [opener, target]
    if system == "Windows":
        return ["cmd", "/c", "start", "", target]

    opener = shutil.which("xdg-open")
    if opener:
        return [opener, target]
    return None


def local_target(selection: str, cwd: str) -> str | None:
    target = extract_target(selection, cwd)
    if target is None:
        return None
    if is_open_url(target):
        return target

    resolved = resolve_path(target, cwd)
    if resolved is None:
        return None

    path, _target_type, _line, _column = resolved
    return path


def run_fallback_command(command: str, selection: str, cwd: str, log_path: str | None) -> int:
    env = os.environ.copy()
    env["TMUX_OPENER_CWD"] = cwd
    env["TMUX_SMART_OPEN_CWD"] = cwd

    log_line(log_path, "fallback command")
    process = subprocess.run(
        command,
        input=selection,
        text=True,
        shell=True,
        env=env,
        check=False,
    )
    if process.returncode:
        log_line(log_path, f"fallback command failed: rc={process.returncode}")
        tmux_message("fallback command failed")
    return process.returncode


def run_local_fallback(selection: str, cwd: str, log_path: str | None) -> int:
    target = local_target(selection, cwd)
    if target is None:
        log_line(log_path, "fallback rejected: no local opener target")
        tmux_message("no local opener target")
        return 1

    command = system_open_command(target)
    if command is None:
        log_line(log_path, "fallback rejected: no system opener found")
        tmux_message("no system opener found")
        return 1

    log_line(log_path, "fallback launch")
    try:
        subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as exc:
        log_line(log_path, f"fallback launch failed: {type(exc).__name__}")
        tmux_message(f"fallback launch failed: {exc}")
        return 1

    return 0


def run_fallback(args: argparse.Namespace, selection: str, log_path: str | None) -> int:
    mode = args.fallback
    if mode == "none":
        log_line(log_path, f"bridge unavailable; fallback disabled socket={args.socket}")
        tmux_message(f"bridge unavailable at {args.socket}")
        return 1

    if mode == "auto":
        mode = "command" if args.fallback_command else "local"

    if mode == "command":
        if not args.fallback_command:
            log_line(log_path, "fallback rejected: @tmux_opener_fallback_command is empty")
            tmux_message("@tmux_opener_fallback_command is empty")
            return 1
        returncode = run_fallback_command(args.fallback_command, selection, args.cwd, log_path)
        if returncode == 0:
            route_feedback(args, "opened via fallback command")
        return returncode

    if mode == "local":
        returncode = run_local_fallback(selection, args.cwd, log_path)
        if returncode == 0:
            route_feedback(args, "opened via same-host fallback")
        return returncode

    log_line(log_path, f"fallback rejected: unsupported fallback mode {mode}")
    tmux_message(f"unsupported fallback mode {mode}")
    return 1


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("selection", nargs="?", help="text to open; defaults to stdin")
    parser.add_argument("--socket", default=default_socket_path(), help="remote forwarded Unix socket path")
    parser.add_argument("--cwd", default=os.environ.get("TMUX_OPENER_CWD") or os.getcwd())
    parser.add_argument("--ssh-host", default=default_ssh_host())
    parser.add_argument("--timeout", type=float, default=5.0, help="request deadline in seconds")
    parser.add_argument("--fallback", choices=("auto", "local", "command", "none"), default=default_fallback_mode())
    parser.add_argument("--fallback-command", default=default_fallback_command())
    parser.add_argument(
        "--bridge-policy",
        choices=("always", "local", "ssh-client-only"),
        default=default_bridge_policy(),
        help="when to use the forwarded local opener bridge",
    )
    parser.add_argument(
        "--route-feedback",
        choices=("auto", "always", "never"),
        default=default_route_feedback(),
        help="show route feedback after opening",
    )
    parser.add_argument("--log", default=default_log_path(), help="remote sender log path")
    parser.add_argument("--no-log", action="store_true", help="disable remote sender logging")
    parser.add_argument("--print-request", action="store_true")
    args = parser.parse_args()
    log_path = None if args.no_log else args.log

    raw_selection = args.selection if args.selection is not None else sys.stdin.read()
    selection = clean_selection(raw_selection)

    if args.print_request:
        request = build_request(selection, args.cwd, args.ssh_host)
        if request is None:
            log_line(log_path, "reject: no opener target")
            return fallback_message(None, "no opener target", "auto")
        print(json.dumps(request, indent=2, sort_keys=True))
        return 0

    if not bridge_allowed(args.bridge_policy):
        log_line(log_path, f"bridge skipped: policy={args.bridge_policy}; using fallback={args.fallback}")
        return run_fallback(args, selection, log_path)

    if not bridge_available(args.socket, args.timeout):
        log_line(log_path, f"bridge unavailable: socket={args.socket}; using fallback={args.fallback}")
        return run_fallback(args, selection, log_path)

    request = build_request(selection, args.cwd, args.ssh_host)
    if request is None:
        log_line(log_path, "reject: no opener target")
        return fallback_message(None, "no opener target", "auto")

    returncode = deliver_request(args.socket, request, args.timeout, log_path, "auto")
    if returncode == 0:
        route_feedback(args, "opened via local opener bridge")
    return returncode


if __name__ == "__main__":
    raise SystemExit(main())
