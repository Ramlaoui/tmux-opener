#!/usr/bin/env python3
"""Local tmux opener client."""

from __future__ import annotations

import argparse
import json
import os
import platform
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
import urllib.parse
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path


HOST_RE = re.compile(r"^[A-Za-z0-9_.@:-]+$")
DEFAULT_URL_SCHEMES = ("http", "https")
DEFAULT_VSCODE_FOLDER_WINDOW = "new"
DEFAULT_VSCODE_FILE_WINDOW = "reuse"
DEFAULT_LOCALHOST_FORWARD_START_PORT = 18000
DEFAULT_LOCALHOST_FORWARD_END_PORT = 18999
LOCALHOST_FORWARD_STARTUP_TIMEOUT = 1.0
PROCESS_STDERR_LOG_LIMIT = 2000
VSCODE_WINDOW_POLICIES = ("new", "reuse")
LOCALHOST_SCHEMES = ("http", "https")
REMOTE_LOCALHOST_HOSTS = ("localhost", "127.0.0.1")


@dataclass(slots=True)
class LocalhostForward:
    ssh_host: str
    remote_host: str
    remote_port: int
    local_port: int
    process: subprocess.Popen[bytes]


REMOTE_LOCALHOST_FORWARDS: dict[tuple[str, str, int], LocalhostForward] = {}


class RequestError(Exception):
    pass


def default_socket_path() -> str:
    return os.path.expanduser("~/.local/state/tmux-opener/opener.sock")


def read_request(conn: socket.socket) -> dict[str, object]:
    chunks: list[bytes] = []
    total = 0
    while True:
        chunk = conn.recv(65536)
        if not chunk:
            break
        chunks.append(chunk)
        total += len(chunk)
        if total > 1024 * 1024:
            raise RequestError("request is too large")
        if b"\n" in chunk:
            break

    raw = b"".join(chunks).split(b"\n", 1)[0]
    if not raw:
        raise RequestError("empty request")

    try:
        request = json.loads(raw.decode("utf-8"))
    except json.JSONDecodeError as exc:
        raise RequestError(f"invalid json: {exc}") from exc

    if not isinstance(request, dict):
        raise RequestError("request must be a JSON object")
    if request.get("version") != 1:
        raise RequestError("unsupported request version")
    return request


def send_response(conn: socket.socket, response: dict[str, object]) -> None:
    conn.sendall(json.dumps(response, separators=(",", ":")).encode("utf-8") + b"\n")


def ping_response(args: argparse.Namespace) -> dict[str, object]:
    return {
        "ok": True,
        "client": "tmux-opener-client",
        "pid": os.getpid(),
        "default_ssh_host": args.default_ssh_host,
        "allowed_ssh_hosts": sorted(args.allow_ssh_host),
        "allow_any_ssh_host": bool(args.allow_any_ssh_host),
        "remote_localhost_forwards": active_remote_localhost_forwards(),
    }


def command_text(command: list[str]) -> str:
    return " ".join(shlex.quote(part) for part in command)


def log_line(message: str) -> None:
    timestamp = datetime.now().isoformat(timespec="seconds")
    print(f"{timestamp} {message}", flush=True)


def launch_command(
    command: list[str],
    dry_run: bool,
    verbose: bool,
    command_label: str | None = None,
) -> None:
    command_display = command_text(command)
    label = f" {command_label}" if command_label else ""
    if dry_run:
        log_line(f"dry-run{label}: {command_display}")
        return

    log_line(f"launch{label}: {command_display}")

    try:
        process = subprocess.Popen(
            command,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
        )
    except OSError as exc:
        raise RequestError(f"failed to launch {command_display}: {exc}") from exc

    threading.Thread(target=reap_child, args=(process, command_display), daemon=True).start()


def reap_child(process: subprocess.Popen[bytes], command_display: str) -> None:
    returncode = process.wait()
    if returncode:
        log_line(f"launch exited nonzero rc={returncode}: {command_display}")


def open_with_system(target: str, dry_run: bool, verbose: bool) -> None:
    system = platform.system()
    if system == "Darwin":
        command = ["open", target]
    elif system == "Windows":
        command = ["cmd", "/c", "start", "", target]
    else:
        command = ["xdg-open", target]

    launch_command(command, dry_run, verbose)


def validate_url(url: object, allowed_schemes: set[str]) -> str:
    if not isinstance(url, str):
        raise RequestError("url must be a string")
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in allowed_schemes:
        raise RequestError(f"url scheme is not allowed: {parsed.scheme}")
    if not parsed.netloc and parsed.scheme in {"http", "https"}:
        raise RequestError("url must include a host")
    return url


def validate_host(host: object, allowed_hosts: set[str] | None) -> str:
    if not isinstance(host, str) or not host:
        raise RequestError("ssh_host must be a non-empty string")
    if not HOST_RE.match(host):
        raise RequestError("ssh_host contains unsupported characters")
    if allowed_hosts is not None and host not in allowed_hosts:
        raise RequestError(f"ssh_host is not allowed: {host}")
    return host


def validate_path(path: object) -> str:
    if not isinstance(path, str) or not path.startswith("/"):
        raise RequestError("path must be an absolute remote path")
    if "\x00" in path:
        raise RequestError("path contains a NUL byte")
    return path


def validate_target_type(target_type: object) -> str:
    if target_type in (None, "file"):
        return "file"
    if target_type == "folder":
        return "folder"
    raise RequestError(f"unsupported target_type: {target_type}")


def validate_port(value: object, field: str = "port") -> int:
    if isinstance(value, bool) or not isinstance(value, int):
        raise RequestError(f"{field} must be an integer")
    if not 1 <= value <= 65535:
        raise RequestError(f"{field} is out of range")
    return value


def validate_remote_localhost_host(value: object) -> str:
    if value in (None, "0.0.0.0"):
        return "127.0.0.1"
    if value in REMOTE_LOCALHOST_HOSTS:
        return str(value)
    raise RequestError(f"unsupported remote localhost host: {value}")


def validate_remote_localhost_scheme(value: object) -> str:
    if value in LOCALHOST_SCHEMES:
        return str(value)
    raise RequestError(f"unsupported remote localhost scheme: {value}")


def validate_url_part(value: object, field: str, prefix: str | None = None) -> str:
    if value is None:
        return ""
    if not isinstance(value, str):
        raise RequestError(f"{field} must be a string")
    if "\x00" in value or "\r" in value or "\n" in value:
        raise RequestError(f"{field} contains unsupported characters")
    if prefix and value and not value.startswith(prefix):
        raise RequestError(f"{field} must start with {prefix}")
    return value


def vscode_remote_uri(host: str, path: str) -> str:
    host_q = urllib.parse.quote(host, safe="@.-_:")
    path_q = urllib.parse.quote(path, safe="/:._-")
    return f"vscode-remote://ssh-remote+{host_q}{path_q}"


def vscode_remote_authority(host: str) -> str:
    return f"ssh-remote+{host}"


def vscode_app_url(host: str, path: str) -> str:
    host_q = urllib.parse.quote(host, safe="@.-_:")
    path_q = urllib.parse.quote(path, safe="/:._-")
    return f"vscode://vscode-remote/ssh-remote+{host_q}{path_q}"


def vscode_window_flags(policy: str) -> list[str]:
    if policy == "new":
        return ["--new-window"]
    if policy == "reuse":
        return ["--reuse-window"]
    raise RequestError(f"unsupported VS Code window policy: {policy}")


def open_vscode_remote(
    request: dict[str, object],
    allowed_hosts: set[str] | None,
    dry_run: bool,
    verbose: bool,
    folder_window: str = DEFAULT_VSCODE_FOLDER_WINDOW,
    file_window: str = DEFAULT_VSCODE_FILE_WINDOW,
) -> None:
    host = validate_host(request.get("ssh_host"), allowed_hosts)
    path = validate_path(request.get("path"))
    target_type = validate_target_type(request.get("target_type"))
    line = request.get("line")
    column = request.get("column")

    code = shutil.which("code")
    if code:
        remote_target = path
        if target_type == "file" and isinstance(line, int):
            remote_target = f"{remote_target}:{line}"
            if isinstance(column, int):
                remote_target = f"{remote_target}:{column}"

        window_policy = folder_window if target_type == "folder" else file_window
        window_flags = vscode_window_flags(window_policy)
        goto_flags = ["--goto"] if target_type == "file" and isinstance(line, int) else []
        command = [
            code,
            *window_flags,
            *goto_flags,
            "--remote",
            vscode_remote_authority(host),
            remote_target,
        ]
        launch_command(command, dry_run, verbose, command_label="code")
        return

    open_with_system(vscode_app_url(host, path), dry_run, verbose)


def active_remote_localhost_forwards() -> list[dict[str, object]]:
    active = []
    for key, forward in list(REMOTE_LOCALHOST_FORWARDS.items()):
        if forward.process.poll() is not None:
            REMOTE_LOCALHOST_FORWARDS.pop(key, None)
            continue
        active.append(
            {
                "ssh_host": forward.ssh_host,
                "remote_host": forward.remote_host,
                "remote_port": forward.remote_port,
                "local_port": forward.local_port,
            }
        )
    return active


def stop_remote_localhost_forwards() -> None:
    for key, forward in list(REMOTE_LOCALHOST_FORWARDS.items()):
        if forward.process.poll() is None:
            log_line(
                "stop tunnel: "
                f"{forward.ssh_host} {forward.remote_host}:{forward.remote_port} "
                f"-> 127.0.0.1:{forward.local_port}"
            )
            forward.process.terminate()
            try:
                forward.process.wait(timeout=1.0)
            except subprocess.TimeoutExpired:
                forward.process.kill()
                forward.process.wait(timeout=1.0)
        REMOTE_LOCALHOST_FORWARDS.pop(key, None)


def preferred_localhost_port(remote_port: int, start_port: int, end_port: int) -> int:
    preferred = 10000 + remote_port
    if start_port <= preferred <= end_port:
        return preferred
    return start_port


def port_available(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
        probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            probe.bind(("127.0.0.1", port))
        except OSError:
            return False
    return True


def allocate_localhost_forward_port(remote_port: int, start_port: int, end_port: int) -> int:
    if start_port > end_port:
        raise RequestError("localhost forward port range is invalid")

    preferred = preferred_localhost_port(remote_port, start_port, end_port)
    candidates = [preferred]
    candidates.extend(port for port in range(start_port, end_port + 1) if port != preferred)
    for port in candidates:
        if port_available(port):
            return port
    raise RequestError(f"no free localhost forward port in range {start_port}-{end_port}")


def localhost_port_ready(port: int) -> bool:
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.1):
            return True
    except OSError:
        return False


def process_stderr(process: subprocess.Popen[bytes]) -> str:
    if process.stderr is None:
        return ""
    raw = process.stderr.read()
    if not raw:
        return ""
    text = raw.decode("utf-8", errors="replace").strip()
    if len(text) > PROCESS_STDERR_LOG_LIMIT:
        return "..." + text[-PROCESS_STDERR_LOG_LIMIT:]
    return text


def stderr_suffix(process: subprocess.Popen[bytes]) -> str:
    stderr = process_stderr(process)
    if not stderr:
        return ""
    return f"; stderr: {stderr}"


def wait_for_localhost_forward_start(process: subprocess.Popen[bytes], local_port: int) -> int | None:
    deadline = time.monotonic() + LOCALHOST_FORWARD_STARTUP_TIMEOUT
    while time.monotonic() < deadline:
        returncode = process.poll()
        if returncode is not None:
            return returncode
        if localhost_port_ready(local_port):
            return None
        time.sleep(0.05)
    return None


def watch_localhost_forward(key: tuple[str, str, int], process: subprocess.Popen[bytes], command_display: str) -> None:
    returncode = process.wait()
    current = REMOTE_LOCALHOST_FORWARDS.get(key)
    if current is not None and current.process is process:
        REMOTE_LOCALHOST_FORWARDS.pop(key, None)
    if returncode:
        log_line(f"localhost forward exited nonzero rc={returncode}: {command_display}{stderr_suffix(process)}")
    else:
        log_line(f"localhost forward exited: {command_display}{stderr_suffix(process)}")


def ensure_remote_localhost_forward(
    ssh_host: str,
    remote_host: str,
    remote_port: int,
    args: argparse.Namespace,
) -> int:
    key = (ssh_host, remote_host, remote_port)
    forward = REMOTE_LOCALHOST_FORWARDS.get(key)
    if forward and forward.process.poll() is None:
        return forward.local_port
    if forward:
        REMOTE_LOCALHOST_FORWARDS.pop(key, None)

    local_port = allocate_localhost_forward_port(
        remote_port,
        args.localhost_forward_start_port,
        args.localhost_forward_end_port,
    )
    command = [
        shutil.which("ssh") or "ssh",
        "-N",
        "-S",
        "none",
        "-o",
        "ExitOnForwardFailure=yes",
        "-o",
        "ForkAfterAuthentication=no",
        "-L",
        f"127.0.0.1:{local_port}:{remote_host}:{remote_port}",
        ssh_host,
    ]
    command_display = command_text(command)
    if args.dry_run:
        log_line(f"dry-run tunnel: {command_display}")
        return local_port

    log_line(f"launch tunnel: {command_display}")
    try:
        process = subprocess.Popen(
            command,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            stdin=subprocess.DEVNULL,
        )
    except OSError as exc:
        raise RequestError(f"failed to launch {command_display}: {exc}") from exc

    returncode = wait_for_localhost_forward_start(process, local_port)
    if returncode is not None:
        raise RequestError(
            f"localhost forward exited immediately rc={returncode}: {command_display}{stderr_suffix(process)}"
        )

    REMOTE_LOCALHOST_FORWARDS[key] = LocalhostForward(
        ssh_host=ssh_host,
        remote_host=remote_host,
        remote_port=remote_port,
        local_port=local_port,
        process=process,
    )
    threading.Thread(target=watch_localhost_forward, args=(key, process, command_display), daemon=True).start()
    return local_port


def local_remote_url(scheme: str, local_port: int, path: str, query: str, fragment: str) -> str:
    return urllib.parse.urlunparse((scheme, f"127.0.0.1:{local_port}", path, "", query, fragment))


def open_remote_localhost(
    request: dict[str, object],
    allowed_hosts: set[str] | None,
    args: argparse.Namespace,
) -> None:
    host = validate_host(request.get("ssh_host"), allowed_hosts)
    scheme = validate_remote_localhost_scheme(request.get("scheme"))
    remote_host = validate_remote_localhost_host(request.get("remote_host"))
    remote_port = validate_port(request.get("remote_port"), "remote_port")
    path = validate_url_part(request.get("path"), "path", prefix="/")
    query = validate_url_part(request.get("query"), "query")
    fragment = validate_url_part(request.get("fragment"), "fragment")

    local_port = ensure_remote_localhost_forward(host, remote_host, remote_port, args)
    open_with_system(local_remote_url(scheme, local_port, path, query, fragment), args.dry_run, args.verbose)


def dispatch(request: dict[str, object], args: argparse.Namespace) -> None:
    action = request.get("action")
    if args.verbose:
        log_line(f"request: {json.dumps(request, sort_keys=True)}")

    if action == "ping":
        return

    if action == "open_url":
        open_with_system(
            validate_url(request.get("url"), set(args.allow_url_scheme)),
            args.dry_run,
            args.verbose,
        )
        return

    if action == "open_vscode_remote":
        if "ssh_host" not in request and args.default_ssh_host:
            request = {**request, "ssh_host": args.default_ssh_host}
        if args.allow_any_ssh_host:
            allowed_hosts = None
        elif args.allow_ssh_host:
            allowed_hosts = set(args.allow_ssh_host)
        else:
            raise RequestError("no SSH hosts are allowed; pass --allow-ssh-host HOST")
        open_vscode_remote(
            request,
            allowed_hosts,
            args.dry_run,
            args.verbose,
            folder_window=args.vscode_folder_window,
            file_window=args.vscode_file_window,
        )
        return

    if action == "open_remote_localhost":
        if "ssh_host" not in request and args.default_ssh_host:
            request = {**request, "ssh_host": args.default_ssh_host}
        if args.allow_any_ssh_host:
            allowed_hosts = None
        elif args.allow_ssh_host:
            allowed_hosts = set(args.allow_ssh_host)
        else:
            raise RequestError("no SSH hosts are allowed; pass --allow-ssh-host HOST")
        open_remote_localhost(request, allowed_hosts, args)
        return

    raise RequestError(f"unsupported action: {action}")


def serve_once(server: socket.socket, args: argparse.Namespace) -> None:
    conn, _addr = server.accept()
    with conn:
        try:
            request = read_request(conn)
            if request.get("action") == "ping":
                send_response(conn, ping_response(args))
                return
            dispatch(request, args)
        except RequestError as exc:
            log_line(f"reject: {exc}")
            send_response(conn, {"ok": False, "error": str(exc)})
            return
        send_response(conn, {"ok": True})


def bind_server(socket_path: str) -> socket.socket:
    path = Path(socket_path).expanduser()
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        path.unlink()

    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(path))
    os.chmod(path, 0o600)
    server.listen(16)
    return server


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--socket", default=default_socket_path(), help="local Unix socket path")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--verbose", action="store_true", help="log full received request payloads")
    parser.add_argument("--once", action="store_true", help="serve one request and exit")
    parser.add_argument("--allow-url-scheme", action="append", default=list(DEFAULT_URL_SCHEMES))
    parser.add_argument("--allow-ssh-host", action="append", default=[])
    parser.add_argument("--allow-any-ssh-host", action="store_true")
    parser.add_argument("--default-ssh-host")
    parser.add_argument(
        "--vscode-folder-window",
        choices=VSCODE_WINDOW_POLICIES,
        default=DEFAULT_VSCODE_FOLDER_WINDOW,
        help="VS Code window policy for remote folders (default: new)",
    )
    parser.add_argument(
        "--vscode-file-window",
        choices=VSCODE_WINDOW_POLICIES,
        default=DEFAULT_VSCODE_FILE_WINDOW,
        help="VS Code window policy for remote files (default: reuse)",
    )
    parser.add_argument(
        "--localhost-forward-start-port",
        type=int,
        default=DEFAULT_LOCALHOST_FORWARD_START_PORT,
        help="first local port to use for remote localhost forwards (default: 18000)",
    )
    parser.add_argument(
        "--localhost-forward-end-port",
        type=int,
        default=DEFAULT_LOCALHOST_FORWARD_END_PORT,
        help="last local port to use for remote localhost forwards (default: 18999)",
    )
    args = parser.parse_args()

    server = bind_server(args.socket)
    stop = False

    def handle_signal(_signum: int, _frame: object) -> None:
        nonlocal stop
        stop = True
        server.close()

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    log_line(f"tmux-opener-client listening on {args.socket}")
    try:
        while not stop:
            serve_once(server, args)
            if args.once:
                break
    except OSError:
        if not stop:
            raise
    finally:
        stop_remote_localhost_forwards()
        try:
            Path(args.socket).unlink()
        except FileNotFoundError:
            pass

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
