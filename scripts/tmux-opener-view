#!/usr/bin/env python3
"""Show a file or folder in the terminal with the best viewer installed.

The remote plugin runs this inside a tmux popup for the Inline opener. Every
viewer reads the path as an argument; nothing from the file is executed.
"""

from __future__ import annotations

import argparse
import csv
import curses
import os
import shutil
import subprocess
import sys
import tempfile
import termios
import tty
from dataclasses import dataclass
from pathlib import Path

from tmux_opener_common import IMAGE_SUFFIXES


HIGHLIGHT_LIMIT = 20 * 1024 * 1024  # larger text skips bat/jq and streams through less
TABLE_ROWS = 5000
TABLE_CELL = 40


@dataclass
class Table:
    """Aligned rows shown by page_table with the header pinned; less 590 has no --header."""

    name: str
    lines: list[str]
    start: int = 0


@dataclass
class Pdf:
    """Pages rendered one at a time by page_pdf and drawn with kitty graphics."""

    name: str
    path: Path
    pages: int
    page: int = 1


# Probing reads terminal replies that the key reader would take for key presses.
CHAFA_PIXELS = ["chafa", "--format=kitty", "--passthrough=tmux", "--probe=off", "--align=mid,mid"]
# Keys that move between PDF pages, including arrows and PgUp/PgDn.
PAGE_STEPS = {" ": 1, "j": 1, "l": 1, "n": 1, "\x1b[B": 1, "\x1b[C": 1, "\x1b[6~": 1,
              "b": -1, "k": -1, "h": -1, "p": -1, "\x1b[A": -1, "\x1b[D": -1, "\x1b[5~": -1}


def prompt_text(text: str) -> str:
    return "".join("\\" + char if char in "?:.%\\" else char for char in text)


def pager(name: str, line: int | None = None, *, chop: bool = False, numbers: bool = False) -> list[str]:
    # -+F keeps short files open: the popup closes as soon as the viewer exits.
    command = ["less", "-R", "-+F", f"-Ps{prompt_text(name)}  line %lb?L/%L.  q quits"]
    if chop:
        command.append("-S")
    if numbers:
        command.append("-N")
    if line:
        command.append("-j.3")
    # The jump also repaints: less's first screen can be lost while a popup opens.
    command.append(f"+{line or 1}g")
    return command


def human_size(size: float) -> str:
    for unit in ("B", "KiB", "MiB", "GiB"):
        if size < 1024 or unit == "GiB":
            return f"{size:.0f} {unit}" if unit == "B" else f"{size:.1f} {unit}"
        size /= 1024
    return ""


def is_binary(path: Path) -> bool:
    with path.open("rb") as handle:
        return b"\0" in handle.read(8192)


def describe(path: Path, note: str, which=shutil.which) -> str:
    kind = ""
    if which("file"):
        kind = subprocess.run(["file", "-b", "--", str(path)], capture_output=True, text=True, check=False).stdout.strip()
    return f"{path}\n\n  {kind or 'binary data'}\n  {human_size(path.stat().st_size)}\n\n{note}\n"


def table(path: Path) -> list[str] | None:
    """Align CSV/TSV columns into header, rule and rows; None when the file is not a clean table."""

    delimiter = "\t" if path.suffix.lower() == ".tsv" else ","
    rows: list[list[str]] = []
    try:
        with path.open(encoding="utf-8", errors="replace", newline="") as handle:
            for row in csv.reader(handle, delimiter=delimiter):
                rows.append([cell if len(cell) <= TABLE_CELL else cell[: TABLE_CELL - 1] + "…" for cell in row])
                if len(rows) > TABLE_ROWS:
                    break
    except csv.Error:
        return None
    if not rows:
        return None
    truncated = len(rows) > TABLE_ROWS
    rows = rows[:TABLE_ROWS]
    widths = [max(len(row[index]) for row in rows if index < len(row)) for index in range(max(map(len, rows)))]
    lines = ["  ".join(cell.ljust(widths[index]) for index, cell in enumerate(row)).rstrip() for row in rows]
    lines.insert(1, "  ".join("─" * width for width in widths))
    if truncated:
        lines += ["", f"… showing the first {TABLE_ROWS} rows; open in VS Code or Preview for the rest"]
    return lines


def pdf_pages(path: Path, which=shutil.which) -> int:
    pdfinfo = which("pdfinfo")
    if not pdfinfo:
        return 0
    info = subprocess.run([pdfinfo, str(path.absolute())], capture_output=True, text=True, check=False).stdout
    return next((int(value) for key, _, value in (row.partition(":") for row in info.splitlines())
                 if key == "Pages" and value.strip().isdigit()), 0)


def read_key() -> str:
    attributes = termios.tcgetattr(sys.stdin)
    try:
        tty.setcbreak(sys.stdin)
        return os.read(sys.stdin.fileno(), 8).decode("utf-8", "replace")
    finally:
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, attributes)


def page_pdf(view: Pdf) -> int:
    with tempfile.TemporaryDirectory(prefix="tmux-opener-pdf-") as folder:
        while True:
            columns, rows = shutil.get_terminal_size()
            image = Path(folder, f"{view.page}.png")
            if not image.exists():
                subprocess.run(["pdftoppm", "-png", "-singlefile", "-scale-to", "2000", "-f", str(view.page),
                                "-l", str(view.page), str(view.path), str(image.with_suffix(""))],
                               stderr=subprocess.DEVNULL, check=False)
            print("\x1b[H\x1b[2J", end="", flush=True)
            subprocess.run([*CHAFA_PIXELS, f"--size={columns}x{rows - 1}", str(image)], check=False)
            status = f"{view.name}  page {view.page}/{view.pages}  space/b pages  g/G first/last  q close"
            print(f"\x1b[{rows};1H\x1b[2m{status[:columns]}\x1b[0m", end="", flush=True)
            page = view.page
            while page == view.page:
                key = read_key()
                if key in ("q", "\x1b"):
                    print("\x1b[H\x1b[2J\x1b[?25h", end="", flush=True)
                    return 0
                target = {"g": 1, "G": view.pages}.get(key, page + PAGE_STEPS.get(key, 0))
                view.page = min(max(target, 1), view.pages)


def page_table(screen: curses.window, view: Table) -> int:
    """A small pager for tables: less-style keys, header pinned, / searches rows."""

    try:
        curses.curs_set(0)
    except curses.error:
        pass
    header, body = view.lines[:2], view.lines[2:]
    top, left, query, note = view.start, 0, "", ""

    def find(start: int, step: int) -> int | None:
        rows = range(start, len(body)) if step > 0 else range(start, -1, -1)
        return next((row for row in rows if query in body[row].lower()), None)

    while True:
        height, width = screen.getmaxyx()
        page = max(1, height - 3)
        top = max(0, min(top, len(body) - page))
        screen.erase()
        visible = [(header[0], curses.A_BOLD), (header[1], curses.A_DIM)]
        visible += [(line, curses.A_STANDOUT if query and query in line.lower() else 0) for line in body[top:top + page]]
        status = note or f" {view.name}  rows {top + 1}-{min(top + page, len(body))}/{len(body)}  ←→ scroll  / search  q quits"
        visible += [("", 0)] * (height - 1 - len(visible)) + [(status.ljust(width), curses.A_REVERSE)]
        for y, (line, attr) in enumerate(visible[:height]):
            try:
                screen.addnstr(y, 0, line if y == height - 1 else line[left:], width - 1, attr)
            except curses.error:
                pass
        note = ""
        key = screen.getch()
        if key in (ord("q"), ord("Q"), 27):
            return 0
        moves = {ord("j"): 1, curses.KEY_DOWN: 1, 10: 1, ord("k"): -1, curses.KEY_UP: -1,
                 ord(" "): page, ord("f"): page, curses.KEY_NPAGE: page, ord("b"): -page, curses.KEY_PPAGE: -page,
                 ord("d"): page // 2, ord("u"): -(page // 2)}
        if key in moves:
            top += moves[key]
        elif key in (ord("g"), curses.KEY_HOME):
            top = 0
        elif key in (ord("G"), curses.KEY_END):
            top = len(body)
        elif key in (ord("l"), curses.KEY_RIGHT):
            left += 8
        elif key in (ord("h"), curses.KEY_LEFT):
            left = max(0, left - 8)
        elif key == ord("0"):
            left = 0
        elif key == ord("/"):
            screen.addnstr(height - 1, 0, "/".ljust(width), width - 1, curses.A_REVERSE)
            curses.echo()
            try:
                curses.curs_set(1)
            except curses.error:
                pass
            query = screen.getstr(height - 1, 1, 200).decode("utf-8", "replace").strip().lower()
            curses.noecho()
            try:
                curses.curs_set(0)
            except curses.error:
                pass
            if query:
                match = find(top, 1)
                top, note = (match, "") if match is not None else (top, f" pattern not found: {query}")
        elif key in (ord("n"), ord("N")) and query:
            match = find(top + 1, 1) if key == ord("n") else find(top - 1, -1)
            top, note = (match, "") if match is not None else (top, " no more matches")


def plan(path: Path, line: int | None = None, which=shutil.which, size: tuple[int, int] = (80, 24),
         pixels: bool = False) -> tuple[list[str] | str | Table | Pdf | None, list[str] | None]:
    """Return (producer, pager): an argv or text piped into less, None when less reads the file,
    a Table or Pdf with no pager for the built-in views, or an argv drawing to the terminal with no pager."""

    name = path.name or str(path)
    if path.is_dir():
        return ["ls", "-la", str(path)], pager(name)
    suffix = path.suffix.lower()
    if suffix in IMAGE_SUFFIXES:
        columns, rows = size
        if pixels and which("chafa"):
            return [*CHAFA_PIXELS, f"--size={columns}x{rows - 1}", str(path)], None
        if which("chafa"):
            # less needs a finished stream, so animations show their first frame.
            return ["chafa", "--format=symbols", "--animate=off", f"--size={columns}x{rows - 2}", str(path)], pager(name)
        if which("timg"):
            return ["timg", "-pq", "--frames=1", f"-g{columns}x{rows - 2}", str(path)], pager(name)
        return describe(path, "Install chafa or timg on this host to see images inline,\n"
                              "or use the Preview opener to open them on your desktop.", which), pager(name)
    if suffix == ".pdf":
        pages = pdf_pages(path, which) if pixels and which("chafa") and which("pdftoppm") else 0
        if pages:
            # path:N selections open at page N.
            return Pdf(name, path.absolute(), pages, min(max(line or 1, 1), pages)), None
        if which("pdftotext"):
            return ["pdftotext", "-layout", str(path.absolute()), "-"], pager(name)
    if is_binary(path):
        return describe(path, "Binary file: use the Preview or Download opener to open it on your desktop.", which), pager(name)
    small = path.stat().st_size <= HIGHLIGHT_LIMIT
    lines = table(path) if suffix in {".csv", ".tsv"} and small else None
    if lines is not None:
        # File line N holds row N - 1; the header stays pinned above it.
        return Table(name, lines, max(0, (line or 2) - 2)), None
    if suffix == ".json" and small:
        if which("jq"):
            return ["jq", "-C", ".", str(path)], pager(name)
        return [sys.executable, "-m", "json.tool", str(path)], pager(name)
    glow = which("glow")
    if suffix in {".md", ".markdown"} and glow and small:
        return [glow, "--style=dark", f"--width={min(size[0] - 2, 120)}", "--", str(path)], pager(name)
    bat = which("bat") or which("batcat")
    if bat and small:
        highlight = ["--highlight-line", str(line)] if line else []
        return [bat, "--color=always", "--paging=never", "--style=numbers", *highlight, "--", str(path)], pager(name, line)
    return None, pager(name, line, numbers=bool(line)) + ["--", str(path)]


def run(producer: list[str] | str | Table | Pdf | None, pager_command: list[str] | None) -> int:
    if isinstance(producer, Table):
        os.environ.setdefault("ESCDELAY", "25")
        return curses.wrapper(page_table, producer)
    if isinstance(producer, Pdf):
        return page_pdf(producer)
    if producer is None:
        return subprocess.run(pager_command, check=False).returncode
    if pager_command is None:  # pixel images: less would mangle the graphics escapes
        # The hint goes first because animations keep drawing until a key stops them.
        print(f"\x1b[{shutil.get_terminal_size().lines};1H\x1b[2mPress any key to close\x1b[0m\x1b[H", end="", flush=True)
        drawing = subprocess.Popen(producer, stdin=subprocess.DEVNULL)
        read_key()
        if drawing.poll() is None:
            drawing.terminate()
            drawing.wait()
            print("\x1b\\", end="", flush=True)  # end a graphics escape cut off mid-frame
            return 0
        return drawing.returncode
    if isinstance(producer, str):
        viewer = subprocess.Popen(pager_command, stdin=subprocess.PIPE)
        try:
            viewer.communicate(producer.encode("utf-8", "replace"))
        except BrokenPipeError:
            pass
        return viewer.wait()
    source = subprocess.Popen(producer, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    try:
        viewer = subprocess.Popen(pager_command, stdin=source.stdout)
        return viewer.wait()
    finally:
        source.stdout.close()  # type: ignore[union-attr]
        source.kill()
        source.wait()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("path")
    parser.add_argument("--line", type=int)
    parser.add_argument("--pixels", action="store_true", help="draw images and PDFs with kitty graphics")
    args = parser.parse_args()
    path = Path(args.path)
    try:
        return run(*plan(path, args.line, size=tuple(shutil.get_terminal_size()), pixels=args.pixels))
    except OSError as exc:
        print(f"tmux-opener: cannot show {path}: {exc.strerror or exc}", file=sys.stderr)
        input("Press Enter to close. ")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
