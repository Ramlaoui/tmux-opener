#!/usr/bin/env python3
"""Show and control the local tmux-opener client's host and transfers."""

from __future__ import annotations

import argparse
import curses
import getpass
import json
import locale
import os
import platform
import shutil
import subprocess
import sys
import time
from collections.abc import Mapping
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

from tmux_opener_common import default_socket_path, send_request


STATUS_STATES = {
    "queued",
    "choosing_destination",
    "downloading",
    "completed",
    "failed",
    "cancelled",
    "interrupted",
}
RETRY_STATES = {"failed", "cancelled", "interrupted"}
DEFAULT_TIMEOUT = 3.0
REFRESH_SECONDS = 1.0
DEFAULT_STATE_DIR = Path.home() / ".local" / "state" / "tmux-opener"
DEFAULT_SNIPPET_DIR = Path.home() / ".ssh" / "tmux-opener.d"


class StatusError(RuntimeError):
    """A status request was rejected or did not return the status contract."""


def sanitize_terminal_text(value: object) -> str:
    """Return text safe to put directly into a terminal cell.

    JSON escaping protects --json output. This helper is for the text and
    curses views, where control characters supplied by a filename or error
    message must never be interpreted by the terminal.
    """

    text = "" if value is None else str(value)
    return "".join(
        character
        for character in text
        if not (ord(character) < 0x20 or 0x7F <= ord(character) <= 0x9F)
    )


def _optional_text(value: object, fallback: str = "-") -> str:
    text = sanitize_terminal_text(value)
    return text if text else fallback


def build_status_request(cwd: str, pane: str | None = None, ssh_host: str | None = None) -> dict[str, object]:
    """Build the version 1 status request sent over the forwarded socket."""

    request: dict[str, object] = {
        "version": 1,
        "action": "get_status",
        "host_info": {
            "hostname": platform.node(),
            "user": getpass.getuser(),
            "os": platform.system(),
            "cwd": cwd,
            "pane": pane if pane is not None else os.environ.get("TMUX_PANE"),
        },
    }
    if ssh_host:
        request["ssh_host"] = ssh_host
    return request


def build_action_request(action: str, download_id: object, ssh_host: str | None = None) -> dict[str, object]:
    if action not in {"cancel_download", "retry_download"}:
        raise ValueError(f"unsupported dashboard action: {action}")
    request: dict[str, object] = {"version": 1, "action": action, "download_id": download_id}
    if ssh_host:
        request["ssh_host"] = ssh_host
    return request


def _status_error(response: Mapping[str, object]) -> StatusError:
    error = sanitize_terminal_text(response.get("error"))
    if error:
        if "unknown action" in error.lower() or "unsupported" in error.lower():
            return StatusError(f"old client unsupported: {error}")
        return StatusError(error)
    return StatusError("client rejected get_status")


def validate_status_response(response: Mapping[str, object]) -> dict[str, object]:
    """Validate the response shape while tolerating empty optional lists."""

    if response.get("ok") is not True:
        raise _status_error(response)
    # Existing clients acknowledge unknown actions with {ok: true}. Requiring
    # these fields makes that case visible instead of showing a blank dashboard.
    if not isinstance(response.get("client_info"), Mapping) or not isinstance(response.get("downloads"), list):
        raise StatusError("old client unsupported: get_status is unavailable")

    result = dict(response)
    if not isinstance(result.get("hosts"), list):
        result["hosts"] = []
    if not isinstance(result.get("remote_localhost_forwards"), list):
        result["remote_localhost_forwards"] = []
    return result


def request_status(
    socket_path: str | None = None,
    *,
    cwd: str | None = None,
    pane: str | None = None,
    ssh_host: str | None = None,
    timeout: float = DEFAULT_TIMEOUT,
) -> dict[str, object]:
    request = build_status_request(
        cwd if cwd is not None else os.environ.get("TMUX_OPENER_CWD") or os.getcwd(),
        pane,
        ssh_host,
    )
    response = send_request(socket_path or default_socket_path(), request, timeout)
    return validate_status_response(response)


def _local_dashboard_api():
    """Load desktop aggregation helpers only for explicit local mode."""

    package_root = Path(__file__).resolve().parents[1]
    if str(package_root) not in sys.path:
        sys.path.insert(0, str(package_root))
    try:
        from lib.tmux_opener_dashboard import client_request, collect_status
    except (ImportError, ModuleNotFoundError) as exc:
        raise StatusError("local dashboard support is unavailable") from exc
    return client_request, collect_status


def request_local_status(
    state_dir: str | os.PathLike[str] = DEFAULT_STATE_DIR,
    snippet_dir: str | os.PathLike[str] = DEFAULT_SNIPPET_DIR,
    *,
    ssh_host: str | None = None,
    socket_path: str | os.PathLike[str] | None = None,
) -> dict[str, object]:
    """Aggregate configured desktop clients into the dashboard response shape."""

    _client_request, collect_status = _local_dashboard_api()
    raw = collect_status(
        Path(state_dir).expanduser(),
        Path(snippet_dir).expanduser(),
        host=ssh_host,
        socket_path=Path(socket_path).expanduser() if socket_path else None,
    )
    clients = raw.get("clients") if isinstance(raw, Mapping) else []
    clients = clients if isinstance(clients, list) else []
    hosts: list[object] = []
    downloads: list[object] = []
    forwards: list[object] = []
    first_online_info: Mapping[str, object] | None = None
    selected_client: object = None
    for client in clients:
        if not isinstance(client, Mapping):
            continue
        if client.get("online") is True and first_online_info is None:
            selected_client = client.get("host")
            info = client.get("client_info")
            if isinstance(info, Mapping):
                first_online_info = info
        client_hosts = client.get("hosts")
        if isinstance(client_hosts, list):
            hosts.extend(host for host in client_hosts if isinstance(host, Mapping))
        client_forwards = client.get("remote_localhost_forwards")
        if isinstance(client_forwards, list):
            forwards.extend(client_forwards)
        client_downloads = client.get("downloads")
        if isinstance(client_downloads, list):
            for download in client_downloads:
                if not isinstance(download, Mapping):
                    continue
                routed = dict(download)
                routed["_socket"] = client.get("socket")
                routed["_client_host"] = client.get("host")
                downloads.append(routed)

    return {
        "ok": True,
        "version": 1,
        "client_info": dict(first_online_info or {}),
        "clients": clients,
        "selected_client": selected_client,
        "hosts": hosts,
        "downloads": downloads,
        "remote_localhost_forwards": forwards,
        "updated_at": raw.get("updated_at") if isinstance(raw, Mapping) else None,
    }


def request_local_action(download: Mapping[str, object], action: str, timeout: float) -> dict[str, object]:
    """Route one local dashboard action through the client owning the row."""

    client_request, _collect_status = _local_dashboard_api()
    socket_path = download.get("_socket")
    if not isinstance(socket_path, str) or not socket_path:
        raise StatusError("local transfer has no owning client socket")
    response = client_request(
        Path(socket_path),
        build_action_request(action, download.get("id"), str(download.get("ssh_host") or "") or None),
        timeout,
    )
    if not isinstance(response, Mapping) or response.get("ok") is not True:
        if isinstance(response, Mapping):
            raise _status_error(response)
        raise StatusError("local client returned an invalid action response")
    return dict(response)


def request_action(
    socket_path: str,
    action: str,
    download_id: object,
    timeout: float,
    ssh_host: str | None = None,
) -> dict[str, object]:
    response = send_request(socket_path, build_action_request(action, download_id, ssh_host), timeout)
    if response.get("ok") is not True:
        raise _status_error(response)
    return response


def _number(value: object) -> int | None:
    if isinstance(value, bool):
        return None
    try:
        number = int(value)  # type: ignore[arg-type]
    except (TypeError, ValueError, OverflowError):
        return None
    return number if number >= 0 else None


def format_bytes(value: object) -> str:
    number = _number(value)
    if number is None:
        return "-"
    units = ("B", "KiB", "MiB", "GiB", "TiB")
    scaled = float(number)
    unit = units[0]
    for unit in units:
        if scaled < 1024 or unit == units[-1]:
            break
        scaled /= 1024
    if unit == "B":
        return f"{number} B"
    return f"{scaled:.1f} {unit}"


def _current_host(snapshot: Mapping[str, object], ssh_host: str | None = None) -> Mapping[str, object] | None:
    hosts = snapshot.get("hosts")
    if not isinstance(hosts, list):
        return None
    candidates = [host for host in hosts if isinstance(host, Mapping)]
    client = snapshot.get("client_info")
    client = client if isinstance(client, Mapping) else {}
    requested = ssh_host or _optional_text(client.get("default_ssh_host"))
    if requested and requested != "-":
        for host in candidates:
            if str(host.get("ssh_host") or "") == requested:
                return host
    return candidates[0] if candidates else None


def snapshot_downloads(snapshot: Mapping[str, object] | None) -> list[Mapping[str, object]]:
    """Transfers in display order: running, queued, then most recently updated."""

    downloads = snapshot.get("downloads") if snapshot else None
    rows = [item for item in downloads if isinstance(item, Mapping)] if isinstance(downloads, list) else []
    rows.sort(key=lambda item: str(item.get("updated_at") or ""), reverse=True)
    rank = {"downloading": 0, "choosing_destination": 1, "queued": 1}
    return sorted(rows, key=lambda item: rank.get(str(item.get("state")), 2))


# Rendering works on lines of (text, style) segments. Styles are space-separated
# names resolved to curses attributes; the plain-text view just joins the text.
Segment = tuple[str, str]
Line = list[Segment]

UTF8 = "utf" in (sys.stdout.encoding or locale.getpreferredencoding(False) or "").lower()
GLYPHS = (
    {"run": "●", "wait": "○", "ok": "✓", "fail": "✗", "off": "–", "fill": "━", "empty": "─", "select": "›",
     "rule": "─", "arrow": "→", "dot": "·", "left": "‹", "right": "›", "up": "↑", "down": "↓"}
    if UTF8 else
    {"run": "*", "wait": "o", "ok": "+", "fail": "x", "off": "-", "fill": "#", "empty": "-", "select": ">",
     "rule": "-", "arrow": "->", "dot": "|", "left": "<", "right": ">", "up": "^", "down": "v"}
)
# state -> (style, glyph, label)
STATE_LOOK = {
    "downloading": ("info", "run", "downloading"),
    "queued": ("warn", "wait", "queued"),
    "choosing_destination": ("warn", "wait", "choosing file"),
    "completed": ("good", "ok", "done"),
    "failed": ("bad", "fail", "failed"),
    "interrupted": ("bad", "fail", "interrupted"),
    "cancelled": ("dim", "off", "cancelled"),
}
OPENER_LABELS = {"vscode": "VS Code", "tmux": "Inline", "preview": "Preview", "download": "Download"}
SETTING_ROWS = (
    ("vscode_file_window", "VS Code files", ("new", "reuse")),
    ("vscode_folder_window", "VS Code folders", ("new", "reuse")),
    ("pdf_viewer", "PDF viewer", ("auto", "zathura", "skim", "sioyek", "acrobat", "system")),
)


def plain(line: Line) -> str:
    return "".join(text for text, _style in line)


def _clip(value: object, width: int) -> str:
    text = _optional_text(value)
    if width <= 0:
        return ""
    return text if len(text) <= width else text[: width - 1] + "…"


def _clip_left(value: object, width: int) -> str:
    """Clip from the left so the informative end of a path stays visible."""

    text = _optional_text(value)
    if width <= 0:
        return ""
    return text if len(text) <= width else "…" + text[-(width - 1):]


def _basename(value: object) -> str:
    path = sanitize_terminal_text(value)
    if not path:
        return "-"
    return path.rstrip("/").rsplit("/", 1)[-1] or path


def _ago(value: object) -> str:
    try:
        moment = datetime.fromisoformat(str(value))
        seconds = (datetime.now(timezone.utc) - moment).total_seconds()
    except (TypeError, ValueError):
        return "-"
    if seconds < 45:
        return "just now"
    if seconds < 3600:
        return f"{round(seconds / 60)}m ago"
    if seconds < 86400:
        return f"{round(seconds / 3600)}h ago"
    return f"{round(seconds / 86400)}d ago"


def _pad(line: Line, width: int, style: str = "") -> Line:
    missing = width - len(plain(line))
    return line + [(" " * missing, style)] if missing > 0 else line


def _joined(parts: list[str]) -> str:
    return f" {GLYPHS['dot']} ".join(part for part in parts if part and part != "-")


def _header(title: str, right: str, width: int) -> Line:
    left: Line = [(" tmux-opener ", "brand"), (f" {title}", "header")]
    gap = max(width - 1 - len(plain(left)) - len(right) - 1, 1)
    return left + [(" " * gap, "header"), (f"{right} ", "header")]


def _tabs(view: str) -> Line:
    line: Line = [(" ", "")]
    for name, label in (("transfers", "Transfers"), ("clients", "Clients"), ("openers", "Openers")):
        line += [(f" {label} ", "tab-on" if name == view else "dim"), (" ", "")]
    return line + [("  tab to switch", "dim")]


def _label(text: str) -> Segment:
    return (f" {text:<10}", "label")


def _summary_lines(snapshot: Mapping[str, object], ssh_host: str | None, pane: str | None) -> list[Line]:
    client = snapshot.get("client_info")
    client = client if isinstance(client, Mapping) else {}
    lines: list[Line] = []
    local_clients = snapshot.get("clients")
    if isinstance(local_clients, list):
        first = True
        for local_client in local_clients:
            if not isinstance(local_client, Mapping):
                continue
            alias = _clip(local_client.get("host") or "(unnamed)", 14).ljust(14)
            prefix = _label("CLIENTS" if first else "")
            first = False
            if local_client.get("online") is True:
                info = local_client.get("client_info")
                info = info if isinstance(info, Mapping) else {}
                detail = _joined([f"{_optional_text(info.get('user'))}@{_optional_text(info.get('hostname'))}",
                                  _optional_text(info.get("os")), f"pid {_optional_text(info.get('pid'))}",
                                  f"last request {_ago(info.get('last_request_at'))}"])
                lines.append([prefix, (GLYPHS["run"] + " ", "good"), (alias, "bold"), (" " + detail, "")])
            else:
                lines.append([prefix, (GLYPHS["wait"] + " ", "dim"), (alias, "dim"),
                              (" offline: " + _optional_text(local_client.get("error")), "dim")])
        if first:
            lines.append([_label("CLIENTS"), ("no desktop clients configured; run tmux-opener ssh HOST", "dim")])
    else:
        detail = _joined([f"{_optional_text(client.get('user'))}@{_optional_text(client.get('hostname'))}",
                          _optional_text(client.get("os")), f"pid {_optional_text(client.get('pid'))}",
                          f"started {_ago(client.get('started_at'))}", f"last request {_ago(client.get('last_request_at'))}"])
        lines.append([_label("CLIENT"), (GLYPHS["run"] + " ", "good"), (detail, "")])

    host = _current_host(snapshot, ssh_host)
    if host is None:
        lines.append([_label("REMOTE"), ("no recent terminal report", "dim")])
    else:
        detail = _joined([f"{_optional_text(host.get('user'))}@{_optional_text(host.get('hostname'))}",
                          _optional_text(host.get("os")), f"pane {_optional_text(host.get('pane') or pane)}",
                          f"seen {_ago(host.get('last_seen'))}"])
        lines.append([_label("REMOTE"), (_optional_text(host.get("ssh_host"), "(no alias)"), "accent bold"), ("  " + detail, "")])
        lines.append([_label(""), (_optional_text(host.get("cwd")), "dim")])
    lines.append([_label(""), ("last terminal report; does not indicate active SSH", "dim")])

    forwards = snapshot.get("remote_localhost_forwards")
    if isinstance(forwards, list) and forwards:
        tunnels = []
        for forward in forwards[:4]:
            if isinstance(forward, Mapping) and "remote_port" in forward:
                tunnels.append(f"{_optional_text(forward.get('ssh_host'))}:{_optional_text(forward.get('remote_port'))}"
                               f" {GLYPHS['arrow']} 127.0.0.1:{_optional_text(forward.get('local_port'))}")
        more = f"  +{len(forwards) - 4} more" if len(forwards) > 4 else ""
        lines.append([_label("TUNNELS"), ("   ".join(tunnels) or f"{len(forwards)} forwarded", ""), (more, "dim")])
    return lines


def format_progress(download: Mapping[str, object]) -> str:
    received = _number(download.get("bytes_received"))
    size = _number(download.get("size_bytes"))
    if size is not None and size > 0 and received is not None:
        percent = min(100.0, max(0.0, received * 100.0 / size))
        return f"{format_bytes(received)} of {format_bytes(size)} ({percent:.0f}%)"
    if received is not None:
        return format_bytes(received)
    if size is not None and size > 0:
        return f"- of {format_bytes(size)}"
    return "unknown"


def _progress_bar(download: Mapping[str, object], width: int) -> Line:
    received = _number(download.get("bytes_received"))
    size = _number(download.get("size_bytes"))
    state = str(download.get("state") or "")
    if state == "completed":
        filled = width
    elif size and received is not None:
        filled = min(width, received * width // size)
    else:
        filled = 0
    style = {"completed": "good", "downloading": "info"}.get(state, "dim")
    return [(GLYPHS["fill"] * filled, style), (GLYPHS["empty"] * (width - filled), "faint")]


def transfer_line(download: Mapping[str, object], width: int, selected: bool = False) -> Line:
    state = str(download.get("state") or "")
    style, glyph, label = STATE_LOOK.get(state, ("dim", "wait", sanitize_terminal_text(state) or "unknown"))
    received = _number(download.get("bytes_received"))
    size = _number(download.get("size_bytes"))
    if size and received is not None and state not in ("completed", "cancelled"):
        amount = f"{min(100, received * 100 // size):>3}% of {format_bytes(size)}"
    elif size:
        amount = format_bytes(size)
    else:
        amount = format_bytes(received) if received else ""
    bar_width = 16 if width >= 96 else 10 if width >= 76 else 0
    fixed = 2 + 2 + 12 + (bar_width + 2 if bar_width else 0) + 19 + 13
    name_width = max(width - 1 - fixed, 10)
    name = _basename(download.get("path"))
    if download.get("kind") == "folder":
        count = _number(download.get("file_count"))
        name = f"{name}/" + ("" if count is None else f" ({count} file{'' if count == 1 else 's'})")
    if download.get("preview"):
        name = f"{name} (preview)"
    line: Line = [
        (f" {GLYPHS['select'] if selected else ' '}", "accent bold"),
        (GLYPHS[glyph] + " ", style),
        (_clip(name, name_width).ljust(name_width), "bold" if state in ("downloading", "queued") else ""),
        ("  " + _clip(download.get("ssh_host") or "local", 10).ljust(10), "dim"),
    ]
    if bar_width:
        line += [("  ", "")] + _progress_bar(download, bar_width)
    line += [("  " + amount.ljust(17)[:17], "dim"), (label.rjust(13)[:13], style)]
    if selected:
        line = [(text, "sel") for text, _style in _pad(line, width - 1)]
    return line


def _detail_lines(download: Mapping[str, object] | None, width: int) -> list[Line]:
    rule = GLYPHS["rule"]
    if download is None:
        return [[(" " + rule * max(width - 2, 0), "faint")], [("  no transfers yet: select a path in copy mode and press d", "dim")]]
    title = f" {rule * 2} {_basename(download.get('path'))} "
    state = str(download.get("state") or "")
    style, _glyph, label = STATE_LOOK.get(state, ("dim", "wait", sanitize_terminal_text(state) or "unknown"))
    lines: list[Line] = [
        [(title, "bold"), (rule * max(width - 2 - len(title), 0), "faint")],
        [("  source  ", "label"), (f"{_optional_text(download.get('ssh_host'), 'local')}:", "accent"),
         (_clip_left(download.get("path"), width - 14 - len(_optional_text(download.get("ssh_host"), "local"))), "")],
        [("  saved   ", "label"), (_clip_left(download.get("destination"), width - 12), "")],
        [("  status  ", "label"), (label, style), (f"  {format_progress(download)}", "dim"),
         (f"  {GLYPHS['dot']} updated {_ago(download.get('updated_at'))}", "dim")],
    ]
    resumed = _number(download.get("resumed_from"))
    if resumed:
        lines[-1].append((f"  {GLYPHS['dot']} resumed at {format_bytes(resumed)}", "dim"))
    error = sanitize_terminal_text(download.get("error"))
    lines.append([("  error   ", "label"), (_clip(error, width - 12), "bad")] if error else [])
    return lines


def _counts(downloads: list[Mapping[str, object]]) -> str:
    states = [str(item.get("state") or "") for item in downloads]
    parts = [
        (sum(state in ("downloading", "queued", "choosing_destination") for state in states), "active"),
        (states.count("completed"), "done"),
        (sum(state in ("failed", "interrupted") for state in states), "failed"),
    ]
    return _joined([f"{count} {name}" for count, name in parts if count])


def transfer_sections(
    snapshot: Mapping[str, object], *, ssh_host: str | None, pane: str | None, selected: int, width: int,
) -> tuple[list[Line], list[Line], list[Line], int]:
    """Return fixed top lines, transfer rows, detail lines and clamped selection."""

    title = "desktop dashboard" if isinstance(snapshot.get("clients"), list) else "host dashboard"
    top = [_header(title, ssh_host or "", width), []] + _summary_lines(snapshot, ssh_host, pane)
    downloads = snapshot_downloads(snapshot)
    top += [[], [(" TRANSFERS ", "label"), (f" {_counts(downloads) or 'none'}", "dim")]]
    selected = min(max(selected, 0), max(len(downloads) - 1, 0))
    rows = [transfer_line(download, width, index == selected) for index, download in enumerate(downloads)]
    return top, rows, _detail_lines(downloads[selected] if downloads else None, width), selected


def render_snapshot_lines(
    snapshot: Mapping[str, object],
    *,
    ssh_host: str | None = None,
    pane: str | None = None,
    selected: int = 0,
    width: int | None = None,
) -> list[str]:
    """Render one plain-text snapshot with the same sections as the live view."""

    top, rows, details, _selected = transfer_sections(snapshot, ssh_host=ssh_host, pane=pane, selected=selected, width=width or 100)
    lines = [plain(line).rstrip() for line in top + rows + details]
    if width is not None and width > 1:
        return [line[: width - 1] for line in lines]
    return lines


def _hints(pairs: list[tuple[str, str]], message: str | None = None) -> Line:
    line: Line = [(" ", "")]
    for key, label in pairs:
        line += [(key, "key"), (f" {label}   ", "dim")]
    if message:
        line += [(message, "accent")]
    return line


TRANSFER_HINTS = [("↑↓" if UTF8 else "j/k", "select"), ("c", "cancel"), ("r", "retry"), ("tab", "openers"), ("q", "quit")]
OPENER_HINTS = [("↑↓" if UTF8 else "j/k", "select"), ("←→", "change"), ("a", "add"), ("x", "delete"), ("J/K", "move"),
                ("tab", "transfers"), ("q", "quit")]


def render_transfers_view(
    snapshot: Mapping[str, object], *, ssh_host: str | None, pane: str | None, selected: int, width: int, height: int,
    message: str | None = None,
) -> list[Line]:
    """Height-bounded transfer view; only the transfer rows scroll."""

    top, rows, details, selected = transfer_sections(snapshot, ssh_host=ssh_host, pane=pane, selected=selected, width=width)
    top.insert(1, _tabs("transfers"))
    footer = _hints(TRANSFER_HINTS, message)
    available = height - len(top) - len(details) - 2
    if available < 3:
        # Small popups drop the machine summary before the transfer list.
        top = top[:2] + top[-1:]
        available = max(height - len(top) - len(details) - 2, 1)
    if not rows:
        rows = [[("   nothing here yet", "dim")]]
    first = min(max(selected - available + 1, 0), max(len(rows) - available, 0))
    visible = rows[first : first + available]
    if first > 0:
        top[-1] = top[-1] + [(f"   {GLYPHS['up']} {first} more", "dim")]
    hidden_below = len(rows) - first - len(visible)
    filler: list[Line] = [[] for _ in range(max(available - len(visible), 0))]
    below: Line = [(f"   {GLYPHS['down']} {hidden_below} more", "dim")] if hidden_below > 0 else []
    return (top + visible + [below] + details + filler + [footer])[: max(height, 0)]


def dashboard_clients(snapshot: Mapping[str, object], socket_path: str | None) -> list[dict[str, object]]:
    clients = snapshot.get("clients")
    if isinstance(clients, list):
        return [client for client in clients if isinstance(client, dict)]
    info = snapshot.get("client_info")
    if not isinstance(info, dict):
        return []
    return [{"host": info.get("default_ssh_host") or "Desktop", "socket": socket_path or default_socket_path(),
             "online": True, "can_restart": snapshot.get("can_restart") is True, "client_info": info}]


def restart_dashboard_clients(clients: list[dict[str, object]], timeout: float) -> str:
    accepted = 0
    errors = []
    for client in clients:
        info = client.get("client_info", {})
        instance = info.get("instance_id") if isinstance(info, dict) else None
        path = client.get("socket")
        if client.get("online") is not True or client.get("can_restart") is not True or not instance or not isinstance(path, str):
            errors.append(f"{client.get('host')}: client offline or restart unsupported")
            continue
        try:
            response = send_request(path, {"version": 1, "action": "restart_client", "instance_id": instance}, timeout)
            if response.get("ok") is not True or response.get("restart_accepted") is not True:
                raise StatusError(str(response.get("error") or "restart was not acknowledged"))
            accepted += 1
        except (OSError, ValueError, StatusError) as exc:
            errors.append(f"{client.get('host')}: {sanitize_terminal_text(exc)}")
    return f"restart requested for {accepted} client(s)" + ("; " + "; ".join(errors) if errors else "")


def render_clients_view(clients: list[dict[str, object]], *, title: str, selected: int,
                        width: int, height: int, message: str | None = None) -> list[Line]:
    lines = [_header(title, "clients", width), _tabs("clients"), [],
             [(" CLIENTS ", "label"), (" desktop opener processes; remote reports are recent activity", "dim")], []]
    selected = min(selected, max(len(clients) - 1, 0))
    available = max(height - 12, 1)
    first = max(selected - available + 1, 0)
    for index, client in enumerate(clients[first:first + available], first):
        online = client.get("online") is True
        info = client.get("client_info", {})
        info = info if isinstance(info, dict) else {}
        name = _optional_text(client.get("host"))
        detail = f"{_optional_text(info.get('user'))}@{_optional_text(info.get('hostname'))} · pid {_optional_text(info.get('pid'))}" if online else _optional_text(client.get("error") or "not responding")
        lines.append([(" > " if index == selected else "   ", "key"),
                      (_clip(name, 18).ljust(18), "bold"),
                      (" online  " if online else " offline ", "good" if online else "dim"),
                      (_clip(detail, max(width - 33, 0)), "")])
    if not clients:
        lines.append([("   no desktop clients configured", "dim")])
    else:
        client = clients[selected]
        info = client.get("client_info", {})
        info = info if isinstance(info, dict) else {}
        lines += [[], [(" Socket  ", "label"), (_clip(client.get("socket"), max(width - 10, 0)), "mono")],
                  [(" Started ", "label"), (_ago(info.get("started_at")), "")],
                  [(" Activity", "label"), (" " + _ago(info.get("last_request_at")), "")]]
    lines += [[], [(" Restart interrupts transfers; retry partial copies from Transfers.", "dim")]]
    lines += [[] for _ in range(max(height - len(lines) - 1, 0))]
    lines.append(_hints([("tab", "switch"), ("j/k", "select"), ("r", "restart"), ("R", "restart all online"), ("q", "quit")], message))
    return lines[:height]


def opener_items(settings: Mapping[str, object]) -> int:
    rules = settings.get("rules")
    return (len(rules) if isinstance(rules, list) else 0) + len(SETTING_ROWS)


def render_openers_view(
    settings_state: Mapping[str, object] | None, *, title: str, selected: int, width: int, height: int,
    message: str | None = None,
) -> list[Line]:
    lines: list[Line] = [_header(title, "openers", width), _tabs("openers"), []]
    lines.append([(" OPENERS ", "label"), ("  how remote files open when you press o; first matching rule wins", "dim")])
    if not settings_state or not isinstance(settings_state.get("settings"), Mapping):
        error = settings_state.get("error") if settings_state else None
        lines += [[], [("   " + _optional_text(error, "loading settings…"), "warn")]]
        return (lines + [[] for _ in range(max(height - len(lines) - 1, 0))] + [_hints([("tab", "transfers"), ("q", "quit")], message)])[:height]
    settings = settings_state["settings"]
    rules = [rule for rule in settings.get("rules", []) if isinstance(rule, Mapping)]  # type: ignore[union-attr]
    allowed = settings_state.get("preview_suffixes")
    if settings_state.get("error"):
        lines.append([("   " + _clip(settings_state.get("error"), width - 4), "warn")])
    lines.append([])

    def row(index: int, name: str, value: str, style: str = "", note: str = "") -> Line:
        chosen = index == selected
        value_text = f"{GLYPHS['left']} {value} {GLYPHS['right']}" if chosen else f"  {value}  "
        line: Line = [(f" {GLYPHS['select'] if chosen else ' '} ", "accent bold"), (_clip(name, 28).ljust(30), ""),
                      (value_text, style or "accent"), (f"  {note}" if note else "", "warn")]
        return [(text, "sel") for text, _style in _pad(line, width - 1)] if chosen else line

    pattern_width = 30
    for index, rule in enumerate(rules):
        opener = str(rule.get("opener"))
        pattern = sanitize_terminal_text(rule.get("pattern"))
        note = ""
        suffix = ("." + pattern.rsplit(".", 1)[-1].lower()) if "." in pattern.rsplit("/", 1)[-1] else ""
        if opener == "preview" and isinstance(allowed, list) and suffix and suffix not in allowed:
            note = f"preview blocked for {suffix}; will fail"
        lines.append(row(index, f"{index + 1:>2}  {_clip(pattern, pattern_width - 4)}", OPENER_LABELS.get(opener, opener),
                         {"tmux": "bold", "preview": "good", "download": "info"}.get(opener, "accent"), note))
    lines.append([("    ", ""), ("*  everything else".ljust(30), "dim"), ("  VS Code", "dim")])
    if not rules:
        lines.append([("    press a to add a rule such as *.log (inline), *.pdf (preview) or *.pt (download)", "dim")])
    lines += [[], [(" WINDOWS & VIEWERS ", "label")]]
    for offset, (key, name, _choices) in enumerate(SETTING_ROWS):
        lines.append(row(len(rules) + offset, f"    {name}", _optional_text(settings.get(key))))
    lines += [[], [(f"   saved to {_optional_text(settings_state.get('path'))}", "faint")],
              [("   Inline shows the file in a popup here; Preview copies it to the desktop and opens it;", "faint")],
              [("   Download saves it to Downloads.", "faint")]]
    lines = lines[: max(height - 1, 0)]
    return lines + [[] for _ in range(max(height - len(lines) - 1, 0))] + [_hints(OPENER_HINTS, message)]


def _styles() -> dict[str, int]:
    names = ("info", "good", "warn", "bad", "accent", "header", "brand", "label", "key", "tab-on", "dim", "faint", "bold", "sel")
    styles = dict.fromkeys(names, 0)
    styles.update(bold=curses.A_BOLD, dim=curses.A_DIM, faint=curses.A_DIM, sel=curses.A_REVERSE,
                  label=curses.A_BOLD | curses.A_DIM, key=curses.A_BOLD, header=curses.A_REVERSE,
                  brand=curses.A_REVERSE | curses.A_BOLD, **{"tab-on": curses.A_REVERSE | curses.A_BOLD})
    try:
        curses.start_color()
        curses.use_default_colors()
        for pair, (name, color) in enumerate((("info", curses.COLOR_CYAN), ("good", curses.COLOR_GREEN),
                                              ("warn", curses.COLOR_YELLOW), ("bad", curses.COLOR_RED),
                                              ("accent", curses.COLOR_MAGENTA)), start=1):
            curses.init_pair(pair, color, -1)
            styles[name] = curses.color_pair(pair)
        curses.init_pair(6, curses.COLOR_WHITE, curses.COLOR_BLUE)
        curses.init_pair(7, curses.COLOR_BLACK, curses.COLOR_CYAN)
        styles.update(header=curses.color_pair(6), brand=curses.color_pair(7) | curses.A_BOLD,
                      key=curses.color_pair(5) | curses.A_BOLD, **{"tab-on": curses.color_pair(6) | curses.A_BOLD})
        if curses.COLORS >= 16:
            curses.init_pair(8, 8, -1)  # bright black renders more reliably than A_DIM
            styles["faint"] = curses.color_pair(8)
    except (curses.error, ValueError):
        pass
    return styles


def draw(screen: Any, lines: list[Line], styles: Mapping[str, int]) -> None:
    height, width = screen.getmaxyx()
    screen.erase()
    for row, line in enumerate(lines[: max(height, 0)]):
        column = 0
        for text, style in line:
            room = width - 1 - column
            if room <= 0:
                break
            attr = 0
            for name in style.split():
                attr |= styles.get(name, 0)
            try:
                screen.addnstr(row, column, text, room, attr)
            except curses.error:
                pass
            column += min(len(text), room)
    screen.refresh()


def _display_error(screen: Any, message: str, styles: Mapping[str, int] | None = None) -> None:
    _height, width = screen.getmaxyx()
    lines = [_header("host dashboard", "", width), [],
             [("  ERROR: ", "bad bold"), (sanitize_terminal_text(message), "bad")], [],
             [("  The desktop client did not answer. ", "dim")],
             _hints([("q", "quit"), ("any key", "retry")])]
    draw(screen, lines, styles or {})


def _local_settings_module():
    package_root = Path(__file__).resolve().parents[1]
    if str(package_root) not in sys.path:
        sys.path.insert(0, str(package_root))
    try:
        from lib import tmux_opener_settings
    except (ImportError, ModuleNotFoundError) as exc:
        raise StatusError("local settings support is unavailable") from exc
    return tmux_opener_settings


def request_settings(socket_path: str | None, timeout: float, local: bool) -> dict[str, object]:
    """Read opener settings from the desktop (local mode) or its client."""

    if local:
        module = _local_settings_module()
        settings, error = module.load()
        return {"settings": settings, "error": error, "path": str(module.settings_path()),
                "available_pdf_viewers": module.available_pdf_viewers(),
                "preview_suffixes": sorted(module.PREVIEW_SUFFIXES)}
    response = send_request(socket_path or default_socket_path(), {"version": 1, "action": "get_settings"}, timeout)
    if response.get("ok") is not True:
        raise _status_error(response)
    if not isinstance(response.get("settings"), Mapping):
        raise StatusError("this desktop client predates opener settings; restart it with a newer tmux-opener")
    return dict(response)


def save_settings(settings: Mapping[str, object], socket_path: str | None, timeout: float, local: bool) -> None:
    if local:
        try:
            _local_settings_module().save(dict(settings))
        except ValueError as exc:
            raise StatusError(str(exc)) from exc
        return
    response = send_request(socket_path or default_socket_path(), {"version": 1, "action": "set_settings", "settings": settings}, timeout)
    if response.get("ok") is not True:
        raise _status_error(response)


def _prompt(screen: Any, label: str) -> str:
    """Read one line at the bottom of the screen; empty input cancels."""

    height, width = screen.getmaxyx()
    screen.timeout(-1)
    try:
        curses.echo()
        curses.curs_set(1)
    except curses.error:
        pass
    try:
        screen.move(height - 1, 0)
        screen.clrtoeol()
        screen.addnstr(height - 1, 0, label, max(width - 1, 1), curses.A_BOLD)
        raw = screen.getstr(height - 1, min(len(label), width - 2), 256)
    except curses.error:
        raw = b""
    finally:
        try:
            curses.noecho()
            curses.curs_set(0)
        except curses.error:
            pass
        screen.timeout(100)
    return sanitize_terminal_text(raw.decode("utf-8", "replace")).strip()


def edit_settings(settings: dict[str, object], selected: int, key: int, screen: Any,
                  available_pdf_viewers: list[str] | None = None) -> tuple[bool, int]:
    """Apply one opener-view key to settings; return (changed, selection)."""

    rules = settings.get("rules")
    if not isinstance(rules, list):
        rules = settings["rules"] = []
    on_rule = selected < len(rules)
    if key in (curses.KEY_RIGHT, curses.KEY_LEFT, ord("l"), ord("h"), ord(" "), 10, 13, curses.KEY_ENTER):
        step = -1 if key in (curses.KEY_LEFT, ord("h")) else 1
        if on_rule:
            choices = tuple(OPENER_LABELS)
            rule = rules[selected]
            rule["opener"] = choices[(choices.index(rule["opener"]) + step) % len(choices)] if rule["opener"] in choices else choices[0]
        else:
            name, _label_text, choices = SETTING_ROWS[selected - len(rules)]
            if name == "pdf_viewer" and available_pdf_viewers is not None:
                choices = tuple(choice for choice in choices if choice in available_pdf_viewers)
                if not choices:
                    return False, selected
            current = settings.get(name)
            settings[name] = choices[(choices.index(current) + step) % len(choices)] if current in choices else choices[0]
        return True, selected
    if key == ord("a"):
        pattern = _prompt(screen, " New rule pattern (e.g. *.pdf, */figures/*.png): ")
        if not pattern:
            return False, selected
        rules.append({"pattern": pattern, "opener": "preview"})
        return True, len(rules) - 1
    if key in (ord("x"), ord("d"), curses.KEY_DC) and on_rule:
        rules.pop(selected)
        return True, min(selected, max(len(rules) - 1, 0))
    if key in (ord("J"), ord("K")) and on_rule:
        target = selected + (1 if key == ord("J") else -1)
        if 0 <= target < len(rules):
            rules[selected], rules[target] = rules[target], rules[selected]
            return True, target
    return False, selected


def run_live_dashboard(
    screen: Any,
    *,
    socket_path: str | None,
    cwd: str,
    pane: str | None,
    ssh_host: str | None,
    timeout: float,
    local: bool = False,
    state_dir: str | os.PathLike[str] = DEFAULT_STATE_DIR,
    snippet_dir: str | os.PathLike[str] = DEFAULT_SNIPPET_DIR,
    initial_snapshot: dict[str, object] | None = None,
) -> None:
    screen.timeout(100)
    styles = _styles()
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    snapshot: dict[str, object] | None = initial_snapshot
    view = "transfers"
    selected = 0
    selected_id: object = None
    opener_selected = 0
    client_selected = 0
    selected_client_socket: object = None
    settings_state: dict[str, object] | None = None
    error: str | None = None
    message: str | None = None
    force_refresh = initial_snapshot is None
    next_refresh = time.monotonic() + REFRESH_SECONDS if initial_snapshot is not None else 0.0
    title = "desktop dashboard" if local else "host dashboard"

    def load_settings() -> dict[str, object]:
        try:
            return request_settings(socket_path, timeout, local)
        except (OSError, ValueError, StatusError) as exc:
            return {"error": sanitize_terminal_text(exc) or "settings unavailable"}

    while True:
        now = time.monotonic()
        if force_refresh or now >= next_refresh:
            force_refresh = False
            next_refresh = now + REFRESH_SECONDS
            try:
                latest = (
                    request_local_status(state_dir, snippet_dir, ssh_host=ssh_host, socket_path=socket_path)
                    if local
                    else request_status(socket_path, cwd=cwd, pane=pane, ssh_host=ssh_host, timeout=timeout)
                )
                downloads = snapshot_downloads(latest)
                if selected_id is not None:
                    selected = next((i for i, item in enumerate(downloads) if item.get("id") == selected_id), min(selected, max(len(downloads) - 1, 0)))
                selected = min(selected, max(len(downloads) - 1, 0))
                selected_id = downloads[selected].get("id") if downloads else None
                clients = dashboard_clients(latest, socket_path)
                if selected_client_socket is not None:
                    client_selected = next((index for index, client in enumerate(clients)
                                            if client.get("socket") == selected_client_socket),
                                           min(client_selected, max(len(clients) - 1, 0)))
                selected_client_socket = clients[client_selected].get("socket") if clients else None
                snapshot = latest
                error = None
            except (OSError, ValueError, StatusError) as exc:
                error = sanitize_terminal_text(exc) or "bridge unavailable"

        height, width = screen.getmaxyx()
        if error:
            _display_error(screen, error, styles)
        elif view == "openers":
            draw(screen, render_openers_view(settings_state, title=title, selected=opener_selected, width=width,
                                             height=height, message=message), styles)
        elif view == "clients" and snapshot is not None:
            draw(screen, render_clients_view(dashboard_clients(snapshot, socket_path), title=title,
                                             selected=client_selected, width=width, height=height, message=message), styles)
        elif snapshot is not None:
            lines = render_transfers_view(snapshot, ssh_host=ssh_host, pane=pane, selected=selected, width=width,
                                          height=height, message=message)
            lines[0] = _header(title, f"{ssh_host + '  ' if ssh_host else ''}{time.strftime('%H:%M:%S')}", width)
            draw(screen, lines, styles)

        key = screen.getch()
        if key < 0:
            continue
        if key in (ord("q"), ord("Q"), 27):
            return
        if error:
            # Any key is an explicit recovery attempt while the bridge error
            # remains visible; q above is the only exit path.
            force_refresh = True
            continue
        message = None
        if key == 9:  # tab
            views = ("transfers", "clients", "openers")
            view = views[(views.index(view) + 1) % len(views)]
            if view == "openers":
                settings_state = load_settings()
            continue
        if view == "clients" and snapshot is not None:
            clients = dashboard_clients(snapshot, socket_path)
            client_selected = min(client_selected, max(len(clients) - 1, 0))
            if clients and key in (curses.KEY_UP, ord("k"), curses.KEY_DOWN, ord("j")):
                client_selected = (client_selected + (-1 if key in (curses.KEY_UP, ord("k")) else 1)) % len(clients)
                selected_client_socket = clients[client_selected].get("socket")
            elif clients and key in (ord("r"), ord("R")):
                targets = [clients[client_selected]] if key == ord("r") else [client for client in clients if client.get("can_restart") is True]
                message = restart_dashboard_clients(targets, timeout)
                force_refresh = True
            continue
        if view == "openers":
            settings = settings_state.get("settings") if settings_state else None
            if not isinstance(settings, Mapping):
                settings_state = load_settings()
                continue
            count = opener_items(settings)
            if key in (curses.KEY_UP, ord("k")):
                opener_selected = (opener_selected - 1) % count
            elif key in (curses.KEY_DOWN, ord("j")):
                opener_selected = (opener_selected + 1) % count
            else:
                edited = json.loads(json.dumps(settings))
                changed, opener_selected = edit_settings(edited, opener_selected, key, screen,
                                                        settings_state.get("available_pdf_viewers"))
                if changed:
                    try:
                        save_settings(edited, socket_path, timeout, local)
                        message = "saved"
                    except (OSError, ValueError, StatusError) as exc:
                        message = f"not saved: {sanitize_terminal_text(exc)}"
                    settings_state = load_settings()
            opener_selected = min(opener_selected, max(opener_items(settings_state.get("settings") or {}) - 1, 0))
            continue
        downloads = snapshot_downloads(snapshot)
        if key in (curses.KEY_UP, ord("k")) and downloads:
            selected = (selected - 1) % len(downloads)
            selected_id = downloads[selected].get("id")
        elif key in (curses.KEY_DOWN, ord("j")) and downloads:
            selected = (selected + 1) % len(downloads)
            selected_id = downloads[selected].get("id")
        elif key in (ord("c"), ord("C"), ord("r"), ord("R")) and downloads:
            download = downloads[selected]
            action = "cancel_download" if key in (ord("c"), ord("C")) else "retry_download"
            if action == "retry_download" and str(download.get("state", "")) not in RETRY_STATES:
                force_refresh = True
                continue
            try:
                if local:
                    request_local_action(download, action, timeout)
                else:
                    request_action(socket_path or default_socket_path(), action, download.get("id"), timeout, ssh_host)
                message = f"{action.split('_')[0]} requested for {_basename(download.get('path'))}"
                force_refresh = True
            except (OSError, ValueError, StatusError) as exc:
                error = sanitize_terminal_text(exc) or "bridge unavailable"
        else:
            force_refresh = True


def _json_error(message: object) -> dict[str, object]:
    return {"ok": False, "error": sanitize_terminal_text(message)}


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--local", action="store_true", help="aggregate desktop client sockets instead of querying a forwarded host")
    parser.add_argument("--socket", default=None, help="forwarded or explicitly selected client Unix socket")
    parser.add_argument("--ssh-host", default=os.environ.get("TMUX_OPENER_SSH_HOST"), help="host alias to report")
    parser.add_argument("--state-dir", default=str(DEFAULT_STATE_DIR), help="desktop client socket state directory")
    parser.add_argument("--snippet-dir", default=str(DEFAULT_SNIPPET_DIR), help="managed SSH snippet directory")
    parser.add_argument("--cwd", default=os.environ.get("TMUX_OPENER_CWD") or os.getcwd())
    parser.add_argument("--pane", default=os.environ.get("TMUX_PANE"), help="originating tmux pane id")
    parser.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT, help="socket request timeout in seconds")
    parser.add_argument("--once", action="store_true", help="print one text snapshot and exit")
    parser.add_argument("--json", action="store_true", help="print one JSON snapshot and exit")
    return parser


def _desktop_fallback(ssh_host: str | None) -> int | None:
    cli = shutil.which("tmux-opener")
    if cli is None:
        return None
    command = [cli, "terminal-dashboard"]
    if ssh_host:
        command.append(ssh_host)
    return subprocess.run(command, check=False).returncode


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    socket_path = args.socket or (None if args.local else default_socket_path())
    if args.json or args.once:
        try:
            snapshot = (
                request_local_status(args.state_dir, args.snippet_dir, ssh_host=args.ssh_host, socket_path=socket_path)
                if args.local
                else request_status(socket_path, cwd=args.cwd, pane=args.pane, ssh_host=args.ssh_host, timeout=args.timeout)
            )
        except (OSError, ValueError, StatusError) as exc:
            if args.json:
                print(json.dumps(_json_error(exc), sort_keys=True))
            else:
                print(f"tmux-opener-status: {sanitize_terminal_text(exc)}", file=sys.stderr)
            return 1
        if args.json:
            print(json.dumps(snapshot, sort_keys=True))
        else:
            print("\n".join(render_snapshot_lines(snapshot, ssh_host=args.ssh_host, pane=args.pane)))
        return 0

    initial_snapshot: dict[str, object] | None = None
    if not args.local:
        try:
            initial_snapshot = request_status(
                socket_path,
                cwd=args.cwd,
                pane=args.pane,
                ssh_host=args.ssh_host,
                timeout=args.timeout,
            )
        except (OSError, ValueError, StatusError):
            fallback_result = _desktop_fallback(args.ssh_host)
            if fallback_result is not None:
                return fallback_result

    try:
        curses.wrapper(
            lambda screen: run_live_dashboard(
                screen,
                socket_path=socket_path,
                cwd=args.cwd,
                pane=args.pane,
                ssh_host=args.ssh_host,
                timeout=args.timeout,
                local=args.local,
                state_dir=args.state_dir,
                snippet_dir=args.snippet_dir,
                initial_snapshot=initial_snapshot,
            )
        )
    except KeyboardInterrupt:
        return 0
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
