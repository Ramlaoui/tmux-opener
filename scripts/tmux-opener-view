#!/usr/bin/env python3
"""Show a file or folder in the terminal with the best viewer installed.

The remote plugin runs this inside a tmux popup for the Inline opener. Every
viewer reads the path as an argument; nothing from the file is executed.
"""

from __future__ import annotations

import argparse
import base64
import csv
import curses
import functools
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import termios
import threading
import time
import tty
from collections.abc import Iterator
from dataclasses import dataclass
from pathlib import Path
from typing import IO

from tmux_opener_common import IMAGE_SUFFIXES


HIGHLIGHT_LIMIT = 20 * 1024 * 1024  # larger text skips bat/jq and streams through less
TABLE_ROWS = 5000
TABLE_CELL = 40


@dataclass
class Table:
    """Aligned rows shown by page_table with the header pinned; less 590 has no --header."""

    name: str
    lines: list[str]
    start: int = 0


@dataclass
class Pdf:
    """Pages rendered one at a time by page_pdf and drawn with kitty graphics."""

    name: str
    path: Path
    pages: int
    page: int = 1


KITTY_REPLY_RE = re.compile(r"\x1b_G[^\x1b]*\x1b\\")
# Browser roles as (256-color, 8-color) foregrounds on the terminal's own background.
COLORS = {"folder": (75, curses.COLOR_BLUE), "image": (176, curses.COLOR_MAGENTA), "pdf": (167, curses.COLOR_RED),
          "code": (71, curses.COLOR_GREEN), "data": (172, curses.COLOR_YELLOW), "archive": (166, curses.COLOR_RED),
          "muted": (245, curses.COLOR_WHITE), "accent": (214, curses.COLOR_YELLOW), "error": (203, curses.COLOR_RED),
          "ok": (114, curses.COLOR_GREEN)}
KINDS = {**dict.fromkeys(IMAGE_SUFFIXES, "image"), ".pdf": "pdf",
         **dict.fromkeys((".py", ".ipynb", ".sh", ".js", ".ts", ".c", ".cc", ".cpp", ".h", ".rs", ".go", ".java", ".jl",
                          ".lua", ".tex", ".toml", ".yaml", ".yml", ".cfg", ".ini"), "code"),
         **dict.fromkeys((".csv", ".tsv", ".json", ".jsonl", ".npy", ".npz", ".pt", ".pth", ".ckpt", ".h5", ".hdf5",
                          ".parquet", ".pkl", ".nc", ".safetensors", ".db", ".sqlite"), "data"),
         **dict.fromkeys((".zip", ".tar", ".gz", ".tgz", ".xz", ".bz2", ".zst", ".7z"), "archive")}
BROWSER_KEYS = [("⏎", "open"), ("←", "back"), ("␣", "mark"), ("a", "all"), ("d", "download"), ("D", "save as"),
                ("/", "search"), (".", "hidden"), ("q", "quit")]
# ANSI styles for render_markdown; less -R passes them through.
MD_HEADINGS = ["\x1b[1;4;38;5;75m", "\x1b[1;38;5;75m", "\x1b[1;38;5;110m", "\x1b[1m"]
MD_CODE, MD_MUTED, MD_RESET = "\x1b[38;5;180m", "\x1b[38;5;245m", "\x1b[0m"
# Keys that move between PDF pages, including arrows and PgUp/PgDn.
PAGE_STEPS = {" ": 1, "j": 1, "l": 1, "n": 1, "\x1b[B": 1, "\x1b[C": 1, "\x1b[6~": 1,
              "b": -1, "k": -1, "h": -1, "p": -1, "\x1b[A": -1, "\x1b[D": -1, "\x1b[5~": -1}


def prompt_text(text: str) -> str:
    return "".join("\\" + char if char in "?:.%\\" else char for char in text)


def pager(name: str, line: int | None = None, *, chop: bool = False, numbers: bool = False) -> list[str]:
    # -+F keeps short files open: the popup closes as soon as the viewer exits.
    command = ["less", "-R", "-+F", f"-Ps{prompt_text(name)}  line %lb?L/%L.  q quits"]
    if chop:
        command.append("-S")
    if numbers:
        command.append("-N")
    if line:
        command.append("-j.3")
    # The jump also repaints: less's first screen can be lost while a popup opens.
    command.append(f"+{line or 1}g")
    return command


@dataclass
class Folder:
    """A directory browsed by browse_folder; pixels lets previews draw images and PDFs."""

    path: Path
    pixels: bool = False


def human_size(size: float) -> str:
    for unit in ("B", "KiB", "MiB", "GiB"):
        if size < 1024 or unit == "GiB":
            return f"{size:.0f} {unit}" if unit == "B" else f"{size:.1f} {unit}"
        size /= 1024
    return ""


def is_binary(path: Path) -> bool:
    with path.open("rb") as handle:
        return b"\0" in handle.read(8192)


def markdown_inline(text: str) -> str:
    parts = text.split("`")
    if len(parts) % 2 == 0:  # an unmatched backtick: leave code spans alone
        parts = [text]
    for index, part in enumerate(parts):
        if index % 2:
            parts[index] = f"{MD_CODE}{part}\x1b[39m"
            continue
        part = re.sub(r"!?\[([^\]]+)\]\(([^)\s]+)[^)]*\)", lambda m: f"\x1b[4;38;5;110m{m[1]}\x1b[24;39m{MD_MUTED} ({m[2]})\x1b[39m", part)
        part = re.sub(r"\*\*(.+?)\*\*|__(.+?)__", lambda m: f"\x1b[1m{m[1] or m[2]}\x1b[22m", part)
        parts[index] = re.sub(r"(?<![\w*])\*(?![\s*])(.+?)(?<![\s*])\*(?![\w*])|(?<!\w)_(?![\s_])(.+?)(?<![\s_])_(?!\w)",
                              lambda m: f"\x1b[3m{m[1] or m[2]}\x1b[23m", part)
    return "".join(parts)


def render_markdown(text: str, width: int) -> str:
    """Style Markdown for less -R, one output line per source line so path:N still jumps right."""

    lines, fence, table_rows, rule = [], "", [], max(min(width - 2, 40), 8)

    def flush_table() -> None:
        cells = [[cell.strip() for cell in row.strip().strip("|").split("|")] for row in table_rows]
        rule = [all(set(cell) <= set(":- ") for cell in row) for row in cells]
        text = [row for row, is_rule in zip(cells, rule) if not is_rule] or cells
        widths = [max((len(row[index]) for row in text if index < len(row)), default=0)
                  for index in range(max(map(len, cells)))]
        for row, is_rule in zip(cells, rule):
            if is_rule:
                lines.append(MD_MUTED + "─┼─".join("─" * size for size in widths) + MD_RESET)
            else:
                padded = [markdown_inline(cell) + " " * (size - len(cell)) for cell, size in zip(row, widths)]
                lines.append(f"{MD_MUTED} │ {MD_RESET}".join(padded).rstrip())
        table_rows.clear()

    for line in text.splitlines():
        stripped = line.strip()
        if table_rows and not stripped.startswith("|"):
            flush_table()
        if fence:
            if stripped.startswith(fence):
                fence, line = "", MD_MUTED + "└" + "─" * (rule - 1) + MD_RESET
            else:
                line = f"{MD_MUTED}│{MD_RESET} {MD_CODE}{line}{MD_RESET}"
        elif stripped.startswith(("```", "~~~")):
            fence, label = stripped[:3], stripped[3:].strip()
            line = MD_MUTED + "┌─" + (f" {label} " if label else "") + "─" * max(rule - len(label) - 4, 0) + MD_RESET
        elif stripped.startswith("|"):
            table_rows.append(line)
            continue
        elif match := re.match(r"(#{1,6})\s+(.*)", stripped):
            line = MD_HEADINGS[min(len(match[1]), 4) - 1] + match[2].rstrip("# ") + MD_RESET
        elif re.fullmatch(r"([-*_])( *\1){2,}", stripped):
            line = MD_MUTED + "─" * min(width - 1, 80) + MD_RESET
        elif match := re.match(r"(\s*)[-*+]\s+(\[[ xX]\]\s+)?(.*)", line):
            box = {"[ ]": f"{MD_MUTED}[ ]\x1b[39m ", "[x]": "\x1b[38;5;114m[✓]\x1b[39m ",
                   "[X]": "\x1b[38;5;114m[✓]\x1b[39m "}.get((match[2] or "").strip(), "")
            line = f"{match[1]}\x1b[38;5;75m•\x1b[39m {box}{markdown_inline(match[3])}"
        elif match := re.match(r"(\s*)(\d+[.)])\s+(.*)", line):
            line = f"{match[1]}\x1b[38;5;75m{match[2]}\x1b[39m {markdown_inline(match[3])}"
        elif stripped.startswith(">"):
            line = f"{MD_MUTED}▌ \x1b[3m{markdown_inline(stripped.lstrip('> '))}{MD_RESET}"
        else:
            line = markdown_inline(line)
        lines.append(line)
    if table_rows:
        flush_table()
    return "\n".join(lines) + "\n"


def describe(path: Path, note: str, which=shutil.which) -> str:
    kind = ""
    if which("file"):
        kind = subprocess.run(["file", "-b", "--", str(path)], capture_output=True, text=True, check=False).stdout.strip()
    return f"{path}\n\n  {kind or 'binary data'}\n  {human_size(path.stat().st_size)}\n\n{note}\n"


def table(path: Path) -> list[str] | None:
    """Align CSV/TSV columns into header, rule and rows; None when the file is not a clean table."""

    delimiter = "\t" if path.suffix.lower() == ".tsv" else ","
    rows: list[list[str]] = []
    try:
        with path.open(encoding="utf-8", errors="replace", newline="") as handle:
            for row in csv.reader(handle, delimiter=delimiter):
                rows.append([cell if len(cell) <= TABLE_CELL else cell[: TABLE_CELL - 1] + "…" for cell in row])
                if len(rows) > TABLE_ROWS:
                    break
    except csv.Error:
        return None
    if not rows:
        return None
    truncated = len(rows) > TABLE_ROWS
    rows = rows[:TABLE_ROWS]
    widths = [max(len(row[index]) for row in rows if index < len(row)) for index in range(max(map(len, rows)))]
    lines = ["  ".join(cell.ljust(widths[index]) for index, cell in enumerate(row)).rstrip() for row in rows]
    lines.insert(1, "  ".join("─" * width for width in widths))
    if truncated:
        lines += ["", f"… showing the first {TABLE_ROWS} rows; open in VS Code or Preview for the rest"]
    return lines


def pdf_pages(path: Path, which=shutil.which) -> int:
    pdfinfo = which("pdfinfo")
    if not pdfinfo:
        return 0
    info = subprocess.run([pdfinfo, str(path.absolute())], capture_output=True, text=True, check=False).stdout
    return next((int(value) for key, _, value in (row.partition(":") for row in info.splitlines())
                 if key == "Pages" and value.strip().isdigit()), 0)


def read_key() -> str:
    attributes = termios.tcgetattr(sys.stdin)
    try:
        tty.setcbreak(sys.stdin)
        return os.read(sys.stdin.fileno(), 1024).decode("utf-8", "replace")
    finally:
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, attributes)


@functools.cache
def chafa_pixels() -> list[str]:
    """chafa's argv for real pixels.

    Probing reads terminal replies that the key reader would take for key presses. chafa
    1.16 added --probe and older versions reject it, but they never probe either.
    chafa sends raw pixels, so upscaling and its animations flood tmux and SSH: it draws
    one frame at the image's own size, and play() animates with PNG frames.
    """

    try:
        usage = subprocess.run(["chafa", "--help"], capture_output=True, text=True, check=False).stdout
    except OSError:
        usage = ""
    probe = ["--probe=off"] if "--probe" in usage else []
    return ["chafa", "--format=kitty", "--passthrough=tmux", *probe, "--animate=off", "--exact-size=on",
            "--align=mid,mid"]


def page_pdf(view: Pdf) -> int:
    with tempfile.TemporaryDirectory(prefix="tmux-opener-pdf-") as folder:
        while True:
            columns, rows = shutil.get_terminal_size()
            image = Path(folder, f"{view.page}.png")
            if not image.exists():
                subprocess.run(["pdftoppm", "-png", "-singlefile", "-scale-to", "2000", "-f", str(view.page),
                                "-l", str(view.page), str(view.path), str(image.with_suffix(""))],
                               stderr=subprocess.DEVNULL, check=False)
            print("\x1b[H\x1b[2J", end="", flush=True)
            subprocess.run([*chafa_pixels(), f"--size={columns}x{rows - 1}", str(image)], check=False)
            status = f"{view.name}  page {view.page}/{view.pages}  space/b pages  g/G first/last  q close"
            print(f"\x1b[{rows};1H\x1b[2m{status[:columns]}\x1b[0m", end="", flush=True)
            page = view.page
            while page == view.page:
                key = read_key()
                if key in ("q", "\x1b"):
                    print("\x1b[H\x1b[2J\x1b[?25h", end="", flush=True)
                    return 0
                target = {"g": 1, "G": view.pages}.get(key, page + PAGE_STEPS.get(key, 0))
                view.page = min(max(target, 1), view.pages)


def kitty_png(png: bytes, keys: dict[bytes, bytes]) -> bytes:
    """A PNG on a virtual placement as tmux-wrapped kitty commands; the terminal replies once shown."""

    data = base64.standard_b64encode(png)
    chunks = [data[start:start + 4096] for start in range(0, len(data), 4096)]
    sequence = b""
    for index, chunk in enumerate(chunks):
        first = b"a=T,U=1,f=100,i=%s,c=%s,r=%s," % (keys[b"i"], keys[b"c"], keys[b"r"]) if not index else b""
        command = b"\x1b_G" + first + b"m=%d;" % (index < len(chunks) - 1) + chunk + b"\x1b\\"
        sequence += b"\x1bPtmux;" + command.replace(b"\x1b", b"\x1b\x1b") + b"\x1b\\"
    return sequence


def show(data: bytes) -> None:
    sys.stdout.buffer.write(data)
    sys.stdout.buffer.flush()


def png_files(stream: IO[bytes]) -> Iterator[bytes]:
    """Split concatenated PNG files at their IEND chunks."""

    while signature := stream.read(8):
        png = [signature]
        while True:
            header = stream.read(8)
            if len(header) < 8:
                return
            png += [header, stream.read(int.from_bytes(header[:4], "big") + 4)]  # data and CRC
            if header[4:] == b"IEND":
                break
        yield b"".join(png)


def play(drawing: subprocess.Popen[bytes], path: Path, stop: threading.Event, shown: threading.Event) -> None:
    """Pass chafa's frame through; GIFs instead get PNG frames under its image id.

    chafa sends raw pixels, seconds of data over SSH for a single frame. ffmpeg decodes one
    frame at a time, so long GIFs need little memory. Each frame waits for the terminal's
    reply to the last one, so a slow link lowers the frame rate instead of queueing frames in
    tmux and SSH that hold back the key closing the view.
    """

    ffmpeg, ffprobe = shutil.which("ffmpeg"), shutil.which("ffprobe")
    if path.suffix.lower() != ".gif" or not (ffmpeg and ffprobe):
        for chunk in iter(lambda: drawing.stdout.read1(65536), b""):  # type: ignore[union-attr]
            show(chunk)
        return
    drawn = drawing.stdout.read()  # type: ignore[union-attr]
    placement = re.search(rb"a=T,U=1,[^;]*", drawn)
    if drawing.wait() or not placement:
        show(drawn)
        return
    keys = dict(field.split(b"=", 1) for field in placement.group().split(b","))
    # Keep chafa's placeholder cells but send the pixels as PNGs.
    cells = re.sub(rb"\x1bPtmux;\x1b\x1b_G[^\x1b]*\x1b\x1b\\\x1b\\", b"", drawn)
    durations = subprocess.run([ffprobe, "-v", "error", "-select_streams", "v:0", "-show_entries",
                                "packet=duration_time", "-of", "csv=p=0", "--", str(path)],
                               capture_output=True, text=True, check=False).stdout.split()
    delays = [max(float(duration), 0.02) if duration[0].isdigit() else 0.1 for duration in durations]
    # A palette per frame keeps GIF colors exact and halves the PNGs sent over the link.
    palette = "split[a][b];[a]palettegen=stats_mode=single:reserve_transparent=1[p];[b][p]paletteuse=new=1:dither=none"
    decode = [ffmpeg, "-v", "error", "-i", str(path.absolute()), "-vsync", "passthrough", "-vf", palette,
              "-f", "image2pipe", "-c:v", "png", "-"]
    count = 0
    while count != 1:  # loop animations; a single frame stays up
        frames = subprocess.Popen(decode, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        try:
            for index, png in enumerate(png_files(frames.stdout)):  # type: ignore[arg-type]
                due = time.monotonic() + (delays[index] if index < len(delays) else 0.1)
                shown.clear()
                show(kitty_png(png, keys) + (cells if not count else b""))
                count = max(count, index + 1)
                give_up = time.monotonic() + 2  # for terminals that never reply
                while not shown.is_set() and time.monotonic() < give_up:
                    if stop.wait(0.01):
                        return
                if stop.wait(max(due - time.monotonic(), 0)):
                    return
        finally:
            frames.kill()
            frames.wait()
        if not count:
            show(drawn)
            return


def ask(screen: curses.window, label: str) -> str:
    """Read a lowercased answer on the bottom line."""

    height, width = screen.getmaxyx()
    screen.addnstr(height - 1, 0, label.ljust(width), width - 1, curses.A_REVERSE)
    curses.echo()
    try:
        curses.curs_set(1)
    except curses.error:
        pass
    answer = screen.getstr(height - 1, len(label), 200).decode("utf-8", "replace").strip().lower()
    curses.noecho()
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    return answer


def download(paths: list[Path], folder: Path, save_as: bool) -> str:
    """Queue downloads through the dispatcher and return its message for the status line."""

    dispatch = Path(__file__).resolve().with_name("tmux-opener-dispatch")
    # Without TMUX the dispatcher reports on stderr instead of the status line under this view.
    env = {key: value for key, value in os.environ.items() if key != "TMUX"}
    result = subprocess.run([str(dispatch), "--save-as" if save_as else "--download", "--cwd", str(folder)],
                            input="\n".join(map(str, paths)), capture_output=True, text=True, env=env, check=False)
    if result.returncode:
        lines = result.stderr.strip().splitlines() or [f"download failed ({result.returncode})"]
        return " " + lines[-1].removeprefix("tmux-opener: ")
    return f" queued {len(paths)} download(s); the desktop client shows progress"


def palette() -> dict[str, int]:
    """Curses attributes per browser role; bold, dim and reverse stand in without colors."""

    attrs = dict.fromkeys(COLORS, 0) | {"folder": curses.A_BOLD, "muted": curses.A_DIM, "accent": curses.A_BOLD,
                                        "error": curses.A_BOLD, "cursor": curses.A_REVERSE}
    if not curses.has_colors():
        return attrs
    try:
        curses.use_default_colors()
    except curses.error:
        return attrs
    rich = curses.COLORS >= 256
    for number, (role, (color, basic)) in enumerate(COLORS.items(), 1):
        curses.init_pair(number, color if rich else basic, -1)
        attrs[role] = curses.color_pair(number) | (curses.A_BOLD if role == "folder" else 0)
    curses.init_pair(len(COLORS) + 1, 255 if rich else curses.COLOR_WHITE, 24 if rich else curses.COLOR_BLUE)
    attrs["cursor"] = curses.color_pair(len(COLORS) + 1) | curses.A_BOLD
    return attrs


def modified(info: os.stat_result | None) -> str:
    if info is None:
        return ""
    when = time.localtime(info.st_mtime)
    return time.strftime("%b %d %H:%M" if when.tm_year == time.localtime().tm_year else "%b %d  %Y", when)


def peek(path: Path, info: os.stat_result | None, rows: int, attrs: dict[str, int]) -> list[tuple[str, int]]:
    """Lines previewing a folder's entries or a file's start for the browser's right pane."""

    if info is not None and stat.S_ISDIR(info.st_mode):
        try:
            with os.scandir(path) as scan:
                entries = sorted(scan, key=lambda entry: (not entry.is_dir(), entry.name.lower()))
        except OSError as exc:
            return [(f"cannot open: {exc.strerror or exc}", attrs["error"])]
        lines = [(f"{len(entries)} items", attrs["muted"])]
        for entry in entries[:rows]:
            role = "folder" if entry.is_dir() else KINDS.get(Path(entry.name).suffix.lower(), "")
            lines.append((entry.name + ("/" if entry.is_dir() else ""), attrs.get(role, 0)))
        return lines
    lines = [(f"{human_size(info.st_size)} · {modified(info)}" if info else "unreadable", attrs["muted"]), ("", 0)]
    try:
        if path.suffix.lower() in IMAGE_SUFFIXES | {".pdf"} or is_binary(path):
            kind = subprocess.run(["file", "-b", "--", str(path)], capture_output=True, text=True,
                                  check=False).stdout.strip() if shutil.which("file") else ""
            return lines + [(part.strip(), 0) for part in (kind or "binary data").split(",")[:rows - 4]] + \
                [("", 0), ("⏎ to view", attrs["muted"])]
        with path.open("rb") as handle:
            text = handle.read(16384).decode("utf-8", "replace")
    except OSError as exc:
        return lines + [(f"cannot read: {exc.strerror or exc}", attrs["error"])]
    return lines + [(line.expandtabs(4), 0) for line in text.splitlines()[:rows]]


def browse_folder(screen: curses.window, view: Folder) -> int:
    """Browse folders: Enter opens folders and previews files, space marks, d/D download."""

    try:
        curses.curs_set(0)
    except curses.error:
        pass
    attrs = palette()
    folder, cursor, top, query, note, hidden = view.path, 0, 0, "", ("", 0), False
    marked: dict[Path, int | None] = {}  # file sizes for the header; None for folders
    entries: list[tuple[Path, os.stat_result | None]] = []
    peeks: dict[Path, list[tuple[str, int]]] = {}

    def is_dir(info: os.stat_result | None) -> bool:
        return info is not None and stat.S_ISDIR(info.st_mode)

    def enter(target: Path, select: Path | None = None) -> tuple[str, int]:
        nonlocal folder, entries, cursor, top
        rows = []
        try:
            with os.scandir(target) as scan:
                for entry in scan:
                    if entry.name.startswith(".") and not hidden:
                        continue
                    try:
                        rows.append((Path(entry.path), entry.stat()))
                    except OSError:  # broken links
                        rows.append((Path(entry.path), None))
        except OSError as exc:
            return f" cannot open {target.name}: {exc.strerror or exc}", attrs["error"]
        rows.sort(key=lambda row: (not is_dir(row[1]), row[0].name.lower()))
        # The first row goes up, so leaving a folder is one Enter away.
        parent = [] if target.parent == target else [(target.parent, os.stat(target.parent))]
        folder, entries, top = target, parent + rows, 0
        peeks.clear()
        cursor = next((index for index, (path, _info) in enumerate(entries) if path == select), 1 if parent and rows else 0)
        return "", 0

    def find(start: int, step: int) -> int | None:
        rows = range(start, len(entries)) if step > 0 else range(start, -1, -1)
        return next((row for row in rows if query in entries[row][0].name.lower()), None)

    def put(y: int, x: int, text: str, attr: int, limit: int) -> int:
        try:
            screen.addnstr(y, x, text, max(limit, 0), attr)
        except curses.error:
            pass
        return x + min(len(text), max(limit, 0))

    note = enter(folder)
    while True:
        height, width = screen.getmaxyx()
        rows = max(1, height - 3)
        cursor = max(0, min(cursor, len(entries) - 1))
        top = max(min(top, cursor), cursor - rows + 1, 0)
        split = width >= 100
        list_width = width // 2 if split else width
        screen.erase()

        # Header: the folder, then what is marked.
        title = str(folder).replace(str(Path.home()), "~", 1) if str(folder).startswith(str(Path.home())) else str(folder)
        count = sum(1 for path, _info in entries if path != folder.parent)
        if marked:
            sizes = [size for size in marked.values() if size is not None]
            summary = f"● {len(marked)} marked" + (f" · {human_size(sum(sizes))}" if sizes else "")
            summary_attr = attrs["accent"] | curses.A_BOLD
        else:
            summary, summary_attr = f"{count} items", attrs["muted"]
        room = max(width - len(summary) - 4, 8)
        put(0, 1, title if len(title) <= room else "…" + title[-room + 1:], attrs["folder"], room)
        put(0, width - len(summary) - 2, summary, summary_attr, len(summary) + 1)
        put(1, 0, "─" * width, attrs["muted"], width)

        # Entries: mark, name, size and date; the cursor row is a bar across the list.
        date_width = 12 if list_width >= 56 else 0
        name_width = max(8, list_width - 15 - date_width)
        for y, (path, info) in enumerate(entries[top:top + rows], 2):
            index = top + y - 2
            up = path == folder.parent and index == 0 and folder.parent != folder
            role = "folder" if is_dir(info) else KINDS.get(path.suffix.lower(), "")
            name = "../" if up else path.name + ("/" if is_dir(info) else "")
            if len(name) > name_width:
                name = name[:name_width - 1] + "…"
            size = "" if is_dir(info) or info is None else human_size(info.st_size)
            cursor_row = index == cursor
            base = attrs["cursor"] if cursor_row else 0
            if cursor_row:
                put(y, 0, " " * list_width, base, list_width)
            x = put(y, 1, "●" if path in marked else " ", base or attrs["accent"], 1)
            name_attr = base or (attrs["muted"] if path.name.startswith(".") or up else attrs.get(role, 0))
            put(y, x + 1, name, name_attr, name_width)
            put(y, 3 + name_width, f"{size:>9}", base or attrs["muted"], 9)
            if date_width:
                put(y, 3 + name_width + 11, modified(info) if not up else "", base or attrs["muted"], date_width)
        if not entries or (len(entries) == 1 and entries[0][0] == folder.parent):
            put(3 if entries else 2, 3, "empty folder", attrs["muted"], list_width - 4)

        # Preview of the entry under the cursor.
        if split and entries:
            for y in range(2, height - 1):
                put(y, list_width, "│", attrs["muted"], 1)
            path, info = entries[cursor]
            if path not in peeks:
                peeks[path] = peek(path, info, rows, attrs)
            for y, (line, attr) in enumerate(peeks[path][:rows], 2):
                put(y, list_width + 2, line, attr, width - list_width - 3)

        # Footer: a message, or the keys with the position on the right.
        position = f"{cursor + 1}/{len(entries)}" if entries else ""
        if note[0]:
            put(height - 1, 0, note[0], note[1] | curses.A_BOLD, width - 1)
        else:
            x = 1
            for key, label in BROWSER_KEYS:
                if x + len(key) + len(label) + 3 > width - len(position) - 2:
                    break
                x = put(height - 1, x, key, attrs["accent"] | curses.A_BOLD, len(key))
                x = put(height - 1, x + 1, label, attrs["muted"], len(label)) + 2
            put(height - 1, width - len(position) - 1, position, attrs["muted"], len(position))
        note = ("", 0)

        key = screen.getch()
        if key == 27:
            # Graphics replies from a closed image preview start with ESC _ and must not quit.
            screen.nodelay(True)
            follow, previous, deadline = screen.getch(), -1, time.monotonic() + 0.5
            while follow == ord("_") and time.monotonic() < deadline:
                char = screen.getch()
                if previous == 27 and char == ord("\\"):
                    break
                previous = char if char != -1 else previous
                if char == -1:
                    time.sleep(0.005)
            screen.nodelay(False)
            if follow == -1:
                return 0
            continue
        current, info = entries[cursor] if entries else (None, None)
        up = current == folder.parent and cursor == 0 and folder.parent != folder
        moves = {ord("j"): 1, curses.KEY_DOWN: 1, ord("k"): -1, curses.KEY_UP: -1, curses.KEY_NPAGE: rows,
                 curses.KEY_PPAGE: -rows, 4: rows // 2, 21: -(rows // 2)}  # Ctrl-D and Ctrl-U
        if key in (ord("q"), ord("Q")):
            return 0
        if key in moves:
            cursor += moves[key]
        elif key in (ord("g"), curses.KEY_HOME):
            cursor = 0
        elif key in (ord("G"), curses.KEY_END):
            cursor = len(entries)
        elif key in (ord("h"), ord("-"), curses.KEY_LEFT, curses.KEY_BACKSPACE, 127, 8):
            note = enter(folder.parent, folder)
        elif key in (ord("l"), 10, 13, curses.KEY_ENTER, curses.KEY_RIGHT) and current:
            if up or is_dir(info):
                note = enter(current, folder if up else None)
                continue
            curses.endwin()
            try:
                run(*plan(current, size=tuple(shutil.get_terminal_size()), pixels=view.pixels))
            except OSError as exc:
                note = f" cannot show {current.name}: {exc.strerror or exc}", attrs["error"]
            # Table previews run their own curses.wrapper, which resets modes and colors on exit.
            curses.cbreak()
            curses.noecho()
            screen.keypad(True)
            attrs = palette()
            curses.flushinp()
            screen.clear()
        elif key == ord(" ") and current and not up:
            if marked.pop(current, False) is False:
                marked[current] = None if is_dir(info) or info is None else info.st_size
            cursor += 1
        elif key == ord("a"):
            choices = {path: None if is_dir(row) or row is None else row.st_size
                       for index, (path, row) in enumerate(entries) if not (index == 0 and path == folder.parent)}
            if choices and choices.keys() <= marked.keys():
                for path in choices:
                    marked.pop(path)
            else:
                marked |= choices
        elif key == ord("."):
            hidden = not hidden
            note = enter(folder, current)
        elif key in (ord("d"), ord("D")) and current and (marked or not up):
            put(height - 1, 0, " queueing…".ljust(width), attrs["muted"], width - 1)
            screen.refresh()
            message = download(sorted(marked) or [current], folder, key == ord("D"))
            queued = message.startswith(" queued")
            note = message, attrs["ok" if queued else "error"]
            if queued:
                marked.clear()
        elif key == ord("/"):
            query = ask(screen, "/")
            if query:
                match = find(cursor, 1)
                cursor, note = (match, ("", 0)) if match is not None else (cursor, (f" not found: {query}", attrs["error"]))
        elif key in (ord("n"), ord("N")) and query:
            match = find(cursor + 1, 1) if key == ord("n") else find(cursor - 1, -1)
            cursor, note = (match, ("", 0)) if match is not None else (cursor, (" no more matches", attrs["muted"]))


def page_table(screen: curses.window, view: Table) -> int:
    """A small pager for tables: less-style keys, header pinned, / searches rows."""

    try:
        curses.curs_set(0)
    except curses.error:
        pass
    header, body = view.lines[:2], view.lines[2:]
    top, left, query, note = view.start, 0, "", ""

    def find(start: int, step: int) -> int | None:
        rows = range(start, len(body)) if step > 0 else range(start, -1, -1)
        return next((row for row in rows if query in body[row].lower()), None)

    while True:
        height, width = screen.getmaxyx()
        page = max(1, height - 3)
        top = max(0, min(top, len(body) - page))
        screen.erase()
        visible = [(header[0], curses.A_BOLD), (header[1], curses.A_DIM)]
        visible += [(line, curses.A_STANDOUT if query and query in line.lower() else 0) for line in body[top:top + page]]
        status = note or f" {view.name}  rows {top + 1}-{min(top + page, len(body))}/{len(body)}  ←→ scroll  / search  q quits"
        visible += [("", 0)] * (height - 1 - len(visible)) + [(status.ljust(width), curses.A_REVERSE)]
        for y, (line, attr) in enumerate(visible[:height]):
            try:
                screen.addnstr(y, 0, line if y == height - 1 else line[left:], width - 1, attr)
            except curses.error:
                pass
        note = ""
        key = screen.getch()
        if key in (ord("q"), ord("Q"), 27):
            return 0
        moves = {ord("j"): 1, curses.KEY_DOWN: 1, 10: 1, ord("k"): -1, curses.KEY_UP: -1,
                 ord(" "): page, ord("f"): page, curses.KEY_NPAGE: page, ord("b"): -page, curses.KEY_PPAGE: -page,
                 ord("d"): page // 2, ord("u"): -(page // 2)}
        if key in moves:
            top += moves[key]
        elif key in (ord("g"), curses.KEY_HOME):
            top = 0
        elif key in (ord("G"), curses.KEY_END):
            top = len(body)
        elif key in (ord("l"), curses.KEY_RIGHT):
            left += 8
        elif key in (ord("h"), curses.KEY_LEFT):
            left = max(0, left - 8)
        elif key == ord("0"):
            left = 0
        elif key == ord("/"):
            query = ask(screen, "/")
            if query:
                match = find(top, 1)
                top, note = (match, "") if match is not None else (top, f" pattern not found: {query}")
        elif key in (ord("n"), ord("N")) and query:
            match = find(top + 1, 1) if key == ord("n") else find(top - 1, -1)
            top, note = (match, "") if match is not None else (top, " no more matches")


def plan(path: Path, line: int | None = None, which=shutil.which, size: tuple[int, int] = (80, 24),
         pixels: bool = False) -> tuple[list[str] | str | Table | Pdf | Folder | None, list[str] | None]:
    """Return (producer, pager): an argv or text piped into less, None when less reads the file,
    a Table, Pdf or Folder with no pager for the built-in views, or an argv drawing to the terminal with no pager."""

    name = path.name or str(path)
    if path.is_dir():
        return Folder(path.absolute(), pixels), None
    suffix = path.suffix.lower()
    if suffix in IMAGE_SUFFIXES:
        columns, rows = size
        if pixels and which("chafa"):
            return [*chafa_pixels(), f"--size={columns}x{rows - 1}", str(path)], None
        if which("chafa"):
            # less needs a finished stream, so animations show their first frame.
            return ["chafa", "--format=symbols", "--animate=off", f"--size={columns}x{rows - 2}", str(path)], pager(name)
        if which("timg"):
            return ["timg", "-pq", "--frames=1", f"-g{columns}x{rows - 2}", str(path)], pager(name)
        return describe(path, "Install chafa or timg on this host to see images inline,\n"
                              "or use the Preview opener to open them on your desktop.", which), pager(name)
    if suffix == ".pdf":
        pages = pdf_pages(path, which) if pixels and which("chafa") and which("pdftoppm") else 0
        if pages:
            # path:N selections open at page N.
            return Pdf(name, path.absolute(), pages, min(max(line or 1, 1), pages)), None
        if which("pdftotext"):
            return ["pdftotext", "-layout", str(path.absolute()), "-"], pager(name)
    if is_binary(path):
        return describe(path, "Binary file: use the Preview or Download opener to open it on your desktop.", which), pager(name)
    small = path.stat().st_size <= HIGHLIGHT_LIMIT
    lines = table(path) if suffix in {".csv", ".tsv"} and small else None
    if lines is not None:
        # File line N holds row N - 1; the header stays pinned above it.
        return Table(name, lines, max(0, (line or 2) - 2)), None
    if suffix == ".json" and small:
        if which("jq"):
            return ["jq", "-C", ".", str(path)], pager(name)
        return [sys.executable, "-m", "json.tool", str(path)], pager(name)
    if suffix in {".md", ".markdown"} and small:
        if glow := which("glow"):
            return [glow, "--style=dark", f"--width={min(size[0] - 2, 120)}", "--", str(path)], pager(name)
        return render_markdown(path.read_text(encoding="utf-8", errors="replace"), size[0]), pager(name, line)
    bat = which("bat") or which("batcat")
    if bat and small:
        highlight = ["--highlight-line", str(line)] if line else []
        return [bat, "--color=always", "--paging=never", "--style=numbers", *highlight, "--", str(path)], pager(name, line)
    return None, pager(name, line, numbers=bool(line)) + ["--", str(path)]


def run(producer: list[str] | str | Table | Pdf | Folder | None, pager_command: list[str] | None) -> int:
    if isinstance(producer, (Table, Folder)):
        os.environ.setdefault("ESCDELAY", "25")
        return curses.wrapper(page_table if isinstance(producer, Table) else browse_folder, producer)
    if isinstance(producer, Pdf):
        return page_pdf(producer)
    if producer is None:
        return subprocess.run(pager_command, check=False).returncode
    if pager_command is None:  # pixel images: less would mangle the graphics escapes
        # The hint goes first so a key can stop an animation or a large image still drawing.
        print(f"\x1b[{shutil.get_terminal_size().lines};1H\x1b[2mPress any key to close\x1b[0m\x1b[H", end="", flush=True)
        drawing = subprocess.Popen(producer, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE)
        stop, shown = threading.Event(), threading.Event()
        player = threading.Thread(target=play, args=(drawing, Path(producer[-1]), stop, shown), daemon=True)
        player.start()
        # Kitty replies to animation frames arrive as input; anything else is a key.
        while not KITTY_REPLY_RE.sub("", read_key()):
            shown.set()
        stop.set()
        cut = drawing.poll() is None
        if cut:
            drawing.terminate()
        player.join(timeout=1)
        if cut or player.is_alive():
            print("\x1b\\", end="", flush=True)  # end a graphics escape cut off mid-frame
        return 0 if cut else drawing.returncode
    if isinstance(producer, str):
        viewer = subprocess.Popen(pager_command, stdin=subprocess.PIPE)
        try:
            viewer.communicate(producer.encode("utf-8", "replace"))
        except BrokenPipeError:
            pass
        return viewer.wait()
    source = subprocess.Popen(producer, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    try:
        viewer = subprocess.Popen(pager_command, stdin=source.stdout)
        return viewer.wait()
    finally:
        source.stdout.close()  # type: ignore[union-attr]
        source.kill()
        source.wait()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("path")
    parser.add_argument("--line", type=int)
    parser.add_argument("--pixels", action="store_true", help="draw images and PDFs with kitty graphics")
    args = parser.parse_args()
    path = Path(args.path)
    try:
        return run(*plan(path, args.line, size=tuple(shutil.get_terminal_size()), pixels=args.pixels))
    except OSError as exc:
        print(f"tmux-opener: cannot show {path}: {exc.strerror or exc}", file=sys.stderr)
        input("Press Enter to close. ")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
